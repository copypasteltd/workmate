# Canonical schema fixtures are included in source-bound verification receipts.
contracts/*-schemas.json -text

# Preserve the upstream OFL byte-for-byte, including original trailing spaces.
assets/fonts/copypaste-sans-tc/OFL.txt -text -whitespace

# Retain the original Windows compiler log from the failed stage93 setup.
evidence/agent-groups-core-04.tap -text whitespace=cr-at-eol

# Native GEO schema bytes are frozen; treat their CRLF as line endings.
contracts/desktop-geo-schemas.json -text whitespace=cr-at-eol

# Native host receipts bind the compiler's exact source bytes.
src/cloud-browser-host.cs -text whitespace=cr-at-eol

# Retain exact role release and executed publication verifier bytes.
catalog/publication-release-v1.json -text whitespace=cr-at-eol
scripts/qualify-publications-v2.mjs -text whitespace=cr-at-eol

