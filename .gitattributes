* text=auto eol=lf
*.png binary
*.jpg binary
*.woff2 binary
*.ttf binary

# SQL checksums and trusted method hashes are exact-byte integrity boundaries.
migrations/** -text whitespace=cr-at-eol
skills/** -text

# Canonical schema fixtures are included in source-bound verification receipts.
contracts/*-schemas.json -text

# Preserve the upstream OFL byte-for-byte, including original trailing spaces.
assets/fonts/copypaste-sans-tc/OFL.txt -text -whitespace
