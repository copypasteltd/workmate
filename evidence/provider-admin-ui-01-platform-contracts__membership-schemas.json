{
  "source": "docs/contracts/openapi.json",
  "source_sha256": "51dd90f26137798dd23c4e881b7f9f0b20f99ad4b9fee0cce98686e11873aab4",
  "schemas": {
    "Role": {
      "type": "string",
      "enum": ["owner", "admin", "member", "approver", "viewer"]
    },
    "InviteCreate": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email"
        },
        "role": {
          "$ref": "#/components/schemas/Role"
        },
        "project_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "minItems": 0
        }
      },
      "required": ["email", "role", "project_ids"],
      "additionalProperties": false
    },
    "Invite": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "role": {
          "$ref": "#/components/schemas/Role"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "state": {
          "type": "string",
          "enum": ["pending", "accepted", "expired", "revoked"]
        }
      },
      "required": ["id", "email", "role", "expires_at", "state"],
      "additionalProperties": false
    },
    "InviteAccept": {
      "type": "object",
      "properties": {
        "token": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["token"],
      "additionalProperties": false
    },
    "Member": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "user_id": {
          "type": "string",
          "format": "uuid"
        },
        "role": {
          "$ref": "#/components/schemas/Role"
        },
        "project_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "minItems": 0
        },
        "state": {
          "type": "string",
          "enum": ["active", "removed"]
        },
        "auth_version": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "user_id",
        "role",
        "project_ids",
        "state",
        "auth_version"
      ],
      "additionalProperties": false
    },
    "MemberList": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/Member"
          },
          "minItems": 0
        },
        "next_cursor": {
          "type": ["string", "null"]
        }
      },
      "required": ["items", "next_cursor"],
      "additionalProperties": false
    },
    "Ack": {
      "type": "object",
      "properties": {
        "ok": {
          "const": true
        }
      },
      "required": ["ok"],
      "additionalProperties": false
    }
  }
}
