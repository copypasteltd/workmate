.admin-event-work {
  min-width: 0;
  padding-block: 24px;
  border-block: 1px solid var(--line);
}
.admin-event-work h2 {
  display: flex;
  align-items: center;
  gap: 10px;
}
.admin-event-work > .field {
  max-width: 300px;
}
.admin-event-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 360px), 1fr));
  gap: 18px;
}
.admin-event-card {
  min-width: 0;
  padding: 22px;
  border-top: 3px solid var(--brand, #1f5eff);
}
.admin-event-card header {
  display: flex;
  justify-content: space-between;
  gap: 14px;
  flex-wrap: wrap;
}
.admin-event-card dl > div {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr);
  gap: 14px;
  padding-block: 10px;
  border-bottom: 1px solid var(--line);
}
.admin-event-card dt {
  font-size: 12px;
  color: var(--muted);
}
.admin-event-card dd {
  font-size: 12px;
  overflow-wrap: anywhere;
  margin: 0;
  text-align: right;
}
.admin-event-work .pagination > div {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}
@media (max-width: 600px) {
  .admin-event-card dl > div {
    grid-template-columns: minmax(0, 1fr);
    gap: 6px;
  }
  .admin-event-card dd {
    text-align: left;
  }
}
