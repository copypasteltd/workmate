{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "sourceMap": true
  },
  "include": [
    "src/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "tests/scope-erasure-150-v5.test.ts",
    "tests/scope-erasure-150-v4.test.ts",
    "tests/scope-erasure-150-v3.test.ts",
    "tests/scope-erasure-150-v2.test.ts",
    "tests/scope-erasure-150-v1.test.ts",
    "tests/native-agent-groups-139-v1.test.ts",
    "tests/creative-packages-140-v1.test.ts",
    "tests/business-history-144-v1.test.ts",
    "tests/business-history-fixture-144-v1.ts",
    "tests/document-fixtures-146-v1.ts",
    "tests/document-preview-146-v1.test.ts",
    "tests/task-local-handoff-fixture-147-v1.ts",
    "tests/task-local-handoff-147-v1.test.ts",
    "tests/task-local-handoff-147-v2.test.ts",
    "tests/workflow-contracts-147-v1.test.ts"
  ]
}
