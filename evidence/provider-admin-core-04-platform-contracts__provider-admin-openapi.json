  "components": {
    "securitySchemes": {
      "AdminSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "cp_admin_session"
      }
    },
    "schemas": {
      "ProviderLimits": {
        "type": "object",
        "properties": {
          "global_slots": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "tenant_slots": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "actor_slots": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "text_slots": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "image_slots": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "verification_slots": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "global_rpm": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          },
          "tenant_rpm": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          },
          "actor_rpm": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          },
          "text_rpm": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          },
          "image_rpm": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          },
          "verification_rpm": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          },
          "preparation_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 300
          }
        },
        "required": [
          "global_slots",
          "tenant_slots",
          "actor_slots",
          "text_slots",
          "image_slots",
          "verification_slots",
          "global_rpm",
          "tenant_rpm",
          "actor_rpm",
          "text_rpm",
          "image_rpm",
          "verification_rpm",
          "preparation_seconds"
        ],
        "additionalProperties": false
      },
      "ProviderBudgetDefinition": {
        "type": "object",
        "properties": {
          "count_verified": {
            "type": "boolean"
          },
          "count_price_micros": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "verification_run_micros": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "verification_daily_micros": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "counting_daily_micros": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "count_verified",
          "count_price_micros",
          "verification_run_micros",
          "verification_daily_micros",
          "counting_daily_micros"
        ],
        "additionalProperties": false
      },
      "ProviderPolicyDefinition": {
        "type": "object",
        "properties": {
          "limits": {
            "type": "object",
            "properties": {
              "global_slots": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              },
              "tenant_slots": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              },
              "actor_slots": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              },
              "text_slots": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              },
              "image_slots": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              },
              "verification_slots": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              },
              "global_rpm": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000
              },
              "tenant_rpm": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000
              },
              "actor_rpm": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000
              },
              "text_rpm": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000
              },
              "image_rpm": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000
              },
              "verification_rpm": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000
              },
              "preparation_seconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 300
              }
            },
            "required": [
              "global_slots",
              "tenant_slots",
              "actor_slots",
              "text_slots",
              "image_slots",
              "verification_slots",
              "global_rpm",
              "tenant_rpm",
              "actor_rpm",
              "text_rpm",
              "image_rpm",
              "verification_rpm",
              "preparation_seconds"
            ],
            "additionalProperties": false
          },
          "budget": {
            "type": "object",
            "properties": {
              "count_verified": {
                "type": "boolean"
              },
              "count_price_micros": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "verification_run_micros": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "verification_daily_micros": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "counting_daily_micros": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "count_verified",
              "count_price_micros",
              "verification_run_micros",
              "verification_daily_micros",
              "counting_daily_micros"
            ],
            "additionalProperties": false
          },
          "count_contract": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "reference": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 300
                  },
                  "terms": {
                    "type": "string",
                    "minLength": 10,
                    "maxLength": 16000
                  },
                  "service": {
                    "type": "string",
                    "enum": [
                      "responses.input_tokens"
                    ]
                  },
                  "fee_micros": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "effective_at": {
                    "type": "string",
                    "format": "date-time"
                  }
                },
                "required": [
                  "reference",
                  "terms",
                  "service",
                  "fee_micros",
                  "effective_at"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "limits",
          "budget",
          "count_contract"
        ],
        "additionalProperties": false,
        "description": "Verified counting additionally requires matching explicit fee/contract and an effective contract bound to the current company gateway. Publication never qualifies a live model."
      },
      "ProviderPolicyDraft": {
        "type": "object",
        "properties": {
          "definition": {
            "$ref": "#/components/schemas/ProviderPolicyDefinition"
          },
          "reason": {
