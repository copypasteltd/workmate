    "/v1/admin/ai/requests": {
      "get": {
        "operationId": "provider_get_requests",
        "summary": "Scoped request directory with separate extra cost-field permission",
        "security": [
          {
            "AdminSession": []
          }
        ],
        "x-permission": "admin.ai.requests.read",
        "parameters": [
          {
            "in": "query",
            "name": "cursor",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "in": "query",
            "name": "data_mode",
            "schema": {
              "type": "string",
              "enum": [
                "simulated",
                "configured_services"
              ]
            }
          },
          {
            "in": "query",
            "name": "subject_kind",
            "schema": {
              "type": "string",
              "enum": [
                "task",
                "validation"
              ]
            }
          },
          {
            "in": "query",
            "name": "operation",
            "schema": {
              "type": "string",
              "enum": [
                "responses",
                "images.generate",
                "images.edit",
                "responses.input_tokens"
              ]
            }
          },
          {
            "in": "query",
            "name": "state",
            "schema": {
              "type": "string",
              "enum": [
                "prepared",
                "dispatched",
                "completed",
                "unknown",
                "cancelled",
                "denied"
              ]
            }
          },
          {
            "in": "query",
            "name": "cost_state",
            "schema": {
              "type": "string",
              "enum": [
                "known",
                "unknown",
                "manually_confirmed"
              ]
            }
          },
          {
            "in": "query",
            "name": "capacity_state",
            "schema": {
              "type": "string",
              "enum": [
                "held",
                "released"
              ]
            }
          },
          {
            "in": "query",
            "name": "tenant_id",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "in": "query",
            "name": "project_id",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "in": "query",
            "name": "actor_id",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "in": "query",
            "name": "task_id",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "in": "query",
            "name": "validation_id",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "in": "query",
            "name": "capability_version_id",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "in": "query",
            "name": "release_id",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "in": "query",
            "name": "period_from",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "in": "query",
            "name": "period_to",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current scoped facts"
          },
          "400": {
            "description": "Strict schema, binding or cursor invalid"
          },
          "401": {
            "description": "Independent Admin session required"
          },
          "403": {
            "description": "Current scoped permission, explicit deny, recent MFA or independent review failed"
          },
          "409": {
            "description": "Current target, policy, proof, price, budget, preview or task changed"
          }
        }
      }
    },
