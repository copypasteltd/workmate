  "paths": {
    "/v1/admin/ai/policy": {
      "get": {
        "operationId": "provider_get_policy",
        "summary": "Current independently published limits and budgets; UTC-day boundaries remain frozen",
        "security": [
          {
            "AdminSession": []
          }
        ],
        "x-permission": "admin.ai.policy.read",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Current scoped facts"
          },
          "400": {
            "description": "Strict schema, binding or cursor invalid"
          },
          "401": {
            "description": "Independent Admin session required"
          },
          "403": {
            "description": "Current scoped permission, explicit deny, recent MFA or independent review failed"
          },
          "409": {
            "description": "Current target, policy, proof, price, budget, preview or task changed"
          }
        }
      }
    },
    "/v1/admin/ai/policies": {
