    "Policy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "budget_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,19}$"
          },
          "maxItems": 50,
          "minItems": 1,
          "uniqueItems": true
        },
        "maximum_average_daily_micros": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,17})$",
          "description": "Exact account-currency micros; never JSON floating point. Desired value must be positive."
        },
        "maximum_change_micros": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,17})$",
          "description": "Exact account-currency micros; never JSON floating point. Desired value must be positive."
        },
        "confirmation": {
          "enum": [
            "each_operation",
            "within_policy"
          ]
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "enabled",
        "currency",
        "budget_ids",
        "maximum_average_daily_micros",
        "maximum_change_micros",
        "confirmation",
        "expires_at"
      ],
      "additionalProperties": false
    },
