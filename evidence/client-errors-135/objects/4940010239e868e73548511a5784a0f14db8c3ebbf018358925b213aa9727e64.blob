.cloud-admin{min-width:0;display:grid;gap:22px}.cloud-admin-tabs{display:flex;gap:6px;flex-wrap:wrap;border-bottom:1px solid var(--line);padding-bottom:12px}.cloud-admin-tabs button{padding:10px 18px;border-radius:9px;background:transparent;color:var(--muted)}.cloud-admin-tabs button.selected{color:var(--blue);background:var(--blue-soft)}.cloud-admin-summary{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.cloud-admin-summary section{border:1px solid var(--line);background:var(--surface);border-radius:14px;padding:20px;display:grid;gap:10px}.cloud-admin-summary span{color:var(--muted);font-size:12px}.cloud-admin-summary strong{font-size:17px;font-weight:650}.cloud-admin-records{min-width:0;padding:22px}.cloud-admin-records>header{display:flex;gap:12px;justify-content:space-between;align-items:center;flex-wrap:wrap}.cloud-admin-records h2{font-size:18px}.cloud-admin-list{display:grid}.cloud-admin-row{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr) auto;gap:22px;border-top:1px solid var(--line);padding:20px 0;align-items:center}.cloud-admin-row>div{display:grid;gap:8px;min-width:0;overflow-wrap:anywhere}.cloud-admin-row small{font-size:12px;color:var(--muted)}.cloud-admin-row b{font-size:14px}.cloud-admin-row .row-actions{display:flex;flex-wrap:wrap;justify-content:flex-end}.cloud-admin-state{color:var(--blue);font-size:12px}.cloud-admin-empty{color:var(--muted);max-width:650px;line-height:1.8;padding:30px 0}.cloud-admin-records>footer{display:flex;justify-content:flex-end;gap:10px}.cloud-enrollment-secret{width:100%;overflow-wrap:anywhere;resize:none;margin-bottom:16px}.cloud-plan-fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.cloud-plan-fields .check-line{display:flex;align-items:center;gap:8px}.cloud-plan-fields input[type=checkbox]{width:auto}@media(max-width:1000px){.cloud-admin-row{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}.cloud-admin-row .row-actions{grid-column:1/-1;justify-content:flex-start}}@media(max-width:640px){.cloud-admin-summary,.cloud-plan-fields{grid-template-columns:minmax(0,1fr)}.cloud-admin-row{grid-template-columns:minmax(0,1fr)}.cloud-admin-records{padding:16px}.cloud-admin-summary section{padding:16px}.cloud-admin-row .row-actions{grid-column:auto}}
