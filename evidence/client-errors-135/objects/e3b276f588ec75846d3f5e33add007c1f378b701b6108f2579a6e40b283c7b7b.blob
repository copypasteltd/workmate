@font-face {
  font-family: Manrope;
  src: url("fonts/manrope.woff2") format("woff2");
  font-weight: 200 800;
  font-display: swap;
}
@font-face {
  font-family: Fraunces;
  src: url("fonts/fraunces.woff2") format("woff2");
  font-weight: 100 900;
  font-display: swap;
}
:root {
  --chat-paper: #fff;
  --chat-ink: #15171a;
  --chat-muted: #646a75;
  --chat-line: #e3e4e5;
  --chat-wash: #edf2ff;
  font-family: Manrope, "Microsoft JhengHei", system-ui, sans-serif;
  color: #15171a;
  background: #f6f6f4;
  color-scheme: light;
  font-size: 14px;
}
.publication-workspace { margin-block: 14px; min-width: 0; border-block: 1px solid var(--chat-line); overflow-wrap: anywhere; }
.publication-workspace>summary { padding-block: 14px; font-weight: 700; cursor: pointer; }
.publication-workspace>div { padding-bottom: 16px; min-width: 0; }
.publication-workspace .publication-note,.publication-workspace [role=status],.publication-workspace [role=alert] { font-size: 12px; line-height: 1.7; }
.publication-workspace [role=alert] { color: #b33432; }
.publication-workspace button { max-width: 100%; white-space: normal; margin-block: 5px; }
.publication-workspace article { border: 1px solid var(--chat-line); border-left: 3px solid #1f5eff; border-radius: 12px; padding: 14px; margin-block: 12px; min-width: 0; background: var(--chat-paper); }
.publication-workspace article strong,.publication-workspace article span,.publication-workspace small { display: block; margin-block: 6px; }
.publication-workspace article span { color: #1f5eff; font-size: 12px; font-weight: 650; }
.publication-workspace small { color: var(--chat-muted); font-size: 10px; line-height: 1.65; overflow-wrap: anywhere; }
.publication-navigation { display: flex; justify-content: space-between; gap: 12px; }
.publication-detail:not(:empty) { border-top: 1px solid var(--chat-line); margin-top: 16px; padding-top: 10px; min-width: 0; }
.publication-detail h3 { font-size: 17px; }
.publication-detail p { font-size: 12px; line-height: 1.8; }
.publication-caption { white-space: pre-wrap; }
.publication-workspace :focus-visible { outline: 2px solid #1f5eff; outline-offset: 3px; }
.delivery-quality { margin:16px 0; border-top:1px solid var(--chat-line); padding:12px 0; overflow-wrap:anywhere; }
.delivery-quality summary { cursor:pointer; font-weight:650; padding:8px 0; }
.delivery-quality label { display:grid; gap:7px; margin:14px 0; }
.delivery-quality input,.delivery-quality select,.delivery-quality textarea { width:100%; min-width:0; box-sizing:border-box; }
.delivery-quality textarea { min-height:85px; resize:vertical; }
.delivery-quality small,.delivery-quality p>span { display:block; margin-top:7px; white-space:pre-wrap; }
#generated-videos { min-width: 0; margin: 16px 0; overflow-wrap: anywhere; }
#cloud-schedules { min-width:0; overflow-wrap:anywhere; }
#cloud-events { min-width:0; overflow-wrap:anywhere; }
.cloud-event-panel article,.cloud-event-panel [data-event-issued]{margin-block:14px;padding:16px;border:1px solid var(--chat-line);border-top:3px solid #1f5eff;border-radius:14px;min-width:0}
.cloud-event-panel h3{font-size:17px;margin:12px 0}.cloud-event-panel p,.cloud-event-panel li{font-size:12px;line-height:1.7;overflow-wrap:anywhere}.cloud-event-panel small{display:block;font-size:10px;overflow-wrap:anywhere}.cloud-event-panel button{max-width:100%;white-space:normal;margin-block:5px}.cloud-event-panel label{display:flex;align-items:flex-start;gap:8px;font-size:12px;line-height:1.7;margin-block:14px}.cloud-event-panel input[type=checkbox]{width:16px;flex-shrink:0}.cloud-event-panel details{padding-block:10px;min-width:0}.cloud-event-panel summary{cursor:pointer;font-size:12px}.cloud-event-facts>strong{color:var(--brand,#1f5eff);font-size:14px;overflow-wrap:anywhere}.cloud-event-panel input{max-width:100%;min-width:0}
.cloud-schedule-card { scroll-margin-top:44px; margin:16px 0; padding:16px; border:1px solid var(--chat-line); border-top:3px solid #1f5eff; border-radius:14px; background:var(--chat-paper); }
.cloud-schedule-card h3 { font-size:17px; margin:10px 0; }
.cloud-schedule-card>small,.cloud-schedule-facts small { display:block; color:var(--chat-muted); font-size:10px; margin-block:8px; overflow-wrap:anywhere; }
.cloud-schedule-facts>strong { font-family:Fraunces,serif; font-size:32px; font-weight:450; color:#1f5eff; }
.cloud-schedule-card p,.cloud-schedule-card li { font-size:12px; line-height:1.8; }
.cloud-schedule-card details { border-top:1px solid var(--chat-line); padding-block:10px; }
.cloud-schedule-card summary { font-size:12px; cursor:pointer; }
.cloud-schedule-card ol { padding-left:19px; }
.cloud-schedule-controls { border:0; padding:0; margin:0; min-width:0; }
.cloud-schedule-controls label { display:flex; align-items:flex-start; gap:8px; margin-block:16px; font-size:12px; line-height:1.8; }
.cloud-schedule-controls input[type=checkbox] { width:auto; flex-shrink:0; margin-top:5px; }
.cloud-schedule-controls button { display:block; margin-top:10px; max-width:100%; white-space:normal; }
.generated-video-card { min-width: 0; border: 1px solid var(--chat-line); border-radius: 14px; padding: 14px; margin: 10px 0; }
.generated-video-card progress, .generated-video-card video { width: 100%; max-width: 100%; accent-color: #1f5eff; }
.generated-video-card video { display: block; margin: 12px 0; border-radius: 10px; }
.generated-video-card button { max-width: 100%; white-space: normal; }
.generated-video-card a { display: inline-block; margin: 8px 0; color: #1f5eff; }

/* CLIENT01: conversation first; existing business controls remain available. */
.sr-only {
  position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
  overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0;
}
.workspace-head { padding: 12px 0; }
#workspace > .field, #work-area > .field { margin: 10px 0; }
.chat-shell { color: var(--chat-ink); min-width: 0; }
.chat-toolbar { display: flex; gap: 8px; justify-content: space-between; margin: 14px 0 10px; }
.chat-toolbar button, .chat-compose-actions button, .chat-attach, .chat-detail {
  border: 1px solid var(--chat-line); background: var(--chat-paper); border-radius: 18px;
  min-height: 36px; padding: 7px 11px; font-size: 11px; color: var(--chat-ink);
}
.chat-history-field { display: flex; gap: 10px; align-items: center; color: var(--chat-muted); font-size: 10px; }
.chat-history-field select { flex: 1; min-width: 0; max-width: 100%; border: none; padding: 8px; background: transparent; color: var(--chat-ink); }
.chat-heading { margin: 18px 0 12px; }
.chat-heading h1 { font-size: 16px; line-height: 1.5; margin: 0 0 4px; font-weight: 650; overflow-wrap: anywhere; }
.chat-heading small { color: var(--chat-muted); font-size: 10px; }
.chat-messages { height: clamp(200px, 35dvh, 520px); overflow-y: auto; overscroll-behavior: contain; padding: 10px 2px 18px; scrollbar-width: thin; }
.chat-welcome { margin: 20px 0 30px; padding: 14px 4px; }
.chat-welcome h2 { font-family: Fraunces, "Microsoft JhengHei", serif; font-size: 27px; line-height: 1.55; font-weight: 450; white-space: pre-line; letter-spacing: -0.7px; color: #1f5eff; }
.chat-welcome p { font-size: 12px; line-height: 1.9; color: var(--chat-muted); }
.chat-message { margin: 0 0 20px; min-width: 0; }
.chat-message > small { display: block; margin-bottom: 7px; font-size: 10px; color: var(--chat-muted); }
.chat-message-body { font-size: 12px; line-height: 1.9; white-space: pre-wrap; overflow-wrap: anywhere; }
.chat-message.from-user { margin-left: 20px; border-radius: 18px 18px 4px 18px; padding: 12px 14px; background: var(--chat-wash); }
.chat-message.from-assistant { padding: 0 4px; }
.chat-detail { margin-top: 8px; min-height: 30px; background: transparent; font-size: 10px; }
.chat-composer { position: sticky; bottom: 0; z-index: 1; border: 1px solid var(--chat-line); border-radius: 18px; padding: 12px; background: var(--chat-paper); }
.chat-composer textarea { width: 100%; min-height: 72px; resize: vertical; max-height: 240px; background: transparent; border: none; border-radius: 4px; padding: 3px; color: var(--chat-ink); font-size: 12px; line-height: 1.8; }
.chat-compose-actions { display: flex; flex-wrap: wrap; gap: 5px; align-items: center; margin-top: 7px; }
.chat-attach { cursor: pointer; display: flex; align-items: center; }
.chat-attach:focus-within { outline: 2px solid #1f5eff; outline-offset: 2px; }
.chat-attach:has(input:disabled) { opacity: .5; cursor: default; }
.folder-review { width: calc(100% - 28px); max-width: 520px; max-height: calc(100dvh - 36px); padding: 0; border: 1px solid var(--chat-line); border-radius: 20px; color: var(--chat-ink); background: var(--chat-paper); box-shadow: 0 20px 60px #0003; overflow: hidden; }
.folder-review[open] { display: flex; flex-direction: column; }
.folder-review::backdrop { background: #0b1d4670; }
.folder-heading { padding: 20px 18px 0; border-top: 4px solid #1f5eff; flex: none; }
.folder-heading>small { font-size: 10px; letter-spacing: .08em; color: #1f5eff; }
.folder-heading h2 { font-size: 19px; letter-spacing: -.5px; line-height: 1.4; margin: 12px 0; }
.folder-heading>strong { display: block; font-size: 13px; overflow-wrap: anywhere; }
.folder-heading>p { font-size: 11px; color: var(--chat-muted); margin: 6px 0 0; }
.folder-review>#folder-note { flex: none; margin: 12px 18px; font-size: 11px; line-height: 1.7; color: var(--chat-muted); }
.folder-files { min-height: 48px; overflow-y: auto; overflow-x: hidden; overscroll-behavior: contain; margin: 0 18px; border-block: 1px solid var(--chat-line); }
.folder-file { display: flex; align-items: flex-start; gap: 10px; padding: 12px 0; cursor: pointer; }
.folder-file+.folder-file { border-top: 1px solid var(--chat-line); }
.folder-file>input { width: 16px; height: 16px; flex: none; margin: 2px 0 0; accent-color: #1f5eff; }
.folder-file>span { min-width: 0; overflow-wrap: anywhere; }
.folder-file strong { display: block; font-size: 11px; line-height: 1.6; font-weight: 600; }
.folder-file small { display: block; font-size: 10px; color: var(--chat-muted); margin-top: 3px; }
.folder-footer { flex: none; padding: 12px 18px 18px; }
.folder-footer progress { width: 100%; height: 6px; accent-color: #1f5eff; }
.folder-footer p { font-size: 11px; line-height: 1.6; margin: 6px 0 12px; overflow-wrap: anywhere; }
.folder-footer p.failed { color: #bb343b; }
.folder-footer>div { display: flex; flex-wrap: wrap; gap: 8px; justify-content: flex-end; }
.folder-footer button { min-height: 38px; padding: 8px 12px; border: 1px solid var(--chat-line); border-radius: 18px; background: var(--chat-paper); color: var(--chat-ink); font-size: 11px; white-space: normal; }
.folder-footer #folder-confirm { color: #fff; background: #1f5eff; border-color: #1f5eff; }
.folder-review button:focus-visible,.folder-file input:focus-visible { outline: 2px solid #1f5eff; outline-offset: 3px; }
@media (max-height: 640px) { .folder-heading { padding: 12px 14px 0; }.folder-heading h2 { font-size: 17px; margin: 8px 0; }.folder-review>#folder-note { margin: 8px 14px; }.folder-footer { padding: 8px 14px 12px; } }
.chat-compose-actions .chat-send { margin-left: auto; background: #1f5eff; color: #fff; border-color: #1f5eff; font-weight: 650; }
.chat-cloud-note { display: block; color: var(--chat-muted); font-size: 9px; line-height: 1.7; margin-top: 10px; }
.chat-settings { margin-top: 10px; font-size: 10px; }
.chat-settings summary, .workspace-tools > summary { cursor: pointer; min-height: 36px; padding: 8px 0; }
.chat-settings .field { margin: 10px 0; font-size: 11px; }
.chat-attachments { display: grid; gap: 6px; }
.chat-attachment { position: relative; padding: 9px 26px 9px 10px; border: 1px solid var(--chat-line); border-radius: 10px; overflow-wrap: anywhere; }
.chat-attachment span { display: block; font-size: 11px; font-weight: 600; }
.chat-attachment small { display: block; font-size: 9px; margin-top: 3px; color: var(--chat-muted); }
.chat-attachment.failed { border-color: #bd3a41; }
.chat-attachment button { position: absolute; top: 5px; right: 4px; background: transparent; border: none; color: var(--chat-muted); min-height: 26px; }
.workspace-tools { margin: 18px 0; border-top: 1px solid var(--chat-line); }
.workspace-tools > summary { font-size: 10px; color: var(--chat-muted); }
@media (prefers-color-scheme: dark) {
  :root { --chat-paper: #18202e; --chat-ink: #f6f6f5; --chat-muted: #b2bdcf; --chat-line: #2d3749; --chat-wash: #202f50; }
  .chat-welcome h2 { color: #79a2ff; }
}
@media (prefers-reduced-motion: reduce) {
  .chat-messages { scroll-behavior: auto; }
}
* {
  box-sizing: border-box;
}
body {
  margin: 0;
  min-width: 300px;
}
button,
input,
textarea,
select {
  font: inherit;
}
button {
  cursor: pointer;
  color: inherit;
}
button:disabled {
  cursor: wait;
  opacity: 0.5;
}
button:focus-visible,
input:focus-visible,
textarea:focus-visible,
select:focus-visible,
summary:focus-visible {
  outline: 2px solid #1f5eff;
  outline-offset: 3px;
}
[hidden] {
  display: none !important;
}
.brand {
  padding: 20px 22px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid #e3e4e5;
  gap: 10px;
}
.brand > div {
  display: flex;
  align-items: center;
  gap: 8px;
}
.brand img {
  height: 29px;
  width: 29px;
}
.brand strong {
  font-size: 21px;
  letter-spacing: -1.1px;
  font-weight: 750;
}
.brand span {
  font-size: 6px;
  letter-spacing: 1px;
  margin-left: 4px;
  color: #646a75;
}
.brand button {
  border: 1px solid #e3e4e5;
  border-radius: 50%;
  background: white;
  width: 36px;
  height: 36px;
  font-size: 19px;
  color: #646a75;
}
.login {
  padding: 44px 26px 25px;
}
.eyebrow {
  font-size: 8px;
  letter-spacing: 1.6px;
  color: #646a75;
  line-height: 1.8;
}
.login h1 {
  font-weight: 450;
  font-size: 38px;
  line-height: 1.4;
  letter-spacing: -1.4px;
  margin: 24px 0 20px;
}
.login h1 em {
  font-family: Fraunces, Georgia, "Microsoft JhengHei", serif;
  color: #1f5eff;
  font-style: normal;
}
.muted {
  color: #646a75;
  font-size: 13px;
  line-height: 1.9;
}
.primary {
  border: none;
  border-radius: 30px;
  background: #1f5eff;
  color: white;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 20px;
  min-height: 46px;
  width: 100%;
  font-weight: 600;
  font-size: 13px;
  margin-top: 25px;
}
.primary span {
  font-size: 18px;
}
.footnote {
  font-size: 10px;
  line-height: 1.9;
  color: #646a75;
  margin-top: 17px;
}
.login-art {
  height: 170px;
  position: relative;
  max-width: 190px;
  margin: 30px auto;
}
.login-art i {
  display: block;
  border: 2px solid #1f5eff;
  width: 75px;
  height: 125px;
  border-radius: 45px;
  position: absolute;
  left: 19px;
  top: 20px;
  transform: rotate(-38deg);
  opacity: 0.8;
}
.login-art i:nth-child(2) {
  left: 59px;
  transform: rotate(0);
}
.login-art i:nth-child(3) {
  left: 99px;
  transform: rotate(38deg);
}
.capability {
  border-top: 1px solid #e3e4e5;
  padding-top: 24px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.capability strong {
  font-size: 13px;
  font-weight: 550;
}
.capability span {
  font-size: 10px;
  color: #646a75;
}
.notice {
  padding: 13px;
  border-radius: 10px;
  background: #edf2ff;
  margin: 15px 20px;
  line-height: 1.8;
  font-size: 12px;
}
.notice.error {
  background: #fff0ee;
  color: #a32e2c;
  border: 1px solid #efd0cc;
  overflow-wrap: anywhere;
}
.workspace-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 24px 0;
}
.workspace-head small {
  font-size: 8px;
  letter-spacing: 1.5px;
  color: #646a75;
}
.workspace-head strong {
  font-size: 12px;
}
#workspace {
  padding: 0 22px;
}
.field {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-bottom: 16px;
  font-size: 11px;
  font-weight: 550;
  line-height: 1.7;
}
.field input,
.field select,
.field textarea {
  width: 100%;
  background: white;
  border: 1px solid #e3e4e5;
  border-radius: 9px;
  padding: 12px;
  min-height: 44px;
  font-size: 13px;
  color: #15171a;
}
.field textarea {
  line-height: 1.8;
  resize: vertical;
}
.tools {
  display: flex;
  gap: 10px;
  margin: 0 0 12px;
}
.tools button,
.file-button {
  padding: 8px 11px;
  border-radius: 22px;
  background: white;
  border: 1px solid #e3e4e5;
  font-size: 10px;
  min-height: 38px;
  cursor: pointer;
  display: flex;
  align-items: center;
}
.hint {
  font-size: 10px;
  color: #246b4e;
  display: block;
  line-height: 1.8;
}
.budget {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: 15px;
}
.budget input {
  max-width: 100px;
  font-size: 12px;
  min-height: 40px;
}
#brief-form .primary {
  margin-top: 15px;
}
.recent {
  margin-top: 32px;
  border-top: 1px solid #e3e4e5;
  padding-top: 24px;
}
h2 {
  font-size: 15px;
  font-weight: 600;
  margin-top: 0;
  letter-spacing: -0.3px;
}
.task-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  border: 0;
  border-bottom: 1px solid #e3e4e5;
  padding: 16px 0;
  background: none;
  gap: 15px;
  text-align: left;
}
.task-row strong {
  font-size: 12px;
  font-weight: 500;
}
.task-row span,
.badge {
  font-size: 9px;
  color: #646a75;
  background: #eeefed;
  border-radius: 20px;
  padding: 4px 7px;
}
.empty-copy {
  font-size: 11px;
  padding: 15px 0;
}
.task-view {
  background: white;
  border: 1px solid #e3e4e5;
  border-radius: 13px;
  padding: 18px;
  margin-top: 25px;
}
.task-view > div:first-child {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.task-view > div:first-child button {
  font-size: 22px;
  border: 0;
  background: none;
  min-width: 36px;
  height: 36px;
}
.task-view pre {
  font:
    12px/1.9 "Microsoft JhengHei",
    system-ui,
    sans-serif;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  margin-top: 20px;
  max-height: 400px;
  overflow: auto;
}
.secondary {
  border: 1px solid #e3e4e5;
  border-radius: 25px;
  background: white;
  min-height: 42px;
  padding: 0 16px;
  font-size: 11px;
}
.native {
  border-top: 1px solid #e3e4e5;
  padding: 20px 0;
  margin-top: 25px;
}
.native summary {
  font-size: 12px;
  cursor: pointer;
  min-height: 30px;
}
.native p {
  font-size: 11px;
  line-height: 1.9;
  color: #646a75;
}
.native small {
  display: block;
  margin-top: 15px;
  font-size: 11px;
}
body > footer {
  padding: 20px 22px;
  border-top: 1px solid #e3e4e5;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 25px;
}
footer button {
  border: 0;
  background: none;
  font-size: 11px;
  min-height: 36px;
}
footer span {
  font-size: 7px;
  letter-spacing: 1px;
  color: #646a75;
}
@media (prefers-color-scheme: dark) {
  :root {
    background: #0f131a;
    color: #e8edf8;
    color-scheme: dark;
  }
  .field input,
  .field select,
  .field textarea,
  .secondary,
  .tools button,
  .file-button,
  .task-view,
  .brand button {
    background: #171d29;
    color: #e8edf8;
    border-color: #2d3749;
  }
  .brand,
  .recent,
  .native,
  .capability,
  .task-row,
  body > footer {
    border-color: #2d3749;
  }
  .muted,
  .footnote,
  .eyebrow,
  .capability span,
  .workspace-head small,
  .task-row span,
  .native p,
  footer span {
    color: #a0abbe;
  }
  .badge,
  .task-row span {
    background: #252e3f;
  }
  .notice.error {
    background: #342124;
    color: #ffa7a3;
    border-color: #5c3435;
  }
  .login h1 em {
    color: #79a2ff;
  }
  .brand button {
    color: #a0abbe;
  }
  .primary {
    background: #79a2ff;
    color: #101b31;
  }
}
@media (prefers-reduced-motion: reduce) {
  * {
    transition: none !important;
    animation: none !important;
  }
}

#local-preview {
  white-space: pre-wrap;
  max-height: 200px;
  overflow: auto;
  font-size: 12px;
}
#local-listing {
  max-height: 180px;
  overflow: auto;
}
.brand #locale {
  font-size: 11px;
  margin-left: auto;
}

.notification-entry {
  border-bottom: 1px solid #e3e4e5;
  padding-bottom: 10px;
}
.notification-entry .task-row {
  border: 0;
}
.notification-entry strong {
  min-width: 0;
  overflow-wrap: anywhere;
}
.notification-mark {
  border: 0;
  background: none;
  color: #1f5eff;
  min-height: 36px;
  font-size: 11px;
  padding: 4px 0;
}
.task-row span {
  flex-shrink: 0;
}
#demo-banner {
  margin: 15px 0;
}
.financial-account,
.financial-notice {
  padding: 16px 0;
  border-bottom: 1px solid color-mix(in srgb, currentColor 18%, transparent);
  min-width: 0;
  overflow-wrap: anywhere;
}
.financial-account dl {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 6px;
  margin: 12px 0;
}
.financial-account dd {
  margin: 0 0 8px;
  font-variant-numeric: tabular-nums;
  font-weight: 650;
}
.financial-account dt {
  font-size: 12px;
}
.financial-notice > p {
  font-variant-numeric: tabular-nums;
  margin: 10px 0;
}
.financial-notice > small {
  display: block;
  margin-bottom: 12px;
}
.financial-notice > button {
  min-height: 44px;
  width: 100%;
}
.financial-filter {
  display: flex;
  align-items: center;
  gap: 8px;
  min-height: 44px;
  cursor: pointer;
}
.financial-filter input {
  width: 18px;
  height: 18px;
}
.recent[aria-labelledby="financial-heading"] .hint {
  color: inherit;
  opacity: 0.85;
}
.input-request {
  padding: 12px 0;
  border-top: 1px solid #b8bdc6;
  display: grid;
  gap: 10px;
  min-width: 0;
}
.input-request strong {
  overflow-wrap: anywhere;
}
.input-request .field {
  margin: 0;
  min-width: 0;
}
.input-search {
  display: flex;
  gap: 8px;
  min-width: 0;
}
.input-search input {
  min-width: 0;
  flex: 1;
  min-height: 44px;
  padding: 10px 12px;
  border: 1px solid #e3e4e5;
  border-radius: 9px;
  background: white;
  color: #15171a;
}
#input-requests {
  display: grid;
  gap: 12px;
}
.input-request .primary {
  margin-top: 0;
  justify-content: center;
}
.input-request [role="alert"] {
  font-size: 12px;
  overflow-wrap: anywhere;
}
.input-request .tools {
  flex-wrap: wrap;
}

@media (prefers-color-scheme: dark) {
  .input-search input {
    background: #18202e;
    border-color: #2d3749;
    color: #f6f6f5;
  }
  .notification-entry {
    border-color: #2d3749;
  }
  .notification-mark {
    color: #79a2ff;
  }
  .notice {
    background: #1d2b49;
    color: #d7e3ff;
  }
}

/* These selectors intentionally outrank the retained business-workspace rules. */
body > .brand { padding: 12px 18px; }
#workspace .workspace-head { display: none; }

/* Match the chat surface for review controls in the narrow native Side Panel. */
#delivery-quality .delivery-quality { font-size:12px; line-height:1.65; }
#delivery-quality input,#delivery-quality select,#delivery-quality textarea {
  min-height:40px; padding:9px 11px; border:1px solid var(--chat-line); border-radius:10px;
  background:var(--chat-paper); color:var(--chat-ink); font:inherit;
}
#delivery-quality button {
  min-height:40px; padding:9px 16px; border:1px solid var(--chat-line); border-radius:22px;
  background:var(--chat-wash); color:var(--chat-ink); font:inherit; font-weight:650;
}
#delivery-quality :is(input,select,textarea,button,summary):focus-visible {
  outline:2px solid #79a2ff; outline-offset:3px;
}
.chat-project-brief { border: 1px solid var(--chat-line); border-left: 3px solid #1f5eff; border-radius: 8px; padding: 9px 11px; margin-bottom: 9px; min-width: 0; overflow-wrap: anywhere; }
.chat-project-brief > summary { font-size: 12px; font-weight: 650; cursor: pointer; }
.chat-project-brief > div { max-height: 26vh; overflow-y: auto; font-size: 12px; line-height: 1.65; white-space: pre-wrap; }
.chat-project-brief > div p { margin: 9px 0; overflow-wrap: anywhere; }

/* The native Side Panel owns one viewport; conversation actions stay in it.
   Long context, attachment lists and advanced tools each retain a scroll area. */
body.signed-in { display: flex; flex-direction: column; height: 100dvh; overflow: hidden; }
body.signed-in > .brand { flex: none; padding: 10px 14px; }
body.signed-in > #workspace { display: flex; flex: 1; flex-direction: column; min-height: 0; padding: 0 14px; }
body.signed-in > #error { flex: none; max-height: 18dvh; overflow-y: auto; margin: 4px 14px; font-size: 11px; }
.workspace-context { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; flex: none; margin: 8px 0; }
.workspace-context .field { min-width: 0; margin: 0; gap: 3px; font-size: 10px; }
.workspace-context select { min-width: 0; max-width: 100%; min-height: 34px; padding: 7px 9px; font-size: 11px; }
#work-area { display: flex; flex-direction: column; flex: 1; min-height: 0; }
#demo-banner { flex: none; margin: 0 0 6px; padding: 6px 9px; font-size: 9px; line-height: 1.45; }
#chat-shell { display: flex; flex-direction: column; flex: 1; height: auto; min-height: 0; }
.chat-meta { flex: 0 1 auto; min-height: 38px; max-height: 38dvh; overflow-y: auto; overscroll-behavior: contain; scrollbar-width: thin; }
.chat-toolbar { gap: 5px; margin: 3px 0 5px; }
.chat-toolbar > button { flex: none; padding: 7px 9px; font-size: 10px; }
.chat-toolbar .chat-history-field { flex: 1; min-width: 0; }
.chat-history-field select { width: 100%; min-height: 34px; font-size: 10px; }
.chat-heading { margin: 6px 0; }
.chat-heading h1 { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; font-size: 15px; }
.chat-project-brief { margin: 6px 0; padding: 8px 9px; }
.chat-project-brief > div { max-height: min(18dvh, 128px); }
.chat-messages { flex: 1 1 80px; height: auto; min-height: 48px; padding: 8px 2px; }
#chat-unavailable, #chat-pending { flex: 0 1 auto; max-height: 14dvh; overflow-y: auto; font-size: 11px; margin: 4px 0; }
#chat-form { position: relative; bottom: auto; flex: 0 1 auto; min-height: 150px; max-height: 55dvh; overflow-y: auto; padding: 10px; }
#chat-input { min-height: 48px; max-height: min(18dvh, 96px); font-size: 12px; line-height: 1.6; }
.chat-attachments { max-height: 80px; overflow-y: auto; scrollbar-width: thin; }
.chat-cloud-note { margin-top: 6px; line-height: 1.45; }
.chat-settings { margin-top: 4px; }
.chat-settings > summary { min-height: 26px; padding: 5px 0; }
#chat-cost:empty { display: none; }
#workspace-tools { flex: none; margin: 4px 0 0; }
#workspace-tools > summary { min-height: 32px; padding: 7px 0; }
#workspace-tools[open] { position: fixed; inset: 68px 12px 42px; z-index: 10; overflow-y: auto; margin: 0; padding: 0 12px 16px; border: 1px solid var(--chat-line); border-radius: 12px; background: var(--chat-paper); color: var(--chat-ink); box-shadow: 0 12px 40px #0003; }
#workspace-tools[open] > summary { position: sticky; top: 0; z-index: 1; min-height: 44px; padding: 12px 0; background: var(--chat-paper); border-bottom: 1px solid var(--chat-line); }
#account-actions { flex: none; margin: 0; padding: 6px 14px; min-height: 28px; }
@media (max-height: 640px) {
  body.signed-in > .brand { padding-block: 7px; }
  .workspace-context { margin-block: 5px; }
  .chat-heading { margin-block: 3px; }
  #chat-form { padding: 8px; }
}
/* Company-managed copy stays inside the native Side Panel. */
.client-content { min-width:0; max-height:180px; overflow:auto; scrollbar-width:none; margin:8px 0; }
.client-content::-webkit-scrollbar { display:none; }
.client-content p { white-space:pre-wrap; overflow-wrap:anywhere; margin:6px 0 0; font-size:12px; }
.client-content article,.client-content details { padding:10px 12px; margin:6px 0; border:1px solid var(--chat-line); border-radius:8px; background:var(--chat-paper); color:var(--chat-ink); }
.client-content article { border-left:3px solid var(--blue,#1f5eff); }
.client-content-menu { display:flex; flex-direction:column; gap:6px; }
.client-content-menu>[hidden] { display:none!important; }
