{
  "schema": "copypaste-cloud-events-schemas-1",
  "schemas": {
    "EventOptions": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "event_type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{2,79}$"
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "overlap_policy": {
          "type": "string",
          "enum": [
            "skip",
            "latest"
          ]
        },
        "min_interval_seconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 86400
        },
        "max_runs_per_day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "max_event_age_seconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 86400
        },
        "starts_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "ends_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "expected_output": {
          "type": "string",
          "minLength": 3,
          "maxLength": 1000
        }
      },
      "required": [
        "name",
        "event_type",
        "timezone",
        "overlap_policy",
        "min_interval_seconds",
        "max_runs_per_day",
        "max_event_age_seconds",
        "ends_at",
        "expected_output"
      ],
      "additionalProperties": false
    },
