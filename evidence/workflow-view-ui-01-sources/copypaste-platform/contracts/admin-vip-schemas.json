          "type": "string",
          "format": "uuid"
        },
        "state": {
          "type": "string",
          "enum": [
            "pending_approval",
            "queued",
            "running",
            "succeeded",
            "partially_succeeded",
            "failed",
            "cancelled",
            "reconciling"
