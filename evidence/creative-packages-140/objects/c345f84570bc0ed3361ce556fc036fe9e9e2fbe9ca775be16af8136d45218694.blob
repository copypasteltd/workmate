.delivery-revision-form{min-width:0;overflow-wrap:anywhere}.delivery-revision-form form,.delivery-revision-form fieldset{display:grid;gap:16px;min-width:0}.delivery-revision-form fieldset{margin:0;padding:0;border:0}.delivery-revision-form textarea,.delivery-revision-form input,.delivery-revision-form select{max-width:100%;min-width:0}.delivery-revision-form .revision-source-text{font-family:inherit;white-space:pre-wrap;overflow-wrap:anywhere;resize:vertical}.revision-quote{display:block;padding:12px;border-left:3px solid var(--blue,#1f5eff);background:var(--surface,#f6f8fc);white-space:pre-wrap}.revision-image{position:relative;max-width:100%;touch-action:none;user-select:none}.revision-image img{display:block;width:100%;height:auto}.revision-image>span{position:absolute;border:2px solid #1f5eff;background:#1f5eff22;pointer-events:none;box-sizing:border-box}.revision-coordinate-fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.delivery-revision-form video{width:100%;max-height:320px}.delivery-revision-form label{display:grid;gap:6px}.delivery-revision-form .check-line{display:flex;align-items:flex-start}.delivery-revision-form .check-line input{flex:0 0 auto}@media(max-width:480px){.revision-coordinate-fields{grid-template-columns:minmax(0,1fr)}}
