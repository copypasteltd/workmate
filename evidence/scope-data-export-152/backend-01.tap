	    AND (NOT $4::boolean OR coalesce(to_jsonb(r)->>'private_owner','')='') LIMIT 100001) selected UNION ALL SELECT 'analysis_reports' AS category,coalesce(jsonb_agg(data),'[]'::jsonb) AS records
