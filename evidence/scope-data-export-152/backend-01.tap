	    FROM (SELECT jsonb_build_object('id',to_jsonb(r.id),'trigger_id',to_jsonb(r.trigger_id),'revision',to_jsonb(r.revision),'tenant_id',to_jsonb(r.tenant_id),'project_id',to_jsonb(r.project_id),'private_owner',to_jsonb(r.private_owner),'event_id',to_jsonb(r.event_id),'event_type',to_jsonb(r.event_type),'data',to_jsonb(r.data),'occurred_at',to_jsonb(r.occurred_at),'received_at',to_jsonb(r.received_at),'expires_at',to_jsonb(r.expires_at),'state',to_jsonb(r.state),'run_id',to_jsonb(r.run_id),'code',to_jsonb(r.code),'launched_at',to_jsonb(r.launched_at)) AS data FROM cloud_event_inbox r WHERE r.tenant_id=$1 AND (r.project_id=ANY($2::uuid[]) AND r.content_state='active' AND r.expires_at>clock_timestamp())
	    AND (NOT $4::boolean OR coalesce(to_jsonb(r)->>'private_owner','')='') LIMIT 100001) selected UNION ALL SELECT 'agent_groups' AS category,coalesce(jsonb_agg(data),'[]'::jsonb) AS records
	    FROM (SELECT jsonb_build_object('id',to_jsonb(r.id),'tenant_id',to_jsonb(r.tenant_id),'project_id',to_jsonb(r.project_id),'name',to_jsonb(r.name),'coordinator_agent_id',to_jsonb(r.coordinator_agent_id),'workspace_id',to_jsonb(r.workspace_id),'version',to_jsonb(r.version),'state',to_jsonb(r.state),'created_by',to_jsonb(r.created_by),'created_at',to_jsonb(r.created_at),'updated_at',to_jsonb(r.updated_at)) AS data FROM agent_groups r WHERE r.tenant_id=$1 AND (r.project_id=ANY($2::uuid[]) AND r.content_state='active')
	    AND (NOT $4::boolean OR coalesce(to_jsonb(r)->>'private_owner','')='') LIMIT 100001) selected UNION ALL SELECT 'agent_group_versions' AS category,coalesce(jsonb_agg(data),'[]'::jsonb) AS records
	    FROM (SELECT jsonb_build_object('group_id',to_jsonb(r.group_id),'version',to_jsonb(r.version),'tenant_id',to_jsonb(r.tenant_id),'project_id',to_jsonb(r.project_id),'body',to_jsonb(r.body),'sha256',to_jsonb(r.sha256),'created_by',to_jsonb(r.created_by),'created_at',to_jsonb(r.created_at)) AS data FROM agent_group_versions r WHERE r.tenant_id=$1 AND (r.group_id IN(SELECT id FROM export_groups) AND r.erased_at IS NULL)
	    AND (NOT $4::boolean OR coalesce(to_jsonb(r)->>'private_owner','')='') LIMIT 100001) selected UNION ALL SELECT 'agent_group_members' AS category,coalesce(jsonb_agg(data),'[]'::jsonb) AS records
	    FROM (SELECT jsonb_build_object('group_id',to_jsonb(r.group_id),'group_version',to_jsonb(r.group_version),'tenant_id',to_jsonb(r.tenant_id),'project_id',to_jsonb(r.project_id),'agent_id',to_jsonb(r.agent_id),'agent_version',to_jsonb(r.agent_version),'is_coordinator',to_jsonb(r.is_coordinator),'role_description',to_jsonb(r.role_description)) AS data FROM agent_group_members r WHERE r.tenant_id=$1 AND (r.group_id IN(SELECT id FROM export_groups) AND true)
	    AND (NOT $4::boolean OR coalesce(to_jsonb(r)->>'private_owner','')='') LIMIT 100001) selected UNION ALL SELECT 'agent_group_runs' AS category,coalesce(jsonb_agg(data),'[]'::jsonb) AS records
	    FROM (SELECT jsonb_build_object('id',to_jsonb(r.id),'group_id',to_jsonb(r.group_id),'group_version',to_jsonb(r.group_version),'tenant_id',to_jsonb(r.tenant_id),'project_id',to_jsonb(r.project_id),'name',to_jsonb(r.name),'created_by',to_jsonb(r.created_by),'private_owner',to_jsonb(r.private_owner),'conversation_id',to_jsonb(r.conversation_id),'coordinator_task_id',to_jsonb(r.coordinator_task_id),'definition',to_jsonb(r.definition),'definition_hash',to_jsonb(r.definition_hash),'approved_budget_micros',to_jsonb(r.approved_budget_micros::text),'max_parallelism',to_jsonb(r.max_parallelism),'state',to_jsonb(r.state),'revision',to_jsonb(r.revision),'error_code',to_jsonb(r.error_code),'created_at',to_jsonb(r.created_at),'deadline_at',to_jsonb(r.deadline_at)) AS data FROM agent_group_runs r WHERE r.tenant_id=$1 AND (r.project_id=ANY($2::uuid[]) AND r.id IN(SELECT id FROM export_group_runs))
	    AND (NOT $4::boolean OR coalesce(to_jsonb(r)->>'private_owner','')='') LIMIT 100001) selected UNION ALL SELECT 'agent_group_nodes' AS category,coalesce(jsonb_agg(data),'[]'::jsonb) AS records
	    FROM (SELECT jsonb_build_object('run_id',to_jsonb(r.run_id),'step_key',to_jsonb(r.step_key),'tenant_id',to_jsonb(r.tenant_id),'project_id',to_jsonb(r.project_id),'position',to_jsonb(r.position),'agent_id',to_jsonb(r.agent_id),'agent_version',to_jsonb(r.agent_version),'role_key',to_jsonb(r.role_key),'role_hash',to_jsonb(r.role_hash),'budget_micros',to_jsonb(r.budget_micros::text),'body',to_jsonb(r.body),'depends_on',to_jsonb(r.depends_on),'task_id',to_jsonb(r.task_id),'state',to_jsonb(r.state),'error_code',to_jsonb(r.error_code)) AS data FROM agent_group_nodes r WHERE r.tenant_id=$1 AND (r.run_id IN(SELECT id FROM export_group_runs) AND (r.task_id IS NULL OR r.task_id IN(SELECT id FROM export_tasks)))
	    AND (NOT $4::boolean OR coalesce(to_jsonb(r)->>'private_owner','')='') LIMIT 100001) selected UNION ALL SELECT 'solution_versions' AS category,coalesce(jsonb_agg(data),'[]'::jsonb) AS records
	    FROM (SELECT jsonb_build_object('id',to_jsonb(r.id),'tenant_id',to_jsonb(r.tenant_id),'project_id',to_jsonb(r.project_id),'family_id',to_jsonb(r.family_id),'version',to_jsonb(r.version),'definition',to_jsonb(r.definition),'frozen',to_jsonb(r.frozen),'definition_hash',to_jsonb(r.definition_hash),'state',to_jsonb(r.state),'created_by',to_jsonb(r.created_by),'created_at',to_jsonb(r.created_at),'published_at',to_jsonb(r.published_at),'disabled_at',to_jsonb(r.disabled_at),'disable_reason',to_jsonb(r.disable_reason)) AS data FROM solution_versions r WHERE r.tenant_id=$1 AND (r.project_id=ANY($2::uuid[]) AND true)
	    AND (NOT $4::boolean OR coalesce(to_jsonb(r)->>'private_owner','')='') LIMIT 100001) selected UNION ALL SELECT 'solution_installations' AS category,coalesce(jsonb_agg(data),'[]'::jsonb) AS records
	    FROM (SELECT jsonb_build_object('id',to_jsonb(r.id),'tenant_id',to_jsonb(r.tenant_id),'project_id',to_jsonb(r.project_id),'solution_version_id',to_jsonb(r.solution_version_id),'name',to_jsonb(r.name),'bindings',to_jsonb(r.bindings),'revision',to_jsonb(r.revision),'created_by',to_jsonb(r.created_by),'created_at',to_jsonb(r.created_at),'updated_at',to_jsonb(r.updated_at)) AS data FROM solution_installations r WHERE r.tenant_id=$1 AND (r.project_id=ANY($2::uuid[]) AND NOT $4::boolean)
	    AND (NOT $4::boolean OR coalesce(to_jsonb(r)->>'private_owner','')='') LIMIT 100001) selected UNION ALL SELECT 'solution_trials' AS category,coalesce(jsonb_agg(data),'[]'::jsonb) AS records
	    FROM (SELECT jsonb_build_object('id',to_jsonb(r.id),'tenant_id',to_jsonb(r.tenant_id),'project_id',to_jsonb(r.project_id),'solution_version_id',to_jsonb(r.solution_version_id),'installation_id',to_jsonb(r.installation_id),'private_owner',to_jsonb(r.private_owner),'definition_hash',to_jsonb(r.definition_hash),'bindings',to_jsonb(r.bindings),'resolved_sources',to_jsonb(r.resolved_sources),'budget_micros',to_jsonb(r.budget_micros::text),'created_at',to_jsonb(r.created_at),'reviewed_at',to_jsonb(r.reviewed_at),'review_hashes',to_jsonb(r.review_hashes)) AS data FROM solution_trials r WHERE r.tenant_id=$1 AND (r.project_id=ANY($2::uuid[]) AND true)
	    AND (NOT $4::boolean OR coalesce(to_jsonb(r)->>'private_owner','')='') LIMIT 100001) selected UNION ALL SELECT '__files',coalesce(jsonb_agg(to_jsonb(selected)),'[]'::jsonb) FROM (
	    SELECT a.id AS asset_id,a.name,a.project_id,v.id AS version_id,v.version,v.bytes::text,v.mime_type,v.sha256,v.storage_key
	    FROM assets a JOIN asset_versions v ON v.asset_id=a.id WHERE v.id IN(SELECT id FROM export_versions)
	    ORDER BY a.id,v.version LIMIT 10001) selected

