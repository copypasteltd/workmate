	 AND (project_id=ANY($2::uuid[]) OR ($5::boolean AND project_id IS NULL))
	 AND ($4::boolean=false OR private_owner IS NULL)
	), export_agents AS MATERIALIZED (SELECT id FROM agents WHERE project_id=ANY($2::uuid[]) AND content_state='active'),
	 export_brands AS MATERIALIZED (SELECT id FROM brand_profiles WHERE project_id=ANY($2::uuid[]) AND content_state='active'),
	 export_datasets AS MATERIALIZED (SELECT id FROM analytics_datasets WHERE project_id=ANY($2::uuid[]) AND content_state='active' AND source_state='active'
	 AND retention_expires_at>clock_timestamp() AND (source_asset_version_id IS NULL OR EXISTS(SELECT 1 FROM export_versions v WHERE v.id=source_asset_version_id))
	 AND connector_dataset_available(source_asset_version_id)),
	 export_reports AS MATERIALIZED (SELECT id FROM analysis_reports WHERE task_id IN(SELECT id FROM export_tasks) AND invalidated_at IS NULL AND analysis_report_available(id)),
	 export_creatives AS MATERIALIZED (SELECT id FROM creative_projects WHERE project_id=ANY($2::uuid[]) AND content_state='active' AND retention_expires_at>clock_timestamp()
	 AND (private_owner IS NULL OR private_owner=$3) AND ($4::boolean=false OR private_owner IS NULL)
	 AND (origin_task_id IS NULL OR origin_task_id IN(SELECT id FROM export_tasks))),
	 export_workflows AS MATERIALIZED (SELECT id FROM workflows WHERE project_id=ANY($2::uuid[]) AND content_state='active' AND ($4::boolean=false OR private_owner IS NULL)),
	 export_groups AS MATERIALIZED (SELECT id FROM agent_groups WHERE project_id=ANY($2::uuid[]) AND content_state='active'),
	 export_group_runs AS MATERIALIZED (SELECT id FROM agent_group_runs WHERE project_id=ANY($2::uuid[]) AND content_state='active'
	 AND retention_expires_at>clock_timestamp() AND ($4::boolean=false OR private_owner IS NULL)
	 AND (coordinator_task_id IS NULL OR coordinator_task_id IN(SELECT id FROM export_tasks))) SELECT 'projects' AS category,coalesce(jsonb_agg(data),'[]'::jsonb) AS records
	    FROM (SELECT jsonb_build_object('id',to_jsonb(r.id),'tenant_id',to_jsonb(r.tenant_id),'name',to_jsonb(r.name),'description',to_jsonb(r.description),'archived',to_jsonb(r.archived),'created_at',to_jsonb(r.created_at)) AS data FROM projects r WHERE r.tenant_id=$1 AND (r.id=ANY($2::uuid[]))
	    AND (NOT $4::boolean OR coalesce(to_jsonb(r)->>'private_owner','')='') LIMIT 100001) selected UNION ALL SELECT 'assets' AS category,coalesce(jsonb_agg(data),'[]'::jsonb) AS records
	    FROM (SELECT jsonb_build_object('id',to_jsonb(r.id),'tenant_id',to_jsonb(r.tenant_id),'project_id',to_jsonb(r.project_id),'name',to_jsonb(r.name),'kind',to_jsonb(r.kind),'current_version',to_jsonb(r.current_version),'private_owner',to_jsonb(r.private_owner),'created_by',to_jsonb(r.created_by),'created_at',to_jsonb(r.created_at),'retention_expires_at',to_jsonb(r.retention_expires_at)) AS data FROM assets r WHERE r.tenant_id=$1 AND (r.id IN(SELECT id FROM export_assets))
	    AND (NOT $4::boolean OR coalesce(to_jsonb(r)->>'private_owner','')='') LIMIT 100001) selected UNION ALL SELECT 'asset_versions' AS category,coalesce(jsonb_agg(data),'[]'::jsonb) AS records
	    FROM (SELECT jsonb_build_object('id',to_jsonb(r.id),'tenant_id',to_jsonb(r.tenant_id),'asset_id',to_jsonb(r.asset_id),'version',to_jsonb(r.version),'mime_type',to_jsonb(r.mime_type),'bytes',to_jsonb(r.bytes::text),'sha256',to_jsonb(r.sha256),'metadata',to_jsonb(r.metadata),'created_at',to_jsonb(r.created_at)) AS data FROM asset_versions r WHERE r.tenant_id=$1 AND (r.asset_id IN(SELECT id FROM export_assets) AND r.erased_at IS NULL AND task_asset_version_sources_available(r.id))
	    AND (NOT $4::boolean OR coalesce(to_jsonb(r)->>'private_owner','')='') LIMIT 100001) selected UNION ALL SELECT 'tasks' AS category,coalesce(jsonb_agg(data),'[]'::jsonb) AS records
	    FROM (SELECT jsonb_build_object('id',to_jsonb(r.id),'tenant_id',to_jsonb(r.tenant_id),'project_id',to_jsonb(r.project_id),'created_by',to_jsonb(r.created_by),'private_owner',to_jsonb(r.private_owner),'conversation_id',to_jsonb(r.conversation_id),'title',to_jsonb(r.title),'prompt',to_jsonb(r.prompt),'role_key',to_jsonb(r.role_key),'role_hash',to_jsonb(r.role_hash),'kernel',to_jsonb(r.kernel),'status',to_jsonb(r.status),'mode',to_jsonb(r.mode),'acceptance',to_jsonb(r.acceptance),'output',to_jsonb(r.output),'error_code',to_jsonb(r.error_code),'budget_micros',to_jsonb(r.budget_micros::text),'charged_micros',to_jsonb(r.charged_micros::text),'input_tokens',to_jsonb(r.input_tokens::text),'output_tokens',to_jsonb(r.output_tokens::text),'version',to_jsonb(r.version),'parent_id',to_jsonb(r.parent_id),'execution_location',to_jsonb(r.execution_location),'input_context',to_jsonb(r.input_context),'created_at',to_jsonb(r.created_at),'updated_at',to_jsonb(r.updated_at),'retention_expires_at',to_jsonb(r.retention_expires_at)) AS data FROM tasks r WHERE r.tenant_id=$1 AND (r.id IN(SELECT id FROM export_tasks))
	    AND (NOT $4::boolean OR coalesce(to_jsonb(r)->>'private_owner','')='') LIMIT 100001) selected UNION ALL SELECT 'task_plans' AS category,coalesce(jsonb_agg(data),'[]'::jsonb) AS records
	    FROM (SELECT jsonb_build_object('task_id',to_jsonb(r.task_id),'tenant_id',to_jsonb(r.tenant_id),'project_id',to_jsonb(r.project_id),'version',to_jsonb(r.version),'input_hash',to_jsonb(r.input_hash),'body',to_jsonb(r.body),'conversation_version',to_jsonb(r.conversation_version),'approved_task_id',to_jsonb(r.approved_task_id),'approved_by',to_jsonb(r.approved_by),'approved_at',to_jsonb(r.approved_at)) AS data FROM task_plans r WHERE r.tenant_id=$1 AND (r.task_id IN(SELECT id FROM export_tasks) AND true)
	    AND (NOT $4::boolean OR coalesce(to_jsonb(r)->>'private_owner','')='') LIMIT 100001) selected UNION ALL SELECT 'task_events' AS category,coalesce(jsonb_agg(data),'[]'::jsonb) AS records
	    FROM (SELECT jsonb_build_object('id',to_jsonb(r.id),'tenant_id',to_jsonb(r.tenant_id),'task_id',to_jsonb(r.task_id),'kind',to_jsonb(r.kind),'body',to_jsonb(r.body),'created_at',to_jsonb(r.created_at)) AS data FROM task_events r WHERE r.tenant_id=$1 AND (r.task_id IN(SELECT id FROM export_tasks) AND true)
	    AND (NOT $4::boolean OR coalesce(to_jsonb(r)->>'private_owner','')='') LIMIT 100001) selected UNION ALL SELECT 'delivery_reviews' AS category,coalesce(jsonb_agg(data),'[]'::jsonb) AS records
	    FROM (SELECT jsonb_build_object('id',to_jsonb(r.id),'task_id',to_jsonb(r.task_id),'reviewer_id',to_jsonb(r.reviewer_id),'task_version',to_jsonb(r.task_version),'decision',to_jsonb(r.decision),'comment',to_jsonb(r.comment),'delivery_snapshot',to_jsonb(r.delivery_snapshot),'artifact_ids',to_jsonb(r.artifact_ids),'created_at',to_jsonb(r.created_at)) AS data FROM delivery_reviews r WHERE r.tenant_id=$1 AND (r.task_id IN(SELECT id FROM export_tasks) AND r.erased_at IS NULL)
	    AND (NOT $4::boolean OR coalesce(to_jsonb(r)->>'private_owner','')='') LIMIT 100001) selected UNION ALL SELECT 'task_quality_measurements' AS category,coalesce(jsonb_agg(data),'[]'::jsonb) AS records
	    FROM (SELECT jsonb_build_object('id',to_jsonb(r.id),'task_id',to_jsonb(r.task_id),'reporter_id',to_jsonb(r.reporter_id),'task_version',to_jsonb(r.task_version),'baseline_minutes',to_jsonb(r.baseline_minutes),'human_minutes',to_jsonb(r.human_minutes),'manual_revisions',to_jsonb(r.manual_revisions),'created_at',to_jsonb(r.created_at)) AS data FROM task_quality_measurements r WHERE r.tenant_id=$1 AND (r.task_id IN(SELECT id FROM export_tasks) AND r.erased_at IS NULL)
	    AND (NOT $4::boolean OR coalesce(to_jsonb(r)->>'private_owner','')='') LIMIT 100001) selected UNION ALL SELECT 'task_dependencies' AS category,coalesce(jsonb_agg(data),'[]'::jsonb) AS records
	    FROM (SELECT jsonb_build_object('id',to_jsonb(r.id),'task_id',to_jsonb(r.task_id),'step_key',to_jsonb(r.step_key),'kind',to_jsonb(r.kind),'description',to_jsonb(r.description),'required_scope',to_jsonb(r.required_scope),'provider',to_jsonb(r.provider),'state',to_jsonb(r.state),'resource_ids',to_jsonb(r.resource_ids),'version',to_jsonb(r.version),'created_at',to_jsonb(r.created_at),'resolved_at',to_jsonb(r.resolved_at)) AS data FROM task_dependencies r WHERE r.tenant_id=$1 AND (r.task_id IN(SELECT id FROM export_tasks) AND true)
	    AND (NOT $4::boolean OR coalesce(to_jsonb(r)->>'private_owner','')='') LIMIT 100001) selected UNION ALL SELECT 'task_source_reads' AS category,coalesce(jsonb_agg(data),'[]'::jsonb) AS records
	    FROM (SELECT jsonb_build_object('task_id',to_jsonb(r.task_id),'kind',to_jsonb(r.kind),'resource_id',to_jsonb(r.resource_id),'asset_version_id',to_jsonb(r.asset_version_id),'sha256',to_jsonb(r.sha256),'created_at',to_jsonb(r.created_at)) AS data FROM task_source_reads r WHERE r.tenant_id=$1 AND (r.task_id IN(SELECT id FROM export_tasks) AND true)
	    AND (NOT $4::boolean OR coalesce(to_jsonb(r)->>'private_owner','')='') LIMIT 100001) selected UNION ALL SELECT 'conversations' AS category,coalesce(jsonb_agg(data),'[]'::jsonb) AS records
	    FROM (SELECT jsonb_build_object('id',to_jsonb(r.id),'tenant_id',to_jsonb(r.tenant_id),'project_id',to_jsonb(r.project_id),'agent_id',to_jsonb(r.agent_id),'agent_version',to_jsonb(r.agent_version),'created_by',to_jsonb(r.created_by),'name',to_jsonb(r.name),'pinned',to_jsonb(r.pinned),'archived',to_jsonb(r.archived),'version',to_jsonb(r.version),'created_at',to_jsonb(r.created_at),'updated_at',to_jsonb(r.updated_at)) AS data FROM conversations r WHERE r.tenant_id=$1 AND (r.project_id=ANY($2::uuid[]) AND r.content_state='active' AND created_by=$3)
	    AND (NOT $4::boolean OR coalesce(to_jsonb(r)->>'private_owner','')='') LIMIT 100001) selected UNION ALL SELECT 'conversation_messages' AS category,coalesce(jsonb_agg(data),'[]'::jsonb) AS records
	    FROM (SELECT jsonb_build_object('id',to_jsonb(r.id),'tenant_id',to_jsonb(r.tenant_id),'project_id',to_jsonb(r.project_id),'conversation_id',to_jsonb(r.conversation_id),'role',to_jsonb(r.role),'intent',to_jsonb(r.intent),'body',CASE WHEN r.role='assistant' AND r.task_id IS NOT NULL AND NOT (r.task_id=ANY($6::uuid[])) THEN to_jsonb('內容暫不可用 / Source unavailable'::text) ELSE to_jsonb(r.body) END,'task_id',to_jsonb(r.task_id),'created_at',to_jsonb(r.created_at),'source_unavailable',to_jsonb(r.role='assistant' AND r.task_id IS NOT NULL AND NOT (r.task_id=ANY($6::uuid[])))) AS data FROM conversation_messages r WHERE r.tenant_id=$1 AND (r.conversation_id IN(SELECT id FROM conversations WHERE project_id=ANY($2::uuid[]) AND created_by=$3 AND content_state='active'))
	    AND (NOT $4::boolean OR coalesce(to_jsonb(r)->>'private_owner','')='') LIMIT 100001) selected UNION ALL SELECT 'memories' AS category,coalesce(jsonb_agg(data),'[]'::jsonb) AS records
	    FROM (SELECT jsonb_build_object('id',to_jsonb(r.id),'tenant_id',to_jsonb(r.tenant_id),'project_id',to_jsonb(r.project_id),'brand_id',to_jsonb(r.brand_id),'conversation_id',to_jsonb(r.conversation_id),'private_owner',to_jsonb(r.private_owner),'scope',to_jsonb(r.scope),'name',to_jsonb(r.name),'version',to_jsonb(r.version),'expires_at',to_jsonb(r.expires_at),'created_by',to_jsonb(r.created_by),'created_at',to_jsonb(r.created_at),'updated_at',to_jsonb(r.updated_at)) AS data FROM memories r WHERE r.tenant_id=$1 AND (r.id IN(SELECT id FROM export_memories))
	    AND (NOT $4::boolean OR coalesce(to_jsonb(r)->>'private_owner','')='') LIMIT 100001) selected UNION ALL SELECT 'memory_versions' AS category,coalesce(jsonb_agg(data),'[]'::jsonb) AS records
	    FROM (SELECT jsonb_build_object('tenant_id',to_jsonb(r.tenant_id),'memory_id',to_jsonb(r.memory_id),'version',to_jsonb(r.version),'content',to_jsonb(r.content),'created_by',to_jsonb(r.created_by),'created_at',to_jsonb(r.created_at)) AS data FROM memory_versions r WHERE r.tenant_id=$1 AND (r.memory_id IN(SELECT id FROM export_memories) AND r.content IS NOT NULL)
	    AND (NOT $4::boolean OR coalesce(to_jsonb(r)->>'private_owner','')='') LIMIT 100001) selected UNION ALL SELECT 'agents' AS category,coalesce(jsonb_agg(data),'[]'::jsonb) AS records
	    FROM (SELECT jsonb_build_object('id',to_jsonb(r.id),'tenant_id',to_jsonb(r.tenant_id),'project_id',to_jsonb(r.project_id),'name',to_jsonb(r.name),'role_key',to_jsonb(r.role_key),'version',to_jsonb(r.version),'enabled',to_jsonb(r.enabled),'created_by',to_jsonb(r.created_by),'created_at',to_jsonb(r.created_at),'updated_at',to_jsonb(r.updated_at)) AS data FROM agents r WHERE r.tenant_id=$1 AND (r.project_id=ANY($2::uuid[]) AND r.content_state='active')
	    AND (NOT $4::boolean OR coalesce(to_jsonb(r)->>'private_owner','')='') LIMIT 100001) selected UNION ALL SELECT 'agent_versions' AS category,coalesce(jsonb_agg(data),'[]'::jsonb) AS records
	    FROM (SELECT jsonb_build_object('tenant_id',to_jsonb(r.tenant_id),'agent_id',to_jsonb(r.agent_id),'version',to_jsonb(r.version),'body',to_jsonb(r.body),'created_by',to_jsonb(r.created_by),'created_at',to_jsonb(r.created_at)) AS data FROM agent_versions r WHERE r.tenant_id=$1 AND (r.agent_id IN(SELECT id FROM export_agents) AND true)
	    AND (NOT $4::boolean OR coalesce(to_jsonb(r)->>'private_owner','')='') LIMIT 100001) selected UNION ALL SELECT 'agent_skill_bindings' AS category,coalesce(jsonb_agg(data),'[]'::jsonb) AS records
	    FROM (SELECT jsonb_build_object('tenant_id',to_jsonb(r.tenant_id),'project_id',to_jsonb(r.project_id),'agent_id',to_jsonb(r.agent_id),'agent_version',to_jsonb(r.agent_version),'installation_id',to_jsonb(r.installation_id),'skill_version_id',to_jsonb(r.skill_version_id),'required',to_jsonb(r.required)) AS data FROM agent_skill_bindings r WHERE r.tenant_id=$1 AND (r.agent_id IN(SELECT id FROM export_agents) AND true)
	    AND (NOT $4::boolean OR coalesce(to_jsonb(r)->>'private_owner','')='') LIMIT 100001) selected UNION ALL SELECT 'skill_installations' AS category,coalesce(jsonb_agg(data),'[]'::jsonb) AS records
	    FROM (SELECT jsonb_build_object('id',to_jsonb(r.id),'tenant_id',to_jsonb(r.tenant_id),'project_id',to_jsonb(r.project_id),'skill_version_id',to_jsonb(r.skill_version_id),'enabled',to_jsonb(r.enabled),'state',to_jsonb(r.state),'version',to_jsonb(r.version),'created_by',to_jsonb(r.created_by),'created_at',to_jsonb(r.created_at),'updated_at',to_jsonb(r.updated_at)) AS data FROM skill_installations r WHERE r.tenant_id=$1 AND (r.project_id=ANY($2::uuid[]) AND true)
	    AND (NOT $4::boolean OR coalesce(to_jsonb(r)->>'private_owner','')='') LIMIT 100001) selected UNION ALL SELECT 'brand_profiles' AS category,coalesce(jsonb_agg(data),'[]'::jsonb) AS records
	    FROM (SELECT jsonb_build_object('id',to_jsonb(r.id),'tenant_id',to_jsonb(r.tenant_id),'project_id',to_jsonb(r.project_id),'name',to_jsonb(r.name),'version',to_jsonb(r.version),'body',to_jsonb(r.body),'created_at',to_jsonb(r.created_at)) AS data FROM brand_profiles r WHERE r.tenant_id=$1 AND (r.project_id=ANY($2::uuid[]) AND r.content_state='active')
	    AND (NOT $4::boolean OR coalesce(to_jsonb(r)->>'private_owner','')='') LIMIT 100001) selected UNION ALL SELECT 'brand_profile_versions' AS category,coalesce(jsonb_agg(data),'[]'::jsonb) AS records
	    FROM (SELECT jsonb_build_object('brand_id',to_jsonb(r.brand_id),'version',to_jsonb(r.version),'tenant_id',to_jsonb(r.tenant_id),'project_id',to_jsonb(r.project_id),'name',to_jsonb(r.name),'body',to_jsonb(r.body),'sha256',to_jsonb(r.sha256),'created_by',to_jsonb(r.created_by),'created_at',to_jsonb(r.created_at)) AS data FROM brand_profile_versions r WHERE r.tenant_id=$1 AND (r.brand_id IN(SELECT id FROM export_brands) AND r.erased_at IS NULL AND brand_version_available(r.brand_id,r.version))
	    AND (NOT $4::boolean OR coalesce(to_jsonb(r)->>'private_owner','')='') LIMIT 100001) selected UNION ALL SELECT 'brand_version_assets' AS category,coalesce(jsonb_agg(data),'[]'::jsonb) AS records
	    FROM (SELECT jsonb_build_object('brand_id',to_jsonb(r.brand_id),'version',to_jsonb(r.version),'tenant_id',to_jsonb(r.tenant_id),'project_id',to_jsonb(r.project_id),'kind',to_jsonb(r.kind),'source_key',to_jsonb(r.source_key),'asset_version_id',to_jsonb(r.asset_version_id)) AS data FROM brand_version_assets r WHERE r.tenant_id=$1 AND (r.brand_id IN(SELECT id FROM export_brands) AND r.asset_version_id IN(SELECT id FROM export_versions))
	    AND (NOT $4::boolean OR coalesce(to_jsonb(r)->>'private_owner','')='') LIMIT 100001) selected UNION ALL SELECT 'cloud_workspaces' AS category,coalesce(jsonb_agg(data),'[]'::jsonb) AS records
	    FROM (SELECT jsonb_build_object('id',to_jsonb(r.id),'tenant_id',to_jsonb(r.tenant_id),'project_id',to_jsonb(r.project_id),'conversation_id',to_jsonb(r.conversation_id),'kind',to_jsonb(r.kind),'private_owner',to_jsonb(r.private_owner),'version',to_jsonb(r.version),'created_at',to_jsonb(r.created_at)) AS data FROM cloud_workspaces r WHERE r.tenant_id=$1 AND (r.project_id=ANY($2::uuid[]) AND r.content_state='active')
	    AND (NOT $4::boolean OR coalesce(to_jsonb(r)->>'private_owner','')='') LIMIT 100001) selected UNION ALL SELECT 'workspace_nodes' AS category,coalesce(jsonb_agg(data),'[]'::jsonb) AS records
	    FROM (SELECT jsonb_build_object('id',to_jsonb(r.id),'tenant_id',to_jsonb(r.tenant_id),'project_id',to_jsonb(r.project_id),'workspace_id',to_jsonb(r.workspace_id),'parent_id',to_jsonb(r.parent_id),'name',to_jsonb(r.name),'kind',to_jsonb(r.kind),'asset_version_id',to_jsonb(r.asset_version_id),'root_kind',to_jsonb(r.root_kind),'version',to_jsonb(r.version),'reference_state',to_jsonb(r.reference_state),'private_owner',to_jsonb(r.private_owner),'created_by',to_jsonb(r.created_by),'created_at',to_jsonb(r.created_at),'updated_at',to_jsonb(r.updated_at)) AS data FROM workspace_nodes r WHERE r.tenant_id=$1 AND (r.project_id=ANY($2::uuid[]) AND r.content_state='active' AND (r.asset_version_id IS NULL OR r.asset_version_id IN(SELECT id FROM export_versions)))
	    AND (NOT $4::boolean OR coalesce(to_jsonb(r)->>'private_owner','')='') LIMIT 100001) selected UNION ALL SELECT 'project_configurations' AS category,coalesce(jsonb_agg(data),'[]'::jsonb) AS records
	    FROM (SELECT jsonb_build_object('id',to_jsonb(r.id),'tenant_id',to_jsonb(r.tenant_id),'project_id',to_jsonb(r.project_id),'name',to_jsonb(r.name),'draft',to_jsonb(r.draft),'current_version',to_jsonb(r.current_version),'version',to_jsonb(r.version),'created_by',to_jsonb(r.created_by),'created_at',to_jsonb(r.created_at),'updated_at',to_jsonb(r.updated_at)) AS data FROM project_configurations r WHERE r.tenant_id=$1 AND (r.project_id=ANY($2::uuid[]) AND r.content_state='active')
	    AND (NOT $4::boolean OR coalesce(to_jsonb(r)->>'private_owner','')='') LIMIT 100001) selected UNION ALL SELECT 'project_configuration_versions' AS category,coalesce(jsonb_agg(data),'[]'::jsonb) AS records
	    FROM (SELECT jsonb_build_object('configuration_id',to_jsonb(r.configuration_id),'version',to_jsonb(r.version),'tenant_id',to_jsonb(r.tenant_id),'project_id',to_jsonb(r.project_id),'body',to_jsonb(r.body),'sha256',to_jsonb(r.sha256),'created_by',to_jsonb(r.created_by),'created_at',to_jsonb(r.created_at)) AS data FROM project_configuration_versions r WHERE r.tenant_id=$1 AND (r.project_id=ANY($2::uuid[]) AND r.erased_at IS NULL AND EXISTS(SELECT 1 FROM project_configurations p WHERE p.id=r.configuration_id AND p.content_state='active'))
	    AND (NOT $4::boolean OR coalesce(to_jsonb(r)->>'private_owner','')='') LIMIT 100001) selected UNION ALL SELECT 'analytics_datasets' AS category,coalesce(jsonb_agg(data),'[]'::jsonb) AS records
	    FROM (SELECT jsonb_build_object('id',to_jsonb(r.id),'tenant_id',to_jsonb(r.tenant_id),'project_id',to_jsonb(r.project_id),'name',to_jsonb(r.name),'currency',to_jsonb(r.currency),'timezone',to_jsonb(r.timezone),'rows',to_jsonb(r.rows),'source',to_jsonb(r.source),'raw_csv',to_jsonb(r.raw_csv),'source_filename',to_jsonb(r.source_filename),'source_sha256',to_jsonb(r.source_sha256),'import_spec',to_jsonb(r.import_spec),'import_metadata',to_jsonb(r.import_metadata),'metric_snapshot',to_jsonb(r.metric_snapshot),'source_asset_version_id',to_jsonb(r.source_asset_version_id),'spec_hash',to_jsonb(r.spec_hash),'created_by',to_jsonb(r.created_by),'created_at',to_jsonb(r.created_at),'retention_expires_at',to_jsonb(r.retention_expires_at)) AS data FROM analytics_datasets r WHERE r.tenant_id=$1 AND (r.project_id=ANY($2::uuid[]) AND r.id IN(SELECT id FROM export_datasets))
	    AND (NOT $4::boolean OR coalesce(to_jsonb(r)->>'private_owner','')='') LIMIT 100001) selected UNION ALL SELECT 'dataset_evidence' AS category,coalesce(jsonb_agg(data),'[]'::jsonb) AS records
