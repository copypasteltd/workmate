import assert from "node:assert/strict";
import {chromium,type Browser,type Page} from "playwright";
import {readFile,writeFile} from "node:fs/promises";
import {pathToFileURL} from "node:url";
import path from "node:path";
import {WorkmateRecording,saveWorkmateScreenshot} from "./record-workmate-media.js";
const delivery=process.cwd(),platform=path.resolve("../copypaste-platform"),attempt=process.argv[2];assert.match(attempt??"",/^\d{2}$/);
const prefix="evidence/conversation-work-157/ui-"+attempt,checks:string[]=[],errors:string[]=[],screenshots:any[]=[],recordings:any[]=[],layouts:any[]=[];
const load=(file:string)=>import(pathToFileURL(path.join(platform,file)).href),pass=(name:string)=>{checks.push(name);console.log("PASS: "+name);};
let system:any,isolated:any,browser:Browser|undefined,recording:WorkmateRecording|undefined,stage="setup",browserClosed=false,apiClosed=false,fixtureClosed=false;
async function shot(page:Page,name:string){screenshots.push(await saveWorkmateScreenshot("web","conversation-work-157-"+attempt,name,await page.screenshot(),"Actual Web independent cloud work, selected progress/input/stop target and retained lost-response retry; synthetic SQL business fixtures, no model request.",delivery));}
async function stopRecording(){if(recording){const r=recording;recording=undefined;recordings.push(await r.stop());}}
try{
 const [{isolatedTestEnvironment},{buildApp},{loadConfig},{workFixture},{historyOk}]=await Promise.all([load("tests/native-test-environment.ts"),load("src/server.ts"),load("src/config.ts"),load("tests/conversation-work-fixture-157-v2.ts"),load("tests/admin-history-fixture.ts")]);
 process.chdir(platform);isolated=await isolatedTestEnvironment();system=await buildApp(loadConfig({...isolated.env,NODE_ENV:"test",DEMO_MODE:"true",DEV_MAILBOX:"true",WORKER_ENABLED:"false",API_ORIGIN:"http://localhost:4310",WEB_ORIGIN:"http://localhost:4317",ADMIN_ORIGIN:"http://localhost:4318"}),{worker:false});await system.app.listen({host:"127.0.0.1",port:4310});const f=await workFixture(system);
 const taskRows=async()=>(await system.db.control.query("SELECT id,status,prompt FROM tasks WHERE conversation_id=$1 ORDER BY created_at,id",[f.conversation.id])).rows;
 browser=await chromium.launch({executablePath:process.env.CHROME_BIN,headless:true});const context=await browser.newContext({viewport:{width:1440,height:1000}}),page=await context.newPage();page.setDefaultTimeout(20000);page.on("pageerror",e=>errors.push(e.message));
 await context.addInitScript(()=>{if(!localStorage.getItem("cp_locale"))localStorage.setItem("cp_locale","en");if(!localStorage.getItem("cp_theme"))localStorage.setItem("cp_theme","light");});
 stage="customer OTP";await page.goto("http://localhost:4317/login");await page.locator('input[name="email"]').fill(f.owner.email);
 const [challenge]=await Promise.all([page.waitForResponse(r=>new URL(r.url()).pathname==="/v1/auth/challenges"),page.locator('form button[type="submit"]').click()]);assert.equal(challenge.status(),202);
 const mail=JSON.parse(await readFile(path.join(isolated.directory,"mailbox",(await challenge.json()).challenge_id+".json"),"utf8"));await page.locator('input[name="code"]').fill(mail.text.match(/\b\d{6}\b/)[0]);await page.locator('form button[type="submit"]').click();await page.waitForURL("**/app");
 await page.evaluate(({tenant,project})=>{localStorage.setItem("cp_tenant",tenant);localStorage.setItem("cp_project",project);},{tenant:f.tenant,project:f.project});await page.goto("http://localhost:4317/app/conversations/"+f.conversation.id);await page.getByRole("heading",{level:1,name:f.conversation.name,exact:true}).waitFor();pass("Customer email OTP opens the correct private conversation and paid-work scope");
 const composer=()=>page.locator(".ongoing-conversation form"),submit=()=>composer().getByRole("button",{name:"Delegate task",exact:true});
 async function send(prompt:string){await composer().locator("textarea").fill(prompt);const [reply]=await Promise.all([page.waitForResponse(r=>r.request().method()==="POST"&&new URL(r.url()).pathname.endsWith("/messages")),submit().click()]);assert.equal(reply.status(),200,await reply.text());await page.waitForFunction(()=>!document.querySelector<HTMLTextAreaElement>(".ongoing-conversation form textarea")?.value);const accepted=await reply.json();await page.waitForFunction(id=>document.querySelector("[data-selected-task]")?.getAttribute("data-selected-task")===id,accepted.task.id);}
 recording=new WorkmateRecording("web","independent-cloud-work","conversation-work-157-"+attempt,()=>page.screenshot({type:"jpeg",quality:72}),"Actual independent work admissions and explicit task selection, without model execution",delivery);await recording.start();
 stage="independent submissions";await send("Review independent Hong Kong campaign creative");await send("Build the independent campaign landing page");let tasks=await taskRows();assert.equal(tasks.length,2);assert.ok(tasks.every((t:any)=>t.status==="queued"));const selector=()=>page.getByRole("combobox",{name:"Select a task to view or provide inputs",exact:true});await selector().selectOption(tasks[0].id);assert.equal(await page.locator("[data-selected-task]").getAttribute("data-selected-task"),tasks[0].id);await page.locator("h1").scrollIntoViewIfNeeded();await shot(page,"two-independent-tasks");pass("Two browser delegations remain independently queued with distinct names and explicit selected progress/input target");
 stage="lost acceptance response";const prompt="Prepare independent typography options after a lost reply";let aborted=false;await page.route("**/conversations/*/messages",async route=>{if(!aborted&&route.request().method()==="POST"){aborted=true;const response=await route.fetch();assert.equal(response.status(),200);await route.abort("failed");}else await route.continue();});
 await composer().locator("textarea").fill(prompt);await submit().click();await page.waitForFunction(()=>!!document.querySelector(".ongoing-conversation form textarea")&&document.querySelector(".ongoing-conversation form button[type=submit]")?.getAttribute("disabled")===null);assert.equal((await taskRows()).length,3);
 await page.unroute("**/conversations/*/messages");await page.reload();await page.getByRole("heading",{level:1,name:f.conversation.name,exact:true}).waitFor();await send(prompt);assert.equal((await taskRows()).length,3);await page.locator("h1").scrollIntoViewIfNeeded();await shot(page,"lost-reply-recovered");pass("A lost committed response survives same-tab reload and exact retry without a fourth paid task");
 stage="selected cancellation";await selector().selectOption(tasks[0].id);await page.locator("[data-selected-task]").getByRole("link",{name:"View progress or cancel",exact:true}).click();await page.waitForURL("**/tasks/"+tasks[0].id);await page.getByRole("button",{name:"Cancel task",exact:true}).click();await page.getByRole("button",{name:"Cancel task",exact:true}).waitFor({state:"detached"});tasks=await taskRows();assert.equal(tasks[0].status,"cancelled");assert.equal(tasks[1].status,"queued");await page.goto("http://localhost:4317/app/conversations/"+f.conversation.id);await selector().selectOption(tasks[1].id);await page.locator("h1").scrollIntoViewIfNeeded();await shot(page,"only-selected-task-cancelled");await stopRecording();pass("The selected work opens its exact control page and cancellation leaves the other task queued");
 stage="compact Chinese";await page.getByTitle("切換至繁體中文",{exact:true}).click();await page.waitForFunction(()=>document.documentElement.lang==="zh-Hant-HK");await page.reload();assert.equal(await page.evaluate(()=>localStorage.getItem("cp_locale")),"zh-HK");await page.getByRole("combobox",{name:"選擇要查看或補充資料的工作",exact:true}).waitFor();await page.setViewportSize({width:390,height:1000});await page.locator("h1").scrollIntoViewIfNeeded();
 const layout=await page.evaluate(()=>({width:innerWidth,document:document.documentElement.scrollWidth,body:document.body.scrollWidth}));layouts.push(layout);await shot(page,"compact-zh-selected-work");assert.ok(layout.document<=layout.width&&layout.body<=layout.width);pass("Actual Traditional Chinese task selection remains usable at390px without horizontal overflow");assert.equal(checks.length,5);
}catch(e){errors.push(stage+": "+String(e));}
finally{
 try{await stopRecording();}catch(e){errors.push("recording: "+String(e));}
 if(browser)try{await browser.close();browserClosed=true;}catch(e){errors.push("browser close: "+String(e));}
 if(system)try{await system.app.close();apiClosed=true;}catch(e){errors.push("API close: "+String(e));}
 if(isolated)try{await isolated.cleanup();fixtureClosed=true;}catch(e){errors.push("fixture close: "+String(e));}
 process.chdir(delivery);const status=errors.length===0&&checks.length===5&&browserClosed&&apiClosed&&fixtureClosed?"passed":"failed";
 await writeFile(prefix+"-journey.json",JSON.stringify({at:new Date().toISOString(),status,stage,checks,errors,screenshots,recordings,layouts,browser_closed:browserClosed,api_closed:apiClosed,fixture_closed:fixtureClosed,scope:"Actual Web OTP, private cloud conversation and SQL/HTTP. Synthetic business fixtures; no model execution. Backend covers real Worker with synthetic runtime and Extension controller over actual HTTP. Shared Desktop cloud renderer build only, no installed native Desktop/Side Panel acceptance. Frozen stage148 release unchanged."},null,2)+"\n",{flag:"wx"});console.log(JSON.stringify({status,checks:checks.length,errors}));assert.equal(status,"passed");
}
