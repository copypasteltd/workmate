import assert from 'node:assert/strict';
import {chromium,_electron,type Page,type CDPSession,type Browser,type BrowserContext,type ElectronApplication} from 'playwright';
import {readFile,writeFile,mkdir} from 'node:fs/promises';
import {randomUUID,createHash} from 'node:crypto';
import {pathToFileURL} from 'node:url';
import path from 'node:path';
import {WorkmateRecording,saveWorkmateScreenshot} from './record-workmate-media.js';
const attempt=process.argv[2];assert.match(attempt??'',/^\d{2}$/);
const delivery=process.cwd(),platform=path.resolve('../copypaste-platform'),extension=path.resolve('../copypaste-extension'),owned=process.env.COPYPASTE_BUSINESS_INPUTS_OWNED!,prefix=`evidence/document-preview-146/ui-${attempt}`;
const load=(file:string)=>import(pathToFileURL(path.join(platform,file)).href),checks:string[]=[],screenshots:any[]=[],recordings:any[]=[],layouts:any[]=[],errors:string[]=[],diagnostics:any[]=[];
let system:any,isolated:any,browser:Browser|undefined,electron:ElectronApplication|undefined,extensionContext:BrowserContext|undefined,panel:any,recording:WorkmateRecording|undefined,stage='setup',failure:string|null=null;
let browserClosed=false,desktopClosed=false,extensionClosed=false,apiClosed=false,fixtureClosed=false;
async function until(read:()=>Promise<any>,valid:(v:any)=>boolean,name:string,ms=60000){const end=Date.now()+ms;for(;;){const v=await read();if(valid(v))return v;assert.ok(Date.now()<end,name);await new Promise(r=>setTimeout(r,120));}}
const pass=(name:string)=>{checks.push(name);console.log('PASS: '+name);};
async function stopRecording(){if(recording){const r=recording;recording=undefined;recordings.push(await r.stop());}}
async function shot(client:string,page:Page,name:string){screenshots.push(await saveWorkmateScreenshot(client,`document-preview-146-${attempt}`,name,await page.screenshot(),'Actual document page rasterization, fixed source versions and current authorization; synthetic campaign content, no AI model calls',delivery));}
async function attachTarget(parent:CDPSession,targetId:string){const {sessionId}=await parent.send('Target.attachToTarget',{targetId,flatten:false});let sequence=0;const pending=new Map<number,any>();
  const receive=(event:any)=>{if(event.sessionId!==sessionId)return;const m=JSON.parse(event.message),p=pending.get(m.id);if(!p)return;clearTimeout(p.timer);pending.delete(m.id);m.error?p.reject(new Error(m.error.message)):p.resolve(m.result);};parent.on('Target.receivedMessageFromTarget',receive);
  return {send(method:string,params:any={}){return new Promise<any>((resolve,reject)=>{const id=++sequence;pending.set(id,{resolve,reject,timer:setTimeout(()=>{pending.delete(id);reject(new Error('CDP '+method+' timed out'));},30000)});void parent.send('Target.sendMessageToTarget',{sessionId,message:JSON.stringify({id,method,params})}).catch(reject);});},async close(){parent.removeListener('Target.receivedMessageFromTarget',receive);for(const p of pending.values()){clearTimeout(p.timer);p.reject(new Error('Owned target closed'));}pending.clear();await parent.send('Target.detachFromTarget',{sessionId}).catch(()=>{});}};
}
async function evaluate(expression:string){const r=await panel.send('Runtime.evaluate',{expression,returnByValue:true,userGesture:true,awaitPromise:true});assert.equal(r.exceptionDetails,undefined,JSON.stringify(r.exceptionDetails));return r.result.value;}
try{
  await mkdir(owned,{recursive:true});
  const [{isolatedTestEnvironment},{buildApp},{loadConfig},fixtures,{saveAsset},documents]=await Promise.all([load('tests/native-test-environment.ts'),load('src/server.ts'),load('src/config.ts'),load('tests/admin-history-fixture.ts'),load('src/storage.ts'),load('tests/document-fixtures-146-v2.ts')]);
  process.chdir(platform);isolated=await isolatedTestEnvironment();system=await buildApp(loadConfig({...isolated.env,NODE_ENV:'test',WORKER_ENABLED:'false',DEMO_MODE:'true',DEV_MAILBOX:'true',API_ORIGIN:'http://localhost:4310',WEB_ORIGIN:'http://localhost:4317',ADMIN_ORIGIN:'http://localhost:4318'}),{worker:false});
  system.app.addHook('onError',async(req:any,_reply:any,error:Error)=>diagnostics.push({url:req.url,error:error.stack}));await system.app.listen({host:'127.0.0.1',port:4310});
  const owner=await fixtures.historyLogin(system),workspace=await fixtures.historyOk(system,owner,'POST','/v1/tenants',{name:'CopyPaste marketing studio',project_name:'October launch'});owner.tenant=workspace.tenant.id;
  const tenant=workspace.tenant.id,project=workspace.project.id,base=`/v1/tenants/${tenant}/projects/${project}`;
  await fixtures.historyOk(system,owner,'POST',base+'/agents',{name:'Campaign designer',role_key:'designer',instructions:'Use pinned, customer-approved files.'});
  const save=async(name:string,bytes:Buffer,asset?:any)=>system.db.tx((tx:any)=>saveAsset(tx,system.storage,{tenant,project,user:owner.id,name,mime:name.endsWith('.pdf')?'application/pdf':'application/octet-stream',bytes,...(asset?{asset:asset.id,expectedVersion:asset.current_version}:{})}),tenant,false,owner.id);
  const pdfBytes=await documents.campaignPDF(),pdf=await save('Campaign brief.pdf',pdfBytes),workbook=await save('Campaign budget.xlsx',documents.campaignWorkbook());
  let versioned=await save('Older approved brief.pdf',pdfBytes);const first=versioned.version.id;
  for(let i=2;i<=54;i++)versioned=await save('Older approved brief.pdf',pdfBytes,versioned);
  const localPDF=path.join(owned,'customer-brief.pdf');await writeFile(localPDF,pdfBytes,{flag:'wx'});
  async function login(page:Page,url:string){await system.db.control.query("UPDATE auth_challenges SET created_at=clock_timestamp()-interval '2 minutes' WHERE email=$1",[owner.email]);await page.goto(url);await page.locator('input[name="email"]').fill(owner.email);
    const [response]=await Promise.all([page.waitForResponse(r=>new URL(r.url()).pathname==='/v1/auth/challenges'),page.locator('form button[type="submit"]').click()]);assert.equal(response.status(),202);const challenge=await response.json(),mail=JSON.parse(await readFile(path.join(isolated.directory,'mailbox',challenge.challenge_id+'.json'),'utf8'));
    await page.locator('input[name="code"]').fill(mail.text.match(/\b\d{6}\b/)[0]);await page.locator('form button[type="submit"]').click();}
  async function openFile(page:Page,name:string){await page.getByRole('textbox',{name:'Search cloud files',exact:true}).fill(name);const row=page.locator('.cloud-file-row').filter({has:page.getByRole('button',{name,exact:true})});await row.getByRole('button',{name:'Preview & reference',exact:true}).click();const modal=page.getByRole('dialog');await modal.locator('.cloud-document-page').waitFor({timeout:90000});await modal.getByText('Page 1 of 2',{exact:true}).waitFor();return modal;}
  async function turn(page:Page,modal:any,name:string,kind="document"){const before=await modal.locator('.cloud-document-page').getAttribute('src');await modal.getByRole('button',{name:'Next page',exact:true}).click();await modal.getByText('Page 2 of 2',{exact:true}).waitFor();await until(()=>modal.locator('.cloud-document-page').getAttribute('src').catch(()=>null),v=>!!v&&v!==before,'independent rendered second page');await modal.locator('summary').click();await modal.getByText('Measured campaign result',{exact:false}).last().waitFor();await shot(name,page,kind+'-page-two-en');}
  stage='Web actual document pagination and explicit older revision';
  browser=await chromium.launch({executablePath:process.env.CHROME_BIN,headless:true});const context=await browser.newContext({viewport:{width:1440,height:1000},acceptDownloads:true});
  await context.addInitScript(({tenant,project})=>{localStorage.setItem('cp_locale','en');localStorage.setItem('cp_theme','light');localStorage.setItem('cp_tenant',tenant);localStorage.setItem('cp_project',project);},{tenant,project});
  const web=await context.newPage();web.on('pageerror',(e:Error)=>errors.push(e.message));await login(web,'http://localhost:4317/login');await web.waitForURL('**/app**');await web.goto('http://localhost:4317/app/files');
  recording=new WorkmateRecording('web','document-pages',`document-preview-146-${attempt}`,()=>web.screenshot({type:'jpeg',quality:72}),'Actual PDF and Office page images, older-version search and pinned entry creation; synthetic customer files, no model requests',delivery);await recording.start();
  let modal=await openFile(web,'Campaign brief.pdf');await shot('web',web,'page-one-en');await turn(web,modal,'web','pdf');await modal.getByRole('button',{name:'Close',exact:true}).click();
  modal=await openFile(web,'Campaign budget.xlsx');await turn(web,modal,'web','xlsx');await modal.getByRole('button',{name:'Close',exact:true}).click();
  await web.getByRole('button',{name:'New entry',exact:true}).click();modal=web.getByRole('dialog');await modal.getByLabel('Name',{exact:true}).fill('Approved original reference');await modal.getByLabel('Entry type',{exact:true}).selectOption('file');
  await modal.getByLabel('Search source assets',{exact:true}).fill('Older approved');await modal.getByRole('button',{name:/Older approved brief.pdf/}).click();await modal.getByRole('button',{name:'Load earlier versions',exact:true}).click();await modal.getByLabel('Choose a pinned version',{exact:true}).selectOption(first);await shot('web',web,'explicit-earlier-version-en');
  await modal.getByRole('button',{name:'Save entry',exact:true}).click();await modal.waitFor({state:'hidden'});
  const pinned=(await system.db.control.query("SELECT asset_version_id FROM workspace_nodes WHERE project_id=$1 AND name='Approved original reference'",[project])).rows[0];assert.equal(pinned.asset_version_id,first);
  await web.getByRole('textbox',{name:'Search cloud files',exact:true}).fill('Approved original reference');modal=await openFile(web,'Approved original reference');assert.match((await modal.textContent())??"",/Pinned version: v1/);
  const download=web.waitForEvent('download');await modal.getByRole('button',{name:'Download this version',exact:true}).click();const downloaded=await download,file=path.join(owned,'downloaded-original.pdf');await downloaded.saveAs(file);assert.equal(createHash('sha256').update(await readFile(file)).digest('hex'),versioned.version.sha256);
  await modal.getByRole('button',{name:'Close',exact:true}).click();await stopRecording();pass('Web OTP, real PDF/XLSX page images and text, search, earlier-version pagination, explicit v1 entry and byte-exact original download');
  for(const width of[1440,960,390]){await web.setViewportSize({width,height:1000});const layout=await web.evaluate(()=>({width:innerWidth,no_horizontal_overflow:document.documentElement.scrollWidth<=innerWidth}));assert.ok(layout.no_horizontal_overflow);layouts.push({client:'web',...layout});}await web.setViewportSize({width:1440,height:1000});
  stage='Actual frameless Windows Desktop document preview';
  electron=await _electron.launch({executablePath:process.env.COPYPASTE_LOCAL_DESKTOP_CANDIDATE!,env:{...process.env,COPYPASTE_USER_DATA:path.join(owned,'desktop')}});const desktop=await electron.firstWindow();desktop.on('pageerror',(e:Error)=>errors.push(e.message));desktop.setDefaultTimeout(30000);await desktop.waitForURL(/^file:/);
  await desktop.evaluate(({tenant,project}:any)=>{localStorage.setItem('cp_locale','en');localStorage.setItem('cp_theme','light');localStorage.setItem('cp_tenant',tenant);localStorage.setItem('cp_project',project);},{tenant,project});await desktop.reload();
  await electron.evaluate(({shell}:any)=>{shell.openExternal=async(url:string)=>{(globalThis as any).__cp146Auth=url;};});await desktop.getByRole('button',{name:'Sign in securely in your browser',exact:true}).click();const authContext=await browser.newContext();await authContext.addInitScript(()=>localStorage.setItem('cp_locale','en'));const auth=await authContext.newPage();await login(auth,await until(()=>electron!.evaluate(()=>(globalThis as any).__cp146Auth),Boolean,'native PKCE URL'));await auth.getByRole('link',{name:/Authorize & return|授權並返回應用/}).click();await desktop.locator('.app-shell').waitFor();await authContext.close();await desktop.evaluate(()=>{location.hash='/app/files';});
  await electron.evaluate(({BrowserWindow}:any)=>BrowserWindow.getAllWindows()[0].setSize(1360,960));
  recording=new WorkmateRecording('desktop','document-pages',`document-preview-146-${attempt}`,()=>desktop.screenshot({type:'jpeg',quality:72}),'Actual unsigned frameless Windows package, native PKCE and shared cloud document pages; local Codex execution is unchanged and not exercised by this preview journey',delivery);await recording.start();
  modal=await openFile(desktop,'Campaign budget.xlsx');await shot('desktop',desktop,'office-page-one-en');await turn(desktop,modal,'desktop');
  for(const width of[1360,1000]){await electron.evaluate(({BrowserWindow}:any,width:number)=>BrowserWindow.getAllWindows()[0].setSize(width,960),width);const layout=await desktop.evaluate(()=>({width:innerWidth,no_horizontal_overflow:document.documentElement.scrollWidth<=innerWidth,rails_hidden:[...document.querySelectorAll('.sidebar,.main-content')].every(n=>getComputedStyle(n).scrollbarWidth==='none')}));assert.ok(layout.no_horizontal_overflow);assert.ok(layout.rails_hidden);layouts.push({client:'desktop',...layout});}
  assert.equal(await electron.evaluate(({BrowserWindow}:any)=>BrowserWindow.getAllWindows()[0].isMenuBarVisible()),false);
  await system.db.control.query("UPDATE assets SET state='quarantined' WHERE id=$1",[workbook.id]);await until(()=>modal.locator('.cloud-document-page').count(),v=>v===0,'withdrawn source clears open Desktop page',15000);await shot('desktop',desktop,'withdrawn-source-cleared-en');await stopRecording();pass('Actual frameless Windows package authenticates with PKCE, previews real XLSX pages, clears withdrawn source and hides menus/scroll tracks without horizontal overflow');await electron.close();electron=undefined;desktopClosed=true;
  stage='Actual Chrome native right Side Panel local attachment preview';
  const id=(await readFile(path.join(extension,'extension-id.txt'),'utf8')).trim();extensionContext=await chromium.launchPersistentContext(path.join(owned,'chrome'),{executablePath:process.env.CHROME_BIN,headless:false,viewport:null,args:['--disable-gpu','--window-size=1480,1080','--enable-unsafe-extension-debugging','--disable-extensions-except='+path.join(extension,'dist'),'--load-extension='+path.join(extension,'dist')]});
  const worker=extensionContext.serviceWorkers()[0]??await extensionContext.waitForEvent('serviceworker');await worker.evaluate(()=>chrome.storage.local.set({locale:'en'}));const main=extensionContext.pages()[0];await main.goto('http://localhost:4317/');const width=await main.evaluate(()=>innerWidth),tabs=extensionContext.pages().length,cdp=await extensionContext.browser()!.newBrowserCDPSession();
  const tab=(await cdp.send('Target.getTargets',{filter:[{}]})).targetInfos.find((t:any)=>t.type==='tab'&&t.url.startsWith('http://localhost:4317'));assert.ok(tab);await until(()=>worker.evaluate(()=>chrome.sidePanel.getPanelBehavior()),v=>v.openPanelOnActionClick,'toolbar binding');await cdp.send('Extensions.triggerAction',{id,targetId:tab.targetId});const native=await until(()=>worker.evaluate(()=>chrome.runtime.getContexts({contextTypes:['SIDE_PANEL']})),v=>v.length===1,'native side panel');assert.equal((await worker.evaluate(()=>chrome.sidePanel.getLayout())).side,'right');await until(()=>main.evaluate(()=>innerWidth),v=>v<width-250,'right panel viewport');assert.equal(extensionContext.pages().length,tabs);
  const expectedPanel='chrome-extension://'+id+'/'+JSON.parse(await readFile(path.join(extension,'dist/manifest.json'),'utf8')).side_panel.default_path;
  const target=await until(async()=>{const contexts=await worker.evaluate(()=>chrome.runtime.getContexts({contextTypes:['SIDE_PANEL']}));
    const targets=(await cdp.send('Target.getTargets',{filter:[{}]})).targetInfos;
    return targets.find((t:any)=>t.url===expectedPanel||contexts.some(c=>!!c.documentUrl&&c.documentUrl===t.url));
  },Boolean,'actual native Side Panel CDP document after navigation');panel=await attachTarget(cdp,target.targetId);await until(()=>evaluate("document.querySelector('#sign-in')&&!document.querySelector('#sign-in').disabled"),Boolean,'native sign-in');
  const popupEvent=extensionContext.waitForEvent('page');await evaluate("document.querySelector('#sign-in').click()");const popup=await popupEvent;await login(popup,popup.url());await popup.getByRole('link',{name:/Authorize & return|授權並返回應用/}).click();await until(()=>evaluate("!document.querySelector('#workspace').hidden"),Boolean,'native authenticated');
  await evaluate(`document.querySelector('#project').value=${JSON.stringify(project)};document.querySelector('#project').dispatchEvent(new Event('change',{bubbles:true}));`);await until(()=>evaluate("!document.querySelector('#chat-file').disabled"),Boolean,'private chat attachments ready');
  recording=new WorkmateRecording('extension','attachment-pages',`document-preview-146-${attempt}`,async()=>Buffer.from((await panel.send('Page.captureScreenshot',{format:'jpeg',quality:72,captureBeyondViewport:false})).data,'base64'),'Actual native right SIDE_PANEL, customer-selected local PDF upload to private cloud chat, real page turns and permission withdrawal; attachment remains unsent',delivery);await recording.start();
  const dom=await panel.send('DOM.getDocument'),input=await panel.send('DOM.querySelector',{nodeId:dom.root.nodeId,selector:'#chat-file'});await panel.send('DOM.setFileInputFiles',{nodeId:input.nodeId,files:[localPDF]});await until(()=>evaluate("[...document.querySelectorAll('#chat-attachments button')].some(b=>b.textContent==='Preview attachment')"),Boolean,'private upload ready',90000);
  await evaluate("[...document.querySelectorAll('#chat-attachments button')].find(b=>b.textContent==='Preview attachment').click()");await until(()=>evaluate("document.querySelector('.document-preview-dialog img')?.getAttribute('src')"),Boolean,'native first page image');screenshots.push(await saveWorkmateScreenshot('extension',`document-preview-146-${attempt}`,'attachment-page-one-en',Buffer.from((await panel.send('Page.captureScreenshot',{format:'png'})).data,'base64'),'Actual native right SIDE_PANEL with private uploaded PDF; not a replacement extension tab',delivery));
  await evaluate("[...document.querySelectorAll('.document-preview-dialog button')].find(b=>b.textContent==='Next').click()");await until(()=>evaluate("document.querySelector('.document-preview-navigation span')?.textContent"),v=>v==='Page 2 of 2','native second page');await until(()=>evaluate("document.querySelector('.document-preview-dialog img')?.getAttribute('src')"),Boolean,'native second page image');
  const uploaded=(await system.db.control.query("SELECT id,private_owner FROM assets WHERE project_id=$1 AND name='customer-brief.pdf'",[project])).rows;assert.equal(uploaded.length,1);assert.equal(uploaded[0].private_owner,owner.id);assert.match(await evaluate("document.querySelector('#chat-attachments').textContent"),/Uploaded, not sent/);
  assert.equal((await system.db.control.query('SELECT count(*)::int AS n FROM tasks WHERE tenant_id=$1',[tenant])).rows[0].n,0);
  await system.db.control.query("UPDATE assets SET state='quarantined' WHERE id=$1",[uploaded[0].id]);await until(()=>evaluate("document.querySelector('.document-preview-dialog img')?.getAttribute('src')"),v=>!v,'withdrawn attachment clears current page',15000);screenshots.push(await saveWorkmateScreenshot('extension',`document-preview-146-${attempt}`,'withdrawn-attachment-cleared-en',Buffer.from((await panel.send('Page.captureScreenshot',{format:'png'})).data,'base64'),'Actual current permission withdrawal clears attachment content inside native Side Panel',delivery));
  const layout=await evaluate('({width:innerWidth,no_horizontal_overflow:document.documentElement.scrollWidth<=innerWidth})');assert.ok(layout.no_horizontal_overflow);layouts.push({client:'extension_side_panel',...layout});assert.equal((await worker.evaluate(()=>chrome.runtime.getContexts({contextTypes:['SIDE_PANEL']}))).length,1);await stopRecording();pass('Actual toolbar native right SIDE_PANEL, PKCE, selected local PDF upload, independent page turns, private unsent attachment and immediate withdrawal clearing; no replacement tab');
  await panel.close();panel=undefined;await cdp.detach();await extensionContext.close();extensionContext=undefined;extensionClosed=true;
  assert.equal((await system.db.control.query('SELECT count(*)::int AS n FROM current_ai_provider_requests WHERE tenant_id=$1',[tenant])).rows[0].n,0);pass('All preview and selection interactions preserve original version bytes and create no AI provider request or task');
}catch(e){failure=String(e);diagnostics.push({stage,stack:(e as Error).stack});}
finally{try{await stopRecording();}catch(e){failure??=String(e);}if(panel)await panel.close().catch(()=>{});if(electron)try{await electron.close();desktopClosed=true;}catch(e){failure??=String(e);}if(extensionContext)try{await extensionContext.close();extensionClosed=true;}catch(e){failure??=String(e);}if(browser)try{await browser.close();browserClosed=true;}catch(e){failure??=String(e);}if(system)try{await system.app.close();apiClosed=true;}catch(e){failure??=String(e);}if(isolated)try{await isolated.cleanup();fixtureClosed=true;}catch(e){failure??=String(e);}process.chdir(delivery);}
const passed=!failure&&!errors.length&&checks.length===4&&screenshots.length===9&&recordings.length===3&&layouts.length===6&&recordings.every(r=>r.distinct_frames>1&&r.skipped_capture_errors===0)&&browserClosed&&desktopClosed&&extensionClosed&&apiClosed&&fixtureClosed;
const report={at:new Date().toISOString(),status:passed?'passed':'failed',stage,failure,checks,screenshots,recordings,layouts,errors,diagnostics,browser_closed:browserClosed,desktop_closed:desktopClosed,extension_closed:extensionClosed,api_closed:apiClosed,fixture_closed:fixtureClosed,model_mode:'No model calls; actual native PostgreSQL, PDF.js/LibreOffice page rendering, OTP/PKCE, unsigned frameless Windows package, native Chrome right Side Panel and authorized local upload. This does not exercise customer-local Codex/OS actions or production services.'};
await writeFile(prefix+'-journey.json',JSON.stringify(report,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({status:report.status,checks:checks.length,stage,failure}));process.exitCode=passed?0:1;
