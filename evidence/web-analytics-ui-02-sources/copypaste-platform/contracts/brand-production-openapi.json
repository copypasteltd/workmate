{
  "openapi": "3.1.0",
  "info": {
    "title": "CopyPaste versioned brand production addendum",
    "version": "1.0.0",
    "description": "Additive running operations. Check is a read-only preflight; production rechecks at render and before saving. Historical output availability is not tied to current promotion expiry. Not a replacement for the original full product contract."
  },
  "paths": {
    "/v1/tenants/{tenant}/projects/{project}/brand/definitions": {
      "post": {
        "operationId": "createBrandDefinition",
        "parameters": [
          {
            "name": "tenant",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "project",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 16,
              "maxLength": 128
            }
          }
        ],
        "security": [
          {
            "userSession": []
          },
          {
            "nativeBearer": []
          }
        ],
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BrandPublication"
                }
              }
            }
          },
          "default": {
            "description": "Scoped authentication, version, source, glyph or validity error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BrandDefinition"
              }
            }
          }
        }
      }
    },
    "/v1/tenants/{tenant}/projects/{project}/brand/{id}": {
      "put": {
        "operationId": "publishBrandVersion",
        "parameters": [
          {
            "name": "tenant",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "project",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 16,
              "maxLength": 128
            }
          }
        ],
        "security": [
          {
            "userSession": []
          },
          {
            "nativeBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BrandPublication"
                }
              }
            }
          },
          "default": {
            "description": "Scoped authentication, version, source, glyph or validity error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BrandPublish"
              }
            }
          }
        }
      }
    },
    "/v1/tenants/{tenant}/projects/{project}/brand/{id}/versions": {
      "get": {
        "operationId": "listBrandVersions",
        "parameters": [
          {
            "name": "tenant",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "project",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "security": [
          {
            "userSession": []
          },
          {
            "nativeBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BrandVersionList"
                }
              }
            }
          },
          "default": {
            "description": "Scoped authentication, version, source, glyph or validity error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/tenants/{tenant}/projects/{project}/brand/{id}/versions/{version}/check": {
      "post": {
        "operationId": "checkBrandProduction",
        "parameters": [
          {
            "name": "tenant",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "project",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "version",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "security": [
          {
            "userSession": []
          },
          {
            "nativeBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BrandCheck"
                }
              }
            }
          },
          "default": {
            "description": "Scoped authentication, version, source, glyph or validity error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BrandCheckInput"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "userSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "cp_session",
        "description": "Browser writes require the current CSRF token and an allowed origin."
      },
      "nativeBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "An authorized native client token; never an Admin session."
      }
    },
    "schemas": {
      "BrandDefinition": {
        "type": "object",
        "properties": {
          "schema_version": {
            "type": "number",
            "const": 2
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "colors": {
            "minItems": 1,
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^#[a-fA-F\\d]{6}$"
            }
          },
          "tone": {
            "type": "string",
            "maxLength": 2000
          },
          "approved_copy": {
            "default": "",
            "type": "string",
            "maxLength": 10000
          },
          "fonts": {
            "default": [],
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 100
            }
          },
          "logos": {
            "default": [],
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "asset_id": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                "version": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "key": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,59}$"
                },
                "usage": {
                  "type": "string",
                  "maxLength": 500
                },
                "min_width": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4096
                },
                "clear_space": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4096
                }
              },
              "required": [
                "asset_id",
                "version",
                "key",
                "usage",
                "min_width",
                "clear_space"
              ],
              "additionalProperties": false
            }
          },
          "font_bindings": {
            "minItems": 1,
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,59}$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "source": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "builtin": {
                          "type": "string",
                          "const": "noto-sans-tc"
                        }
                      },
                      "required": [
                        "builtin"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "asset_id": {
                          "type": "string",
                          "format": "uuid",
                          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                        },
                        "version": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": [
                        "asset_id",
                        "version"
                      ],
                      "additionalProperties": false
                    }
                  ]
                },
                "rights": {
                  "type": "object",
                  "properties": {
                    "source": {
                      "type": "string",
                      "minLength": 3,
                      "maxLength": 2000
                    },
                    "license": {
                      "type": "string",
                      "minLength": 3,
                      "maxLength": 4000
                    },
                    "channels": {
                      "minItems": 1,
                      "maxItems": 30,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,59}$"
                      }
                    },
                    "valid_until": {
                      "default": null,
                      "anyOf": [
                        {
                          "type": "string",
                          "format": "date-time",
                          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "source",
                    "license",
                    "channels"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "key",
                "label",
                "source",
                "rights"
              ],
              "additionalProperties": false
            }
          },
          "facts": {
            "default": [],
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,59}$"
                },
                "sku": {
                  "default": "",
                  "type": "string",
                  "maxLength": 120
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "product",
                    "price",
                    "promotion"
                  ]
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "amount_minor": {
                  "default": null,
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000000000000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "currency": {
                  "default": null,
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[A-Z]{3}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "valid_from": {
                  "default": null,
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "valid_until": {
                  "default": null,
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "key",
                "kind",
                "text"
              ],
              "additionalProperties": false
            }
          },
          "locales": {
            "minItems": 1,
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,59}$"
            }
          },
          "channels": {
            "minItems": 1,
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,59}$"
            }
          },
          "restrictions": {
            "default": "",
            "type": "string",
            "maxLength": 5000
          }
        },
        "required": [
          "schema_version",
          "name",
          "colors",
          "tone",
          "font_bindings",
          "locales",
          "channels"
        ],
        "additionalProperties": false,
        "description": "Immutable production guidance. Server checks unique keys, supported locales/currencies, matching amount/currency, promotion expiry, ordered validity, font channel subsets, active shared file versions and actual font bytes. Font rights are customer declarations. Existing legacy POST /brand is preserved separately."
      },
      "BrandBinding": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "version": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "channel": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,59}$"
          },
          "locale": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,59}$"
          }
        },
        "required": [
          "id",
          "version",
          "channel",
          "locale"
        ],
        "additionalProperties": false
      },
      "BrandPublish": {
        "type": "object",
        "properties": {
          "expected_version": {
            "type": "integer",
            "minimum": 1
          },
          "definition": {
            "$ref": "#/components/schemas/BrandDefinition"
          }
        },
        "required": [
          "expected_version",
          "definition"
        ],
        "additionalProperties": false
      },
      "BrandPublication": {
        "type": "object",
        "required": [
          "id",
          "tenant_id",
          "project_id",
          "name",
          "body",
          "version",
          "created_at",
          "content_state",
          "moderation_version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "tenant_id": {
            "type": "string",
            "format": "uuid"
          },
          "project_id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "body": {
            "$ref": "#/components/schemas/BrandDefinition"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "content_state": {
            "const": "active"
          },
          "moderation_version": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": true
      },
      "BrandVersion": {
        "type": "object",
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string"
          },
          "body": {
            "type": "object",
            "description": "Exact stored guidance. Legacy versions retain their original shape; no rights are invented."
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "created_by": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "version",
          "name",
          "body",
          "sha256",
          "created_at",
          "created_by"
        ],
        "additionalProperties": false
      },
      "BrandCheckInput": {
        "type": "object",
        "properties": {
          "channel": {
            "type": "string",
            "maxLength": 60
          },
          "locale": {
            "type": "string",
            "maxLength": 60
          },
          "text": {
            "type": "string",
            "maxLength": 5000
          },
          "font_key": {
            "type": "string",
            "maxLength": 60
          },
          "fact_key": {
            "type": "string",
            "maxLength": 60
          }
        },
        "required": [
          "channel",
          "locale",
          "text"
        ],
        "additionalProperties": false
      },
      "BrandCheck": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "text": {
            "type": "string"
          },
          "glyphs": {
            "const": "covered"
          },
          "rights_status": {
            "const": "customer_declared"
          }
        },
        "required": [
          "id",
          "version",
          "sha256",
          "text",
          "glyphs",
          "rights_status"
        ],
        "additionalProperties": false
      },
      "BrandVersionList": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/BrandVersion"
            }
          }
        },
        "required": [
          "items"
        ],
        "additionalProperties": false
      },
      "Problem": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {},
              "request_id": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message",
              "request_id"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      }
    }
  }
}
