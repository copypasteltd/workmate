          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MappingCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Currently authorized project result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MappingReceipt"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or missing idempotency key"
          },
          "403": {
            "description": "Current role cannot mutate"
          },
          "404": {
            "description": "Scope or retained source unavailable"
          },
          "409": {
            "description": "Stale version, conflicting allocation/facts, correction overlap or idempotency conflict"
          },
          "422": {
            "description": "Source grain or selected measurement period invalid"
