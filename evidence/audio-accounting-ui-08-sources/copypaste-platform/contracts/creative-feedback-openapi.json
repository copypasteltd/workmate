{
  "openapi": "3.1.0",
  "info": {
    "title": "Workmate confirmed creative feedback",
    "version": "1.0.0",
    "description": "User-confirmed, immutable ad-level identity allocation. No automatic provider identity verification, causal uplift or cross-scope total. Report bodies/options remain documented JSON structures; strict mutation/receipt/mapping-list schemas below are executable contracts, not full original design acceptance."
  },
  "paths": {
    "/v1/tenants/{tenant}/projects/{project}/creative-feedback/mappings": {
      "get": {
        "operationId": "listCreativeMappings",
        "security": [
          {
            "customerSession": []
          }
        ],
        "parameters": [
          {
            "name": "tenant",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "project",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 40
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Currently authorized project result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MappingList"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or missing idempotency key"
          },
          "403": {
            "description": "Current role cannot mutate"
          },
          "404": {
            "description": "Scope or retained source unavailable"
          },
          "409": {
            "description": "Stale version, conflicting allocation/facts, correction overlap or idempotency conflict"
          },
          "422": {
            "description": "Source grain or selected measurement period invalid"
          }
        }
      },
      "post": {
        "operationId": "createCreativeMapping",
        "security": [
          {
            "customerSession": []
          }
        ],
        "parameters": [
          {
            "name": "tenant",
