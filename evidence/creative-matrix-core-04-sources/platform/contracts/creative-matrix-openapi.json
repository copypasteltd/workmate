  "components": {
    "securitySchemes": {
      "customerSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "cp_session"
      }
    },
    "schemas": {
      "MatrixCreate": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "locales": {
            "minItems": 1,
            "maxItems": 2,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "zh-HK",
                "en"
              ]
            }
          },
          "sizes": {
            "minItems": 1,
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9_-]{0,39}$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "width": {
                  "type": "integer",
                  "minimum": 256,
                  "maximum": 2048
                },
                "height": {
                  "type": "integer",
                  "minimum": 256,
                  "maximum": 2048
                }
              },
              "required": [
                "key",
                "name",
                "width",
                "height"
              ],
              "additionalProperties": false
            }
          },
          "creatives": {
            "minItems": 1,
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9_-]{0,39}$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "theme": {
                  "type": "object",
                  "properties": {
                    "background": {
                      "type": "string",
                      "pattern": "^#[a-f\\d]{6}$"
                    },
                    "ink": {
                      "type": "string",
                      "pattern": "^#[a-f\\d]{6}$"
                    },
                    "accent": {
                      "type": "string",
                      "pattern": "^#[a-f\\d]{6}$"
                    }
                  },
                  "required": [
                    "background",
                    "ink",
                    "accent"
                  ],
                  "additionalProperties": false
                },
                "image": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "asset_id": {
                          "type": "string",
                          "format": "uuid",
                          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                        },
                        "version": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": [
                        "asset_id",
                        "version"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "copy": {
                  "minItems": 1,
                  "maxItems": 2,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "locale": {
                        "type": "string",
                        "enum": [
                          "zh-HK",
                          "en"
                        ]
                      },
                      "text": {
                        "type": "object",
                        "properties": {
                          "brand_line": {
                            "type": "string",
                            "maxLength": 80
                          },
                          "headline": {
                            "type": "string",
                            "maxLength": 240
                          },
                          "body": {
                            "type": "string",
                            "maxLength": 800
                          },
                          "action": {
                            "type": "string",
                            "maxLength": 100
                          }
                        },
                        "required": [
                          "brand_line",
                          "headline",
                          "body",
                          "action"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "locale",
                      "text"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "key",
                "name",
                "theme",
                "image",
                "copy"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "name",
          "locales",
          "sizes",
          "creatives"
        ],
        "additionalProperties": false,
        "description": "Runtime additionally rejects duplicate creative/size/language axes, requires exactly one copy per selected language, and enforces creatives × languages × sizes <= 60 before persistence. No AI translation or generation is performed."
      },
