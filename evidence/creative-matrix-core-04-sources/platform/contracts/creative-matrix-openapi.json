                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "version": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "asset_id",
                  "version"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "theme": {
            "type": "object",
            "properties": {
              "background": {
                "type": "string",
                "pattern": "^#[a-f\\d]{6}$"
              },
              "ink": {
                "type": "string",
                "pattern": "^#[a-f\\d]{6}$"
              },
              "accent": {
                "type": "string",
                "pattern": "^#[a-f\\d]{6}$"
              }
            },
            "required": [
              "background",
              "ink",
              "accent"
            ],
            "additionalProperties": false
          }
        },
        "required": [
