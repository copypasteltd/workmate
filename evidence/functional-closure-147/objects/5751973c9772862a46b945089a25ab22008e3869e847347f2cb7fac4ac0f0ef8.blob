import assert from 'node:assert/strict';
import {spawn,execFileSync} from 'node:child_process';
import {readFile,writeFile,mkdir} from 'node:fs/promises';
import {createWriteStream} from 'node:fs';
import {createHash,randomUUID} from 'node:crypto';
import {createServer,createConnection} from 'node:net';
import path from 'node:path';
const [attempt,backendAttempt,buildAttempt,reuseAttempt]=process.argv.slice(2);if(reuseAttempt){assert.match(reuseAttempt,/^\d{2}$/);assert.notEqual(reuseAttempt,attempt);}for(const v of[attempt,backendAttempt,buildAttempt])assert.match(v??'',/^\d{2}$/);
const delivery=process.cwd(),platform=path.resolve('../copypaste-platform'),desktop=path.resolve('../copypaste-desktop'),web=path.resolve('../copypaste-web'),extension=path.resolve('../copypaste-extension'),base='evidence/functional-closure-147',prefix=base+'/ui-'+attempt,sha=b=>createHash('sha256').update(b).digest('hex');
await mkdir(base+'/objects',{recursive:true});for(const suffix of['.json','.tap','-sources.json','-verifier.mjs','-journey.json'])await assert.rejects(readFile(prefix+suffix),e=>e.code==='ENOENT');
async function snapshot(archive){const files={};for(const[name,repo]of[['platform',platform],['web',web],['desktop',desktop],['extension',extension]]){
 const names=execFileSync('git',['-C',repo,'ls-files','--cached','--others','--exclude-standard','-z','--','src','renderer/src','renderer/tsconfig.json','tests','scripts','migrations','catalog','contracts','skills','assets/fonts','public','package.json','package-lock.json','tsconfig.json','vite.config.ts'],{encoding:'utf8',windowsHide:true,maxBuffer:16000000}).split('\0').filter(Boolean);
 for(const namePath of[...new Set(names)].sort()){const bytes=await readFile(path.join(repo,namePath)),digest=sha(bytes),object=base+'/objects/'+digest+'.blob';if(archive){try{await writeFile(object,bytes,{flag:'wx'});}catch(e){if(e.code!=='EEXIST')throw e;assert.deepEqual(await readFile(object),bytes);}}files['copypaste-'+name+'/'+namePath]={sha256:digest,...(archive?{path:object}:{})};}}
 for(const file of['scripts/qualify-functional-closure-ui-147-v7.mjs','scripts/qa-functional-closure-147-v7.ts','scripts/record-workmate-media.ts']){const bytes=await readFile(file),digest=sha(bytes),object=base+'/objects/'+digest+'.blob';if(archive){try{await writeFile(object,bytes,{flag:'wx'});}catch(e){if(e.code!=='EEXIST')throw e;assert.deepEqual(await readFile(object),bytes);}}files['copypaste-delivery/'+file]={sha256:digest,...(archive?{path:object}:{})};}return files;}
const before=await snapshot(true);await writeFile(prefix+'-sources.json',JSON.stringify(before,null,2)+'\n',{flag:'wx'});await writeFile(prefix+'-verifier.mjs',await readFile(import.meta.filename),{flag:'wx'});
const backendSource=base+'/backend-'+backendAttempt+'-sources.json',backendSources=JSON.parse(await readFile(backendSource));for(const[name,v]of Object.entries(backendSources))if(name.startsWith('copypaste-platform/'))assert.equal(before[name]?.sha256,v.sha256,'Same backend source as the independent backend qualification');
const buildFile=base+'/build-'+buildAttempt+'.json',build=JSON.parse(await readFile(buildFile));assert.equal(build.status,'passed');assert.equal(build.source_unchanged,true);const buildSources=JSON.parse(await readFile(build.source_manifest.path));for(const[name,v]of Object.entries(buildSources))assert.equal(before[name]?.sha256,v.sha256,'Same client sources as actual packaged build');
const packageRoot=build.package_root;for(const[name,v]of Object.entries(build.package_files))assert.equal(sha(await readFile(path.join(packageRoot,name))),v);
process.loadEnvFile(path.join(platform,'.env'));const port=await new Promise(resolve=>{const s=createServer();s.listen(0,'127.0.0.1',()=>{const p=s.address().port;s.close(()=>resolve(p));});}),owned=path.resolve('.data/functional-closure-147','ui-'+randomUUID()),run=path.join(platform,'.data/test-fixture-reclamation',randomUUID()),token=randomUUID(),nativeFreshDirectory='.data/native-qa/'+randomUUID();
let reusedDatabase=null;
if(reuseAttempt){
 const file=base+'/ui-'+reuseAttempt+'.json',bytes=await readFile(file),old=JSON.parse(bytes);assert.equal(old.source_unchanged,true);assert.equal(old.owned_database_shutdown,true);assert.ok(Object.values(old.ports_closed).every(Boolean));assert.equal(old.fixture_cleanup.status,'passed');assert.equal(old.fixture_cleanup.exit_code,0);
 assert.match(old.owned_native_directory,/^\.data[\\/]native-qa[\\/][a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$/);await readFile(path.join(platform,old.owned_native_directory,'PG_VERSION'));await assert.rejects(readFile(path.join(platform,old.owned_native_directory,'postmaster.pid')),e=>e.code==='ENOENT');
 reusedDatabase={source:file,sha256:sha(bytes),directory:old.owned_native_directory,scope:'Only this task disposable native cluster, after complete fixture reclamation and confirmed graceful shutdown; fresh isolated database, complete current migrations, fsync and all original customer outcome assertions remain enabled.'};
}
const nativeDirectory=reusedDatabase?.directory??nativeFreshDirectory;
await mkdir(owned,{recursive:true});await mkdir(run,{recursive:true});await writeFile(path.join(run,'manifest.json'),JSON.stringify({owner_pid:process.pid,token}),{flag:'wx'});
const env={...process.env,COPYPASTE_NATIVE_DATABASE_DIR:nativeDirectory,COPYPASTE_NATIVE_DATABASE_START_ONLY:'true',COPYPASTE_TEST_RECLAMATION_DIR:run,COPYPASTE_TEST_RECLAMATION_TOKEN:token,COPYPASTE_BUSINESS_INPUTS_OWNED:owned,COPYPASTE_LOCAL_CODEX_BIN:path.join(desktop,'.data/runtime/windows-x64/codex.exe'),CHROME_BIN:path.resolve('.data/browsers/chromium-1248/chrome-win64/chrome.exe')};
for(const name of['OWNER_DATABASE_URL','DATABASE_URL','CONTROL_DATABASE_URL','QUEUE_DATABASE_URL']){const url=new URL(env[name]);assert.ok(['127.0.0.1','localhost','::1'].includes(url.hostname));url.port=String(port);env[name]=url.href;}
const log=createWriteStream(prefix+'.tap',{flags:'wx'}),commands=[],previews=[];let database,shutdown=null,error=null,resultCode=null,journey=null,cleanup=null;
function launch(args,cwd=platform,extra={},ipc=false){const child=spawn(process.execPath,args,{cwd,env:{...env,...extra},windowsHide:true,stdio:['ignore','pipe','pipe',...(ipc?['ipc']:[])]});let output='';child.stdout.on('data',b=>{output=(output+b).slice(-16000);});child.stdout.pipe(log,{end:false});child.stderr.pipe(log,{end:false});const closed=new Promise(resolve=>{child.once('error',()=>resolve(1));child.once('close',c=>resolve(c??1));});return{child,closed,output:()=>output};}
const occupied=p=>new Promise(resolve=>{const s=createConnection({host:'127.0.0.1',port:p});s.once('connect',()=>{s.destroy();resolve(true);});s.once('error',e=>{s.destroy();resolve(e.code!=='ECONNREFUSED');});});
async function ready(child,probe,ms){const end=Date.now()+ms;while(!await probe()){assert.equal(child.child.exitCode,null,child.output());assert.ok(Date.now()<end,'Owned service readiness');await new Promise(r=>setTimeout(r,200));}}
try{
 for(const p of[port,4310,4317])assert.equal(await occupied(p),false,'Preserve existing services');
 const compile=await launch(['node_modules/typescript/bin/tsc','--noEmit'],delivery).closed;commands.push({name:'typed interaction qualification',exit_code:compile});assert.equal(compile,0);
 database=launch(['scripts/native-db-launch.mjs'],platform,{},true);await ready(database,()=>Promise.resolve(database.output().includes('Native PostgreSQL ready')),600000);
 const preview=launch(['node_modules/vite/bin/vite.js','preview','--host','127.0.0.1','--port','4317','--strictPort'],web);previews.push(preview);await ready(preview,()=>occupied(4317),30000);
 resultCode=await launch(['--import','tsx','scripts/qa-functional-closure-147-v7.ts',attempt],delivery,{COPYPASTE_LOCAL_DESKTOP_CANDIDATE:path.join(packageRoot,'CopyPaste.exe')}).closed;journey=JSON.parse(await readFile(prefix+'-journey.json'));
}catch(e){error=String(e);}finally{
 for(const p of previews){if(p.child.exitCode===null)p.child.kill();await p.closed;}
 const code=await launch(['--import','tsx','scripts/reclaim-test-fixtures.ts'],platform).closed;try{const bytes=await readFile(path.join(run,'result.json'));await writeFile(prefix+'-fixture-cleanup.json',bytes,{flag:'wx'});cleanup={exit_code:code,...JSON.parse(bytes)};}catch(e){error??=String(e);}
 if(database?.child.connected&&database.child.exitCode===null)database.child.send({action:'shutdown'});if(database)shutdown=await database.closed;await new Promise(r=>log.end(r));
}
const after=await snapshot(false),unchanged=Object.keys(before).length===Object.keys(after).length&&Object.entries(before).every(([name,v])=>v.sha256===after[name]?.sha256),portsClosed={};for(const p of[port,4310,4317])portsClosed[p]=!await occupied(p);
let packageUnchanged=true;for(const[name,v]of Object.entries(build.package_files))if(sha(await readFile(path.join(packageRoot,name)))!==v)packageUnchanged=false;
const passed=!error&&resultCode===0&&shutdown===0&&unchanged&&packageUnchanged&&Object.values(portsClosed).every(Boolean)&&cleanup?.status==='passed'&&cleanup?.exit_code===0&&journey?.status==='passed'&&journey.browser_closed&&journey.desktop_closed&&journey.extension_closed&&journey.api_closed&&journey.fixture_closed&&journey.provider_closed;
const report={at:new Date().toISOString(),status:passed?'passed':'failed',error,commands,result_exit_code:resultCode,source_unchanged:unchanged,source_manifest:{path:prefix+'-sources.json',sha256:sha(await readFile(prefix+'-sources.json'))},raw_report:{path:prefix+'.tap',sha256:sha(await readFile(prefix+'.tap'))},verifier:{path:prefix+'-verifier.mjs',sha256:sha(await readFile(import.meta.filename))},
 backend_sources:{path:backendSource,sha256:sha(await readFile(backendSource)),scope:'Independent backend qualification uses identical backend sources; its result must pass separately for publication.'},client_build:{path:buildFile,sha256:sha(await readFile(buildFile))},package_files:build.package_files,package_root:packageRoot,package_unchanged:packageUnchanged,reused_owned_database:reusedDatabase,owned_native_directory:nativeDirectory,owned_native_port:port,owned_database_shutdown:shutdown===0,ports_closed:portsClosed,fixture_cleanup:cleanup,
 journey:journey?{path:prefix+'-journey.json',sha256:sha(await readFile(prefix+'-journey.json')),checks:journey.checks}:null,scope:'Actual original paid cloud Codex -> real local packaged Codex -> explicit selected file upload -> same cloud thread; fixed typed workflow review/full output; actual native right Side Panel. Explicit synthetic internal model responses and controlled native consent. Not production service acceptance.'};
await writeFile(prefix+'.json',JSON.stringify(report,null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({status:report.status,report:prefix+'.json',error}));assert.equal(report.status,'passed','Preserve original sources, raw failures and verifier');
