.cloud-document-page{display:block;max-width:100%;width:auto;max-height:65vh;height:auto;object-fit:contain;margin:16px auto;background:#fff;border:1px solid var(--line)}
.cloud-document-navigation{display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:10px;margin:12px 0;font-variant-numeric:tabular-nums}
.cloud-document-navigation form{display:flex;align-items:center;gap:6px}.cloud-document-navigation input{width:5em;min-width:0}
.cloud-document-loading{display:grid;min-height:240px;place-items:center}.cloud-document-text{margin:16px 0}.cloud-document-text pre{white-space:pre-wrap;overflow-wrap:anywhere;max-height:200px;overflow:auto;scrollbar-width:none}.cloud-document-text pre::-webkit-scrollbar{display:none}
.cloud-asset-picker{min-width:0}.cloud-asset-options{display:grid;gap:6px;max-height:250px;overflow-y:auto;overflow-x:hidden;scrollbar-width:none;margin:8px 0}.cloud-asset-options::-webkit-scrollbar{display:none}
.cloud-asset-option{display:flex;align-items:center;gap:10px;text-align:left;width:100%;border:1px solid var(--line);border-radius:8px;background:var(--surface);color:var(--ink);padding:10px;min-width:0;cursor:pointer}
.cloud-asset-option>span{flex:1;min-width:0;overflow-wrap:anywhere}.cloud-asset-option small{display:block;color:var(--muted);margin-top:3px}.cloud-asset-option.selected{border-color:var(--blue);background:var(--blue-soft)}
.cloud-asset-selected{border-top:1px solid var(--line);padding-top:12px;margin-top:12px}.cloud-asset-selected p{display:flex;align-items:center;gap:8px;overflow-wrap:anywhere}.cloud-asset-selected strong{min-width:0;overflow-wrap:anywhere}
