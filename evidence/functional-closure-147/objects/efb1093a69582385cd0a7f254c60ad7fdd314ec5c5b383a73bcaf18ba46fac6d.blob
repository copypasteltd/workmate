import {pathToFileURL} from 'node:url';
import path from 'node:path';
import {WorkmateRecording,saveWorkmateScreenshot} from './record-workmate-media.js';
const attempt=process.argv[2];assert.match(attempt??'',/^\d{2}$/);
const delivery=process.cwd(),platform=path.resolve('../copypaste-platform'),extension=path.resolve('../copypaste-extension'),owned=process.env.COPYPASTE_BUSINESS_INPUTS_OWNED!,workspace=path.join(owned,'approved-workspace'),localFile=path.join(workspace,'campaign-summary.csv'),prefix=`evidence/functional-closure-147/ui-${attempt}`;
const load=(file:string)=>import(pathToFileURL(path.join(platform,file)).href),sha=(b:Uint8Array)=>createHash('sha256').update(b).digest('hex');
const checks:string[]=[],screenshots:any[]=[],recordings:any[]=[],layouts:any[]=[],errors:string[]=[],diagnostics:any[]=[];
let isolated:any,system:any,browser:Browser|undefined,electron:ElectronApplication|undefined,extensionContext:BrowserContext|undefined,panel:any,recording:WorkmateRecording|undefined;
let stage='setup',failure:string|null=null,browserClosed=false,desktopClosed=false,extensionClosed=false,apiClosed=false,fixtureClosed=false,providerClosed=false;
let providerError:string|null=null,providerCalls=0,uploaded:any;const providerSteps={cloud:0,native:0};
async function until(read:()=>Promise<any>,valid:(v:any)=>boolean,label:string,ms=60000){const end=Date.now()+ms;for(;;){const v=await read();if(valid(v))return v;assert.ok(Date.now()<end,label);await new Promise(r=>setTimeout(r,150));}}
const pass=(name:string)=>{checks.push(name);console.log('PASS: '+name);};
async function stopRecording(){if(recording){const r=recording;recording=undefined;recordings.push(await r.stop());}}
async function shot(client:string,page:Page,name:string){screenshots.push(await saveWorkmateScreenshot(client,`functional-closure-147-${attempt}`,name,await page.screenshot(),'Actual customer workflow with controlled internal model responses and native consent decisions; actual Codex processes, local file bytes and application actions',delivery));}
async function attachTarget(parent:CDPSession,targetId:string){const {sessionId}=await parent.send('Target.attachToTarget',{targetId,flatten:false});let sequence=0;const pending=new Map<number,any>();
  const receive=(event:any)=>{if(event.sessionId!==sessionId)return;const m=JSON.parse(event.message),p=pending.get(m.id);if(!p)return;clearTimeout(p.timer);pending.delete(m.id);m.error?p.reject(new Error(m.error.message)):p.resolve(m.result);};parent.on('Target.receivedMessageFromTarget',receive);
  return {send(method:string,params:any={}){return new Promise<any>((resolve,reject)=>{const id=++sequence;pending.set(id,{resolve,reject,timer:setTimeout(()=>{pending.delete(id);reject(new Error('CDP '+method+' timed out'));},30000)});void parent.send('Target.sendMessageToTarget',{sessionId,message:JSON.stringify({id,method,params})}).catch(reject);});},async close(){parent.removeListener('Target.receivedMessageFromTarget',receive);for(const p of pending.values()){clearTimeout(p.timer);p.reject(new Error('Owned target closed'));}pending.clear();await parent.send('Target.detachFromTarget',{sessionId}).catch(()=>{});}};
}
async function evaluate(expression:string){const r=await panel.send('Runtime.evaluate',{expression,returnByValue:true,userGesture:true,awaitPromise:true});assert.equal(r.exceptionDetails,undefined,JSON.stringify(r.exceptionDetails));return r.result.value;}
const provider=createServer(async(req,res)=>{try{
  const chunks=[];for await(const b of req)chunks.push(Buffer.from(b));const body=JSON.parse(Buffer.concat(chunks).toString());
  assert.equal(req.headers.authorization,'Bearer functional-closure-fixture-147');assert.equal(body.model,'functional-closure-fixture-147');
  if(req.url==='/v1/responses/input_tokens'){res.writeHead(200,{'Content-Type':'application/json'}).end(JSON.stringify({object:'response.input_tokens',input_tokens:10}));return;}
  assert.equal(req.url,'/v1/responses');const ordinal=++providerCalls,text=JSON.stringify(body),cloud=text.includes('CP147_CLOUD_ROOT');assert.ok(cloud||text.includes('CP147_HANDOFF'),'Fixed original or local task marker');
  const key=cloud?'cloud':'native',step=providerSteps[key]++,tools=(body.tools??[]).flatMap((t:any)=>t.type==='namespace'?t.tools.map((c:any)=>({...c,namespace:t.name})):[t]);
  const call=(name:string,args:any)=>{const t=tools.find((t:any)=>t.name===name);assert.ok(t,'Actual company descriptor '+name);return {type:'function_call',id:'fc_closure_'+ordinal,call_id:'call_closure_'+ordinal,name:t.name,...(t.namespace?{namespace:t.namespace}:{}),arguments:JSON.stringify(args)};};
  const message=(text:string)=>({type:'message',id:'msg_closure_'+ordinal,role:'assistant',status:'completed',content:[{type:'output_text',text,annotations:[]}]});
  let item:any;
  if(cloud&&step===0)item=call('request_input',{requests:[{kind:'file',description:'CP147_HANDOFF: Prepare campaign-summary.csv in the customer-approved local folder. Do not upload files automatically.'}]});
  else if(cloud&&step===1)item=message('Please prepare and select the approved local campaign summary. This same task will continue.');
  else if(cloud&&step===2){assert.ok(uploaded);item=call('asset_text_read',{asset_id:uploaded.id});}
  else if(cloud&&step===3){assert.match(text,/launch,42/,'The resumed cloud Codex actually received the authorized uploaded bytes');item=call('deliver_text',{filename:'campaign-result.md',mime_type:'text/markdown',content:'The approved launch campaign recorded 42 clicks. Completed in the original task after local preparation.'});}
  else if(cloud)item=message('Your original campaign report is complete: 42 approved clicks.');
  else if(step===0){const t=tools.find((t:any)=>/(?:^|\.)(exec_command|shell|shell_command)$/.test(t.name));assert.ok(t,'Actual native shell');
    const command=`[IO.File]::WriteAllText('${localFile.replaceAll("'","''")}', 'campaign,clicks'+[Environment]::NewLine+'launch,42'+[Environment]::NewLine)`;
    const args=t.parameters?.properties?.cmd?{cmd:command,workdir:workspace,yield_time_ms:1000,max_output_tokens:1000}:t.parameters?.properties?.command?.type==='array'?{command:['powershell.exe','-NoProfile','-Command',command],workdir:workspace,timeout_ms:10000}:{command,workdir:workspace,timeout_ms:10000};
    item={type:'function_call',id:'fc_closure_'+ordinal,call_id:'call_closure_'+ordinal,name:t.name,...(t.namespace?{namespace:t.namespace}:{}),arguments:JSON.stringify(args)};
  }else item=message('campaign-summary.csv was written in the approved local folder. Review and upload only this file to the original cloud task.');
  res.writeHead(200,{'Content-Type':'text/event-stream'});const emit=(type:string,value:any)=>res.write(`event: ${type}\ndata: ${JSON.stringify({type,...value})}\n\n`),response={id:'resp_closure_'+ordinal,object:'response',created_at:1,model:body.model,status:'in_progress',output:[]};
  emit('response.created',{response});emit('response.output_item.added',{output_index:0,item:item.type==='function_call'?{...item,arguments:''}:item});
  if(item.type==='function_call'){emit('response.function_call_arguments.delta',{output_index:0,item_id:item.id,delta:item.arguments});emit('response.function_call_arguments.done',{output_index:0,item_id:item.id,arguments:item.arguments});}
  else{emit('response.output_text.delta',{output_index:0,item_id:item.id,content_index:0,delta:item.content[0].text});emit('response.output_text.done',{output_index:0,item_id:item.id,content_index:0,text:item.content[0].text});}
  emit('response.output_item.done',{output_index:0,item});emit('response.completed',{response:{...response,status:'completed',output:[item],usage:{input_tokens:10,output_tokens:20,total_tokens:30}}});res.end();
}catch(e){providerError=String(e);if(!res.headersSent)res.writeHead(502);res.end();}});
try{
  await mkdir(workspace,{recursive:true});await new Promise<void>(r=>provider.listen(0,'127.0.0.1',r));
