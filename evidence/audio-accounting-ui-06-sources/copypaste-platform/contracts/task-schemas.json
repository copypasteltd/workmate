            "$ref": "#/components/schemas/PreExecutionInput"
          },
          "maxItems": 8,
          "description": "Explicit prerequisites before the first model turn; file/connection only. Does not resume paid model steps."
        }
      },
      "required": [
        "project_id",
        "type",
        "input",
        "budget"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "delegation"
