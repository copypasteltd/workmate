          },
          "then": {
            "properties": {
              "input": {
                "$ref": "#/components/schemas/LocalInput"
              }
            }
          }
        }
      ],
      "oneOf": [
        {
          "required": [
            "agent_id"
          ],
          "not": {
            "required": [
              "agent_group_id"
            ]
          }
        },
        {
          "required": [
            "agent_group_id"
          ],
          "not": {
            "required": [
              "agent_id"
            ]
          }
        }
      ]
    },
    "TaskType": {
      "type": "string",
      "enum": [
        "delegation",
        "creative_image",
        "creative_video",
        "analysis",
        "seo",
        "geo",
        "workflow",
        "local_file"
      ]
    },
    "Money": {
      "type": "object",
      "properties": {
        "currency": {
          "type": "string",
          "enum": [
            "HKD"
          ]
        },
        "amount_micros": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "description": "One millionth of currency; decimal integer string."
        }
      },
      "required": [
        "currency",
        "amount_micros"
      ],
      "additionalProperties": false
    },
    "PreExecutionInput": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "file",
            "connection"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "provider": {
          "type": "string",
          "enum": [
            "google_ads",
            "ga4",
            "search_console",
            "meta"
          ]
        },
        "resource_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true
        }
      },
      "required": [
        "kind",
        "description"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "connection"
              }
            }
          },
          "then": {
            "required": [
              "provider"
            ],
            "properties": {
              "resource_ids": {
                "maxItems": 1
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "provider"
              ]
            }
          }
        }
      ]
    },
    "DelegationInput": {
      "type": "object",
