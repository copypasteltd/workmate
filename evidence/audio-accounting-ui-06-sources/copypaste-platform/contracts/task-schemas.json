          },
          "then": {
            "properties": {
              "input": {
                "$ref": "#/components/schemas/DelegationInput"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "creative_image"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "input": {
                "$ref": "#/components/schemas/CreativeInput"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "creative_video"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "input": {
                "$ref": "#/components/schemas/VideoInput"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "analysis"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "input": {
                "$ref": "#/components/schemas/AnalysisSpec"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "seo"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "input": {
                "$ref": "#/components/schemas/SeoInput"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "geo"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "input": {
                "$ref": "#/components/schemas/GeoInput"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "workflow"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "input": {
                "$ref": "#/components/schemas/WorkflowInput"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "local_file"
              }
