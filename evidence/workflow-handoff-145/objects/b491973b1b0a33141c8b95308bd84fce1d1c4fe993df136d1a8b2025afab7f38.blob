{
  "protocol": "copypaste.desktop-disconnect.v1",
  "schemas": {
    "DesktopDisconnectRequest": {
      "type": "object",
      "properties": {
        "protocol": {
          "type": "string",
          "const": "copypaste.desktop-disconnect.v1"
        },
        "client_id": {
          "type": "string",
          "const": "desktop"
        },
        "request_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "refresh_token": {
          "type": "string",
          "minLength": 40,
          "maxLength": 100
        },
        "devices": {
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "tenant_id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "device_id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "signature": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{86}$"
              }
            },
            "required": [
              "tenant_id",
              "device_id",
              "signature"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "protocol",
        "client_id",
        "request_id",
        "refresh_token",
        "devices"
      ],
      "additionalProperties": false
    },
    "DesktopDisconnectReceipt": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean",
          "const": true
        },
        "request_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "devices": {
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "tenant_id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "device_id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "status": {
                "type": "string",
                "enum": [
                  "revoked",
                  "unverified"
                ]
              }
            },
            "required": [
              "tenant_id",
              "device_id",
              "status"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "ok",
        "request_id",
        "devices"
      ],
      "additionalProperties": false
    }
  }
}
