.desktop-removal-card {
  max-width: 800px;
}
.desktop-removal-steps {
  list-style: none;
  padding: 0;
  margin: 22px 0;
  border-top: 1px solid var(--line);
}
.desktop-removal-steps li {
  display: flex;
  gap: 13px;
  padding: 16px 0;
  border-bottom: 1px solid var(--line);
  min-width: 0;
}
.desktop-removal-steps li > svg {
  color: var(--blue);
  flex-shrink: 0;
  margin-top: 2px;
}
.desktop-removal-steps li > div {
  min-width: 0;
}
.desktop-removal-steps strong {
  font-size: 14px;
}
.desktop-removal-steps p {
  font-size: 13px;
  line-height: 1.65;
  color: var(--muted);
  margin: 7px 0 0;
}
.desktop-removal-option {
  display: flex;
  align-items: flex-start;
  gap: 11px;
  padding: 16px;
  background: var(--bg);
  border: 1px solid var(--line);
  border-radius: 12px;
  font-size: 13px;
  line-height: 1.6;
}
.desktop-removal-option input {
  width: 16px;
  height: 16px;
  flex: 0 0 16px;
  accent-color: var(--blue);
  margin: 3px 0 0;
}
.desktop-removal-option small {
  display: block;
  color: var(--muted);
  margin-top: 4px;
}
.desktop-removal-receipt {
  background: var(--bg);
  border-radius: 12px;
  padding: 7px 16px;
  margin: 18px 0;
}
.desktop-removal-receipt p {
  display: flex;
  gap: 15px;
  justify-content: space-between;
  font-size: 12px;
  line-height: 1.6;
}
.desktop-removal-receipt strong {
  flex: 0 0 110px;
}
.desktop-removal-receipt span {
  min-width: 0;
  text-align: right;
  color: var(--muted);
  overflow-wrap: anywhere;
}
.desktop-removal-page .desktop-removal-card {
  margin-top: 34px;
}
@media (max-width: 650px) {
  .desktop-removal-receipt p {
    flex-direction: column;
    gap: 4px;
  }
  .desktop-removal-receipt strong {
    flex-basis: auto;
  }
  .desktop-removal-receipt span {
    text-align: left;
  }
}
