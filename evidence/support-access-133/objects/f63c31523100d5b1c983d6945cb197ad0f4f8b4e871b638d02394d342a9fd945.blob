.publications-page {
  display: grid;
  gap: 24px;
  min-width: 0;
}
.publications-page .page-heading {
  margin-bottom: 2px;
}
.publications-page .page-heading h1 {
  max-width: 840px;
  font-size: clamp(30px, 3.4vw, 47px);
  line-height: 1.18;
  letter-spacing: -0.045em;
}
.publications-page h2 {
  margin: 7px 0 0;
  font-size: clamp(20px, 1.9vw, 26px);
  line-height: 1.32;
  letter-spacing: -0.035em;
}
.publications-page h3 {
  margin: 0 0 10px;
  font-size: 17px;
  line-height: 1.5;
}
.publication-demo {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 13px 18px;
  background: var(--blue-soft);
  border: 1px solid var(--line);
  border-radius: 10px;
  font-size: 13px;
  line-height: 1.7;
}
.publication-dot {
  width: 7px;
  height: 7px;
  flex: 0 0 7px;
  border-radius: 100%;
  background: var(--blue);
}
.publication-steps {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  list-style: none;
  padding: 0 0 20px;
  margin: 0;
  border-bottom: 1px solid var(--line);
}
.publication-steps li {
  display: flex;
  align-items: center;
  gap: 11px;
  min-width: 0;
  font-size: 13px;
  font-weight: 650;
}
.publication-steps li > span {
  color: var(--blue);
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.06em;
}
.publication-steps li > svg {
  margin-left: auto;
  margin-right: 16px;
  color: var(--muted);
  flex-shrink: 0;
}
.publication-section {
  min-width: 0;
  padding: 27px;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 16px;
}
.publication-section-heading {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  flex-wrap: wrap;
  gap: 16px;
  margin-bottom: 23px;
}
.publication-section-heading .eyebrow {
  margin: 0;
  color: var(--muted);
  font-size: 11px;
  letter-spacing: 0.1em;
}
.publication-account-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(290px, 100%), 1fr));
  gap: 13px;
}
.publication-account {
  min-width: 0;
  border: 1px solid var(--line);
  border-radius: 12px;
  background: var(--surface);
}
.publication-account.selected {
  border-color: var(--blue);
  box-shadow: 0 0 0 1px var(--blue);
}
.publication-account-select {
  display: flex;
  align-items: center;
  gap: 13px;
  width: 100%;
  min-width: 0;
  background: transparent;
  text-align: left;
  padding: 18px;
  border-radius: 12px;
}
.publication-account-select > span:nth-child(2) {
  display: grid;
  gap: 5px;
  flex: 1;
  min-width: 0;
  overflow-wrap: anywhere;
}
.publication-account-select small {
  color: var(--muted);
  font-size: 11px;
}
.publication-account-select > svg {
  color: var(--blue);
  flex-shrink: 0;
}
.publication-account-state {
  font-size: 12px;
  color: var(--muted);
}
.publication-avatar {
  display: grid;
  place-items: center;
  width: 40px;
  height: 40px;
  flex: 0 0 40px;
  border-radius: 11px;
  font-size: 23px;
  font-weight: 800;
  color: var(--blue);
  background: var(--blue-soft);
}
.publication-account-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 13px;
  border-top: 1px solid var(--line);
  padding: 12px 18px;
}
.publication-account-actions .text-button {
  padding: 2px 0;
  font-size: 12px;
}
.publication-policy-strip {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 13px;
  padding: 19px 0 0;
  margin-top: 20px;
  border-top: 1px solid var(--line);
}
.publication-policy-strip > svg {
  color: var(--blue);
  flex-shrink: 0;
}
.publication-policy-strip > div {
  flex: 1;
  min-width: min(200px, 100%);
  display: grid;
  gap: 5px;
}
.publication-policy-strip span {
  color: var(--muted);
  font-size: 12px;
  line-height: 1.7;
  overflow-wrap: anywhere;
}
.publication-work-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  align-items: start;
  gap: 24px;
  min-width: 0;
}
.publication-form {
  display: grid;
  gap: 17px;
  min-width: 0;
}
.publication-form fieldset {
  display: grid;
  gap: 16px;
  min-width: 0;
  margin: 0;
  padding: 0;
  border: 0;
}
.publication-form legend {
  font-size: 14px;
  font-weight: 700;
  margin-bottom: 12px;
}
.publication-form p {
  margin: 0;
  line-height: 1.8;
}
.publication-form .field {
  min-width: 0;
  margin: 0;
}
.publication-form input,
.publication-form textarea,
.publication-form select,
.publication-unknown input,
.publication-unknown textarea {
  width: 100%;
  min-width: 0;
  max-width: 100%;
}
.publication-form input[type="color"] {
  width: 70px;
  height: 38px;
  padding: 4px;
}
.publication-form input[type="checkbox"],
.publication-unknown input[type="checkbox"] {
  width: 17px;
}
.publication-field-pair {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 13px;
  min-width: 0;
}
.publication-check {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding: 4px 0;
  font-size: 13px;
  line-height: 1.8;
  overflow-wrap: anywhere;
}
.publication-check input[type="checkbox"] {
  appearance: auto;
  width: 17px;
  height: 17px;
  flex: 0 0 17px;
  margin: 4px 0 0;
  accent-color: var(--blue);
}
.publication-checkboxes {
  display: grid;
  gap: 5px;
}
.publication-selected-source {
  display: grid;
  gap: 13px;
  padding: 15px;
  border: 1px solid var(--line);
  border-radius: 10px;
}
.publication-source-heading {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
  min-width: 0;
}
.publication-source-heading strong {
  flex: 1;
  min-width: 100px;
  overflow-wrap: anywhere;
  font-size: 13px;
}
.publication-source-heading > span {
  font-size: 11px;
  color: var(--muted);
}
.publication-source-controls {
  display: flex;
  align-items: center;
  gap: 2px;
}
.publication-source-controls .icon-button {
  width: 29px;
  height: 29px;
  min-height: 29px;
}
.publication-asset-picker {
  display: grid;
  gap: 14px;
  padding: 16px;
  border: 1px dashed var(--line);
  border-radius: 10px;
  background: var(--bg);
}
.publication-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10px;
}
.publication-form .button {
  justify-self: start;
}
.publication-preview-section {
  min-height: 360px;
}
.publication-preview-empty {
  min-height: 285px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
  max-width: 340px;
  padding: 20px 6px;
}
.publication-preview-mark {
  width: 64px;
  height: 64px;
  display: grid;
  place-items: center;
  margin-bottom: 22px;
  color: var(--blue);
  background: var(--blue-soft);
  border-radius: 18px;
  transform: rotate(-7deg);
}
.publication-preview-empty p {
  margin: 0;
  color: var(--muted);
  font-size: 13px;
  line-height: 1.85;
}
.publication-preview-card {
  min-width: 0;
  overflow-wrap: anywhere;
}
.publication-preview-header {
  display: flex;
  align-items: center;
  gap: 11px;
  margin-bottom: 22px;
}
.publication-preview-header > div {
  display: grid;
  gap: 5px;
  flex: 1;
  min-width: 0;
}
.publication-preview-header > div span {
  color: var(--muted);
  font-size: 11px;
}
.publication-preview-header > svg {
  color: var(--muted);
  flex-shrink: 0;
}
.publication-caption {
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  line-height: 1.85;
  margin: 0 0 18px;
}
.publication-link {
  display: inline-block;
  max-width: 100%;
  color: var(--blue);
  text-decoration: underline;
  overflow-wrap: anywhere;
  margin-bottom: 16px;
}
.publication-media-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}
.publication-media-grid.single {
  grid-template-columns: minmax(0, 1fr);
}
.publication-media {
  min-width: 0;
  margin: 0;
}
.publication-media-frame {
  display: grid;
  place-items: center;
  min-height: 150px;
  border-radius: 10px;
  background: var(--bg);
  overflow: hidden;
}
.publication-media-frame img,
.publication-media-frame video {
  display: block;
  width: 100%;
  max-width: 100%;
  max-height: 510px;
  object-fit: contain;
}
.publication-media-loading {
  display: grid;
  justify-items: center;
  gap: 9px;
  padding: 25px 10px;
  color: var(--muted);
  font-size: 12px;
}
.publication-media figcaption {
  display: grid;
  gap: 5px;
  padding: 12px 0;
  font-size: 11px;
  color: var(--muted);
  line-height: 1.8;
  overflow-wrap: anywhere;
}
.publication-media figcaption strong {
  color: var(--ink);
  font-size: 12px;
}
.publication-proof {
  padding: 15px 0;
  margin-top: 15px;
  border-top: 1px solid var(--line);
  font-size: 12px;
  color: var(--muted);
}
.publication-proof summary {
  cursor: pointer;
  color: var(--ink);
  padding: 5px 0;
}
.publication-proof dl {
  display: grid;
  gap: 9px;
}
.publication-proof dt {
  color: var(--ink);
  margin-top: 7px;
}
.publication-proof dd {
  margin: 0;
}
.publication-proof code {
  overflow-wrap: anywhere;
  white-space: pre-wrap;
  font-size: 11px;
}
.publication-proof li {
  margin: 8px 0;
  line-height: 1.8;
}
.publication-state {
  display: inline-flex;
  width: fit-content;
  max-width: 100%;
  padding: 5px 9px;
  border-radius: 6px;
  font-size: 11px;
  line-height: 1.6;
  background: var(--warm);
  color: var(--muted);
  overflow-wrap: anywhere;
}
.publication-state.awaiting_confirmation,
.publication-state.queued,
.publication-state.preparing,
.publication-state.publishing,
.publication-state.processing,
.publication-state.waiting_media {
  background: var(--blue-soft);
  color: var(--blue);
}
.publication-state.succeeded {
  background: color-mix(in srgb, var(--green) 9%, var(--surface));
  color: var(--green);
}
.publication-state.unknown,
.publication-state.failed {
  background: color-mix(in srgb, var(--red) 7%, var(--surface));
  color: var(--red);
}
.publication-records {
  display: grid;
  margin-bottom: 17px;
}
.publication-record {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, auto) 18px;
  gap: 18px;
  width: 100%;
  padding: 17px 0;
  border-bottom: 1px solid var(--line);
  align-items: center;
  text-align: left;
  background: transparent;
}
.publication-record > span:first-child {
  display: grid;
  gap: 6px;
  min-width: 0;
}
.publication-record strong {
  overflow-wrap: anywhere;
}
.publication-record small {
  color: var(--muted);
  font-size: 11px;
}
.publication-record.selected {
  color: var(--blue);
}
.publication-operation-summary {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 13px;
  margin: 0 0 24px;
  font-size: 12px;
  color: var(--muted);
}
.publication-inspector .publication-preview-card {
  max-width: 720px;
}
.publication-confirmation,
.publication-unknown,
.publication-pending {
  display: flex;
  gap: 16px;
  padding: 22px;
  border-radius: 12px;
  margin-top: 20px;
  border: 1px solid var(--line);
  background: var(--blue-soft);
}
.publication-confirmation > svg,
.publication-unknown > svg,
.publication-pending > svg {
  flex-shrink: 0;
  color: var(--blue);
}
.publication-confirmation > div,
.publication-unknown > div,
.publication-pending > div {
  min-width: 0;
  display: grid;
  gap: 12px;
}
.publication-confirmation p,
.publication-unknown p,
.publication-pending p {
  margin: 0;
  font-size: 13px;
  line-height: 1.85;
}
.publication-unknown {
  background: var(--bg);
}
.publication-unknown > svg {
  color: var(--red);
}
.publication-pending {
  margin-top: 0;
}
.publication-inline-note {
  margin: 10px 0;
  padding: 12px 14px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: var(--bg);
  font-size: 12px;
  line-height: 1.85;
  overflow-wrap: anywhere;
}
.publication-risk {
  color: var(--red);
}
.publication-success {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 9px;
  color: var(--green);
  font-size: 13px;
  line-height: 1.8;
}
.publication-empty {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 10px;
  padding: 22px 0;
  color: var(--muted);
  line-height: 1.8;
}
.publication-empty p {
  margin: 0;
}
.publications-page button:focus-visible,
.publications-page summary:focus-visible {
  outline: 2px solid var(--blue);
  outline-offset: 4px;
}
@media (max-width: 1150px) {
  .publication-work-grid {
    grid-template-columns: minmax(0, 1fr);
  }
  .publication-preview-section {
    min-height: 260px;
  }
  .publication-preview-empty {
    min-height: 190px;
  }
}
@media (max-width: 740px) {
  .publications-page {
    gap: 17px;
  }
  .publication-section {
    padding: 20px 17px;
    border-radius: 12px;
  }
  .publication-section-heading {
    margin-bottom: 20px;
  }
  .publication-steps {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 15px 10px;
  }
  .publication-steps li > svg {
    display: none;
  }
  .publication-field-pair {
    grid-template-columns: minmax(0, 1fr);
  }
  .publication-confirmation,
  .publication-unknown,
  .publication-pending {
    padding: 17px 13px;
    gap: 10px;
  }
  .publication-record {
    gap: 10px;
    grid-template-columns: minmax(0, 1fr) 18px;
  }
  .publication-record > .publication-state {
    grid-column: 1;
    grid-row: 2;
  }
  .publication-record > svg {
    grid-column: 2;
    grid-row: 1 / span 2;
  }
  .publication-media-grid {
    grid-template-columns: minmax(0, 1fr);
  }
  .publication-demo {
    align-items: flex-start;
  }
  .publication-dot {
    margin-top: 8px;
  }
}
@media (prefers-reduced-motion: reduce) {
  .publications-page * {
    scroll-behavior: auto;
    transition: none;
    animation: none;
  }
}
.admin-publications .publication-admin-scope {
  display: grid;
  gap: 20px;
}
.publication-admin-filter {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 0.8fr) auto;
  align-items: end;
  gap: 14px;
}
.publication-admin-filter .field {
  margin: 0;
  min-width: 0;
}
.publication-admin-filter input,
.publication-admin-filter select {
  width: 100%;
  min-width: 0;
}
.publication-admin-operation {
  padding: 20px 0;
  border-bottom: 1px solid var(--line);
}
.publication-admin-operation > button:first-child {
  width: 100%;
  border: 0;
  background: transparent;
  color: inherit;
  text-align: left;
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 20px;
  cursor: pointer;
}
.publication-admin-operation > button:first-child:hover strong {
  color: var(--blue);
}
.publication-admin-operation > button:first-child span {
  display: grid;
  gap: 7px;
  min-width: 0;
}
.publication-admin-operation small,
.publication-admin-operation code {
  overflow-wrap: anywhere;
  color: var(--muted);
}
.publication-admin-operation .text-button {
  margin-top: 14px;
}
.publication-admin-facts {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
}
.publication-admin-facts > div {
  min-width: 0;
}
.publication-admin-facts dt {
  font-size: 12px;
  color: var(--muted);
  margin-bottom: 5px;
}
.publication-admin-facts dd {
  margin: 0;
  overflow-wrap: anywhere;
}
.publication-inspector {
  min-width: 0;
  display: grid;
  gap: 18px;
}
.publication-inspector pre {
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  max-width: 100%;
  font-size: 12px;
}
.publication-admin-events {
  padding-left: 20px;
  margin: 0;
}
.publication-admin-events li {
  margin: 12px 0;
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 12px;
  overflow-wrap: anywhere;
}
.publication-admin-policy {
  display: grid;
  gap: 16px;
  min-width: 0;
}
.publication-admin-policy > p {
  overflow-wrap: anywhere;
}
@media (max-width: 1100px) {
  .publication-admin-filter {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}
@media (max-width: 600px) {
  .publication-admin-filter,
  .publication-admin-operation > button:first-child,
  .publication-admin-facts {
    grid-template-columns: minmax(0, 1fr);
  }
  .publication-admin-operation > button:first-child {
    gap: 12px;
  }
}
