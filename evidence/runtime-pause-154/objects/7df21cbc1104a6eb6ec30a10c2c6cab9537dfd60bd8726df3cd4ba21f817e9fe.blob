import { assertTaskContentSources } from "./task-content-sources.js";
import type { Database, Tx } from "./db.js";
import type { Catalog } from "./catalog.js";
import type { Principal } from "./auth.js";
import { projectAccess } from "./access.js";
import { Problem } from "./lib.js";
import { event } from "./tasks.js";
import { assertTaskSkills } from "./skill-lifecycle.js";
import { authorizeExecutionPlan } from "./plans.js";
import { resolveWorkContext } from "./persistent-work.js";
import { assertReportSources } from "./analysis-reports.js";
import { checkInputDependencies } from "./task-dependencies.js";
import { boundTaskAvailability } from "./capability-bindings.js";
import { paidInputCheckpoint, settleIdleTask } from "./paid-task-inputs.js";

/** Caller holds the task row lock. Cancellation is a request, never proof that
 * an accepted external operation was free or that its reservation can be freed. */
export async function requestTaskCancellation(tx: Tx, task: any) {
  if (
    ![
      "queued",
      "running",
      "paused",
      "awaiting_approval",
      "needs_input",
      "reconciling",
    ].includes(task.status) ||
    task.cancel_requested
  )
    return task;
  if (task.status !== "running" && task.status !== "reconciling") {
    const known = await settleIdleTask(tx, task);
    if (!known) {
      await tx.query(
        "UPDATE tasks SET status='reconciling',error_code='CANCELLATION_REQUIRES_RECONCILIATION' WHERE id=$1",
        [task.id],
      );
    } else {
      await tx.query("UPDATE tasks SET status='cancelled' WHERE id=$1", [
        task.id,
      ]);
    }
  }
  await tx.query(
    "UPDATE tasks SET cancel_requested=true,version=version+1,updated_at=now() WHERE id=$1",
    [task.id],
  );
  await event(tx, task.tenant_id, task.id, "task.cancel_requested", {});
  return (await tx.query("SELECT * FROM tasks WHERE id=$1", [task.id])).rows[0];
}

/** Caller holds the task row lock and has authorized the human/admin action.
 * Running cloud work records intent; resume requires its completed measured
 * checkpoint or the original unclaimed state. Unknown operations cannot resume.
 */
export async function controlUnclaimedTask(
  tx: Tx,
  db: Database,
  catalog: Catalog,
  task: any,
  action: "pause" | "resume",
) {
  const expected = action === "pause" ? "queued" : "paused";
  if (task.agent_group_run_id && action === "resume") {
    const run = (
      await tx.query(
        "SELECT state FROM agent_group_runs WHERE id=$1 AND content_state='active' AND deadline_at>clock_timestamp()",
        [task.agent_group_run_id],
      )
    ).rows[0];
    if (run?.state !== "running")
      throw new Problem(
        409,
        "GROUP_EXECUTION_CLOSED",
        "This team execution is closed; review a new run",
      );
    if (
      task.agent_group_node_key === "coordinator" &&
      (
        await tx.query(
          "SELECT 1 FROM agent_group_nodes n LEFT JOIN tasks t ON t.id=n.task_id WHERE n.run_id=$1 AND (n.state<>'succeeded' OR t.status IS DISTINCT FROM 'succeeded' OR t.content_state IS DISTINCT FROM 'active') LIMIT 1",
          [task.agent_group_run_id],
        )
      ).rowCount
    )
      throw new Problem(
        409,
        "GROUP_MEMBERS_PENDING",
        "The coordinator starts after the approved members finish",
      );
  }
  if (task.execution_location === "desktop")
    throw new Problem(
      409,
      "LOCAL_EXECUTION_CONTROL_REQUIRED",
      "Control this execution from its local desktop session",
    );
  if (action === "pause" && task.status === "running" && !task.cancel_requested && task.content_state === "active") {
    if(task.pause_requested) return task;
    const count=(await tx.query("SELECT ((SELECT count(*) FROM task_input_checkpoints WHERE task_id=$1)+(SELECT count(*) FROM task_pause_checkpoints WHERE task_id=$1))::int AS n",[task.id])).rows[0].n;
    if(count>=8) throw new Problem(409,"PAUSE_CHECKPOINT_LIMIT","This task has reached its continuation limit");
    await tx.query("UPDATE tasks SET pause_requested=true,version=version+1,updated_at=now() WHERE id=$1",[task.id]);
    await event(tx,task.tenant_id,task.id,"task.pause_requested",{boundary:"completed_measured_model_turn"});
    return (await tx.query("SELECT * FROM tasks WHERE id=$1",[task.id])).rows[0];
  }
  const paid=task.attempt>0 ? await paidInputCheckpoint(tx,task,task.status === "queued" ? "queued" : undefined) : null;
  if (
    task.status !== expected ||
    ((task.attempt !== 0 || task.runtime_thread) && !paid) ||
    task.cancel_requested ||
    task.content_state !== "active"
  )
    throw new Problem(
      409,
      action === "pause" ? "CANNOT_PAUSE" : "CANNOT_RESUME",
      "Pause a cloud task before execution or resume its measured completed checkpoint",
    );
  const reservation = (
    await tx.query("SELECT * FROM reservations WHERE task_id=$1 FOR UPDATE", [
      task.id,
    ])
  ).rows[0];
  if (
    reservation?.status !== "reserved" ||
    reservation.amount_micros !== task.budget_micros ||
    (!paid && (
      await tx.query("SELECT 1 FROM tool_operations WHERE task_id=$1 LIMIT 1", [task.id])
    ).rowCount)
  )
    throw new Problem(
      409,
      "CHECKPOINT_UNAVAILABLE",
      "The original reservation or initial execution checkpoint is unavailable",
    );
  if (action === "pause") {
    await tx.query(
      "UPDATE tasks SET status='paused',pause_requested=true,capacity_wait_reason=NULL,version=version+1,updated_at=now() WHERE id=$1",
      [task.id],
    );
    await event(tx, task.tenant_id, task.id, "task.paused", {
      previous: "queued",
      status: "paused",
      checkpoint: paid ? "completed_model_turn" : "before_first_model_turn",
    });
  } else {
    // An administrator's permission to resume does not confer the beneficiary's
    // revoked permission. Execute under the original user's frozen auth version.
    const user = (
      await tx.query("SELECT * FROM users WHERE id=$1", [task.created_by])
    ).rows[0];
    const actor: Principal = {
      id: task.created_by,
      email: user.email,
      name: user.name,
      authVersion: task.actor_auth_version,
      audience: "user",
      sessionId: "",
      sessionHash: "",
    };
    await projectAccess(tx, actor, task.tenant_id, task.project_id, "write");
    if ((task.data_mode === "simulated") !== db.config.DEMO_MODE)
      throw new Problem(
        409,
        "DATA_MODE_MISMATCH",
        "Resume in the task's execution environment",
      );
    const role = catalog.forTask(task);
    await catalog.ensureEnabled(tx, task.role_key, task.role_hash);
    await assertTaskSkills(tx, catalog, task);
    if (catalog.digest(role) !== task.role_hash)
      throw new Problem(
        409,
        "ROLE_VERSION_CHANGED",
        "The task's role version is no longer available",
      );
    const { availability, binding } = await boundTaskAvailability(
      tx,
      db.config,
      catalog,
      task,
    );
    if (!availability.available)
      throw new Problem(
        503,
        availability.reason!,
        "The task's execution capability is unavailable",
      );
    await assertReportSources(tx, task);
    await assertTaskContentSources(tx, task);
    await authorizeExecutionPlan(
      tx,
      task.tenant_id,
      task.created_by,
      role,
      task.mode,
    );
    await resolveWorkContext(
      tx,
      actor,
      task.tenant_id,
      task.project_id,
      task.input_context,
      db.config.CODEX_VERSION,
      binding.versionIds,
    );
    if(paid && Number(task.accrued_micros)>=Number(task.budget_micros))
      throw new Problem(409,"RESUME_BUDGET_EXHAUSTED","The original task budget is exhausted; retain its results and close this task before approving new work");
    if (await checkInputDependencies(tx, task)) {
      if(paid?.state === "waiting") {
        const table=paid.checkpoint_kind === "pause" ? "task_pause_checkpoints" : "task_input_checkpoints";
        await tx.query(`UPDATE ${table} SET state='queued' WHERE id=$1`,[paid.id]);
      }
      await tx.query(
        "UPDATE tasks SET status='queued',pause_requested=false,version=version+1,updated_at=now(),capacity_retry_at=now(),next_claim_retry_at=now()+interval '1 minute' WHERE id=$1",
        [task.id],
      );
      await tx.query(
        `INSERT INTO outbox(tenant_id,topic,payload)
         SELECT $1,'task.run',jsonb_build_object('task_id',$2::text)
         WHERE NOT EXISTS(SELECT 1 FROM outbox WHERE topic='task.run' AND payload->>'task_id'=$2::text AND dispatched_at IS NULL)`,
        [task.tenant_id, task.id],
      );
      await event(tx, task.tenant_id, task.id, "task.resumed", {
        previous: "paused",
        status: "queued",
        checkpoint: paid ? "completed_model_turn" : "before_first_model_turn",
      });
    }
  }
  return (await tx.query("SELECT * FROM tasks WHERE id=$1", [task.id])).rows[0];
}
