import assert from "node:assert/strict";
import { chromium, _electron, type Page, type Browser, type ElectronApplication } from "playwright";
import { readFile, writeFile } from "node:fs/promises";
import { randomUUID, createHash } from "node:crypto";
import { pathToFileURL } from "node:url";
import path from "node:path";
import { WorkmateRecording, saveWorkmateScreenshot } from "./record-workmate-media.js";

const delivery=process.cwd(),platform=path.resolve("../copypaste-platform"),attempt=process.argv[2];assert.match(attempt??"",/^\d{2}$/);
const prefix=`evidence/marketing-import-148/ui-${attempt}`,owned=process.env.COPYPASTE_BUSINESS_INPUTS_OWNED!,checks:string[]=[],screenshots:any[]=[],recordings:any[]=[],layouts:any[]=[],errors:string[]=[],diagnostics:any[]=[];
const load=(f:string)=>import(pathToFileURL(path.join(platform,f)).href),sha=(b:Buffer)=>createHash("sha256").update(b).digest("hex");
let isolated:any,system:any,browser:Browser|undefined,electron:ElectronApplication|undefined,recording:WorkmateRecording|undefined;
let browserClosed=false,desktopClosed=false,apiClosed=false,fixtureClosed=false,stage="setup";
async function until(fn:()=>Promise<any>,valid:(v:any)=>boolean,label:string){const end=Date.now()+60000;for(;;){const v=await fn();if(valid(v))return v;assert.ok(Date.now()<end,label);await new Promise(r=>setTimeout(r,150));}}
async function stopRecording(){if(recording){const r=recording;recording=undefined;recordings.push(await r.stop());}}
async function shot(client:string,p:Page,name:string){screenshots.push(await saveWorkmateScreenshot(client,`marketing-release-148-${attempt}`,name,await p.screenshot({timeout:15000}),"Actual frozen-candidate application, real OTP/PKCE, original synthetic campaign file and deterministic exact analysis; no model call",delivery));}
async function login(p:Page,url:string,email:string){await p.goto(url);await p.locator('input[name="email"]').fill(email);const[r]=await Promise.all([p.waitForResponse(r=>new URL(r.url()).pathname==="/v1/auth/challenges"),p.locator('form button[type="submit"]').click()]);assert.equal(r.status(),202);const ch=await r.json(),mail=JSON.parse(await readFile(path.join(isolated.directory,"mailbox",ch.challenge_id+".json"),"utf8"));await p.locator('input[name="code"]').fill(mail.text.match(/\b\d{6}\b/)[0]);await p.locator('form button[type="submit"]').click();}
const timer=setTimeout(()=>{errors.push("Release smoke deadline");void electron?.close();void browser?.close();},480000);
try{
 const [{isolatedTestEnvironment},{buildApp},{loadConfig},fixtures]=await Promise.all([load("tests/native-test-environment.ts"),load("src/server.ts"),load("src/config.ts"),load("tests/admin-history-fixture.ts")]);
 process.chdir(platform);isolated=await isolatedTestEnvironment();system=await buildApp(loadConfig({...isolated.env,NODE_ENV:"test",WORKER_ENABLED:"false",DEMO_MODE:"true",DEV_MAILBOX:"true",API_ORIGIN:"http://localhost:4310",WEB_ORIGIN:"http://localhost:4317",ADMIN_ORIGIN:"http://localhost:4318"}),{worker:false});await system.app.listen({host:"127.0.0.1",port:4310});
 const owner=await fixtures.historyLogin(system),w=await fixtures.historyOk(system,owner,"POST","/v1/tenants",{name:"CopyPaste launch studio",project_name:"Frozen release campaign"});owner.tenant=w.tenant.id;const tenant=w.tenant.id,project=w.project.id,email=(await system.db.control.query("SELECT email FROM users WHERE id=$1",[owner.id])).rows[0].email;
 browser=await chromium.launch({executablePath:process.env.CHROME_BIN,headless:true});const context=await browser.newContext({viewport:{width:1440,height:1000}});await context.addInitScript(({tenant,project})=>{localStorage.setItem("cp_locale","en");localStorage.setItem("cp_theme","light");localStorage.setItem("cp_tenant",tenant);localStorage.setItem("cp_project",project);},{tenant,project});const web=await context.newPage();web.setDefaultTimeout(25000);web.on("pageerror",e=>errors.push(e.message));web.on("response",async r=>{if(r.status()>=400&&r.url().includes("/v1/"))diagnostics.push({url:new URL(r.url()).pathname,status:r.status(),body:(await r.text().catch(()=>"unreadable")).slice(0,3000)});});
 stage="Web OTP and reviewed campaign import";await login(web,"http://localhost:4317/login",email);await web.waitForURL("**/app**");checks.push("Actual Web email OTP and active workspace");
 const text='Report "custom" heading\r\nSynthetic campaign export\r\nDay;Campaign;Campaign ID;Impressions;Clicks;Cost;Conversions;Conv. value\r\n01/10/2026;Harbour launch;00456;1.000;10;1.234,56;4,5;4.500,25';const bytes=Buffer.concat([Buffer.from([255,254]),Buffer.from(text,"utf16le")]);
 async function campaign(p:Page,client:string){
   if(client==="web")await p.goto("http://localhost:4317/app/analytics");else await p.evaluate(()=>{location.hash="/app/analytics";});
   await p.getByRole("button",{name:"Import data",exact:true}).click();const modal=p.getByRole("dialog");await modal.locator('input[type="file"]').setInputFiles({name:`${client}-release-campaign.csv`,mimeType:"text/csv",buffer:bytes});
   try { await modal.locator('select[name="csv_delimiter"]:enabled').waitFor(); } catch (e) { diagnostics.push({client,modal:await modal.innerText()}); await shot(client,p,"upload-recovery-diagnostic-en"); throw e; }await modal.locator('select[name="csv_delimiter"]').selectOption("semicolon");await modal.locator('input[name="header_row"]').fill("3");await modal.getByRole("button",{name:"Apply header row",exact:true}).click();await modal.getByRole("button",{name:"Preview & validate",exact:true}).waitFor({state:"visible"});await until(()=>modal.getByRole("button",{name:"Preview & validate",exact:true}).isEnabled(),Boolean,"Selected original table");
   await modal.locator('select[name="source"]').selectOption("google_ads");await modal.locator('input[name="account_id"]').fill("HK-ADS");await modal.locator('input[name="attribution_definition"]').fill("7-day click");await modal.locator('input[name="conversion_definition"]').fill("Purchase");await modal.locator('select[name="number_format"]').selectOption("comma_decimal");await modal.locator('select[name="date_format"]').selectOption("day_first");
   recording=new WorkmateRecording(client,"reviewed-marketing-import",`marketing-release-148-${attempt}`,()=>p.screenshot({type:"jpeg",quality:72,timeout:15000}),"Actual source upload, explicit date/number conventions, exact parsed preview and durable analysis snapshot; synthetic campaign data",delivery);await recording.start();
   await modal.getByRole("button",{name:"Preview & validate",exact:true}).click();let parsed=modal.getByRole("region",{name:"Parsed data",exact:true});await parsed.waitFor();assert.match(await parsed.innerText(),/2026-10-01/);assert.match(await parsed.innerText(),/1234\.56000000/);assert.match(await parsed.innerText(),/4500\.25000000/);await parsed.scrollIntoViewIfNeeded();await shot(client,p,"parsed-exact-campaign-en");
   await modal.locator('select[name="date_format"]').selectOption("month_first");await parsed.waitFor({state:"detached"});assert.equal(await modal.getByRole("button",{name:"Confirm import",exact:true}).count(),0);
   await modal.locator('select[name="date_format"]').selectOption("day_first");await modal.getByRole("button",{name:"Preview & validate",exact:true}).click();await parsed.waitFor();await modal.locator('.marketing-preview input[type="checkbox"]').check();await modal.getByRole("button",{name:"Confirm import",exact:true}).click();await modal.waitFor({state:"hidden"});const analysis=p.locator("[data-snapshot-id]");await analysis.waitFor();const id=await analysis.getAttribute("data-snapshot-id");const d=(await system.db.control.query("SELECT * FROM analytics_datasets WHERE id=$1 AND project_id=$2",[id,project])).rows[0];assert.equal(d.source_sha256,sha(bytes));assert.equal(d.metric_snapshot.summary.exact.spend,"1234.56000000");assert.equal(d.import_spec.date_range.from,"2026-10-01");assert.equal(d.import_spec.file.encoding,"utf16le");assert.equal(d.import_spec.number_format,"comma_decimal");
   await analysis.scrollIntoViewIfNeeded();await shot(client,p,"durable-analysis-snapshot-en");await stopRecording();checks.push(`${client}: actual original UTF16 upload, selected preamble/table, explicit dates/numbers, exact preview, reset confirmation and durable Google Ads analysis`);
 }
 await campaign(web,"web");for(const width of[1440,390]){await web.setViewportSize({width,height:1000});const v=await web.evaluate(()=>({width:innerWidth,no_horizontal_overflow:document.documentElement.scrollWidth<=innerWidth}));assert.ok(v.no_horizontal_overflow);layouts.push({client:"web",...v});}
 stage="Packaged frameless Desktop PKCE and reviewed import";electron=await _electron.launch({executablePath:process.env.COPYPASTE_LOCAL_DESKTOP_CANDIDATE!,env:{...process.env,COPYPASTE_USER_DATA:path.join(owned,"desktop")}});const desktop=await electron.firstWindow();desktop.setDefaultTimeout(25000);desktop.on("pageerror",e=>errors.push(e.message));await desktop.waitForURL(/^file:/);await desktop.evaluate(({tenant,project})=>{localStorage.setItem("cp_locale","en");localStorage.setItem("cp_theme","light");localStorage.setItem("cp_tenant",tenant);localStorage.setItem("cp_project",project);},{tenant,project});await desktop.reload();await electron.evaluate(({shell}:any)=>{shell.openExternal=async(url:string)=>{(globalThis as any).__release148Auth=url;};});await desktop.getByRole("button",{name:"Sign in securely in your browser",exact:true}).click();const auth=await context.newPage();await auth.goto(await until(()=>electron!.evaluate(()=>(globalThis as any).__release148Auth),Boolean,"Actual PKCE URL"));await auth.getByRole("link",{name:/Authorize & return|授權並返回應用/}).click();await desktop.locator(".app-shell").waitFor();await auth.close();checks.push("Actual packaged Windows Desktop browser authorization and native PKCE");
 await campaign(desktop,"desktop");for(const width of[1360,1000]){await electron.evaluate(({BrowserWindow}:any,w:number)=>BrowserWindow.getAllWindows()[0].setSize(w,960),width);const v=await desktop.evaluate(()=>({width:innerWidth,no_horizontal_overflow:document.documentElement.scrollWidth<=innerWidth,rails_hidden:[...document.querySelectorAll(".sidebar,.main-content")].every(n=>getComputedStyle(n).scrollbarWidth==="none")}));assert.ok(v.no_horizontal_overflow);assert.ok(v.rails_hidden);layouts.push({client:"desktop",...v});}assert.equal(await electron.evaluate(({BrowserWindow}:any)=>BrowserWindow.getAllWindows()[0].isMenuBarVisible()),false);
}catch(e){errors.push(stage+": "+String(e));}finally{
 clearTimeout(timer);try{await stopRecording();}catch(e){errors.push(String(e));}if(electron)try{await electron.close();desktopClosed=true;}catch(e){errors.push(String(e));}if(browser)try{await browser.close();browserClosed=true;}catch(e){errors.push(String(e));}if(system)try{await system.app.close();apiClosed=true;}catch(e){errors.push(String(e));}if(isolated)try{await isolated.cleanup();fixtureClosed=true;}catch(e){errors.push(String(e));}process.chdir(delivery);
 const result={at:new Date().toISOString(),status:!errors.length&&checks.length===4&&browserClosed&&desktopClosed&&apiClosed&&fixtureClosed?"passed":"failed",checks,errors,diagnostics,screenshots,recordings,layouts,browser_closed:browserClosed,desktop_closed:desktopClosed,api_closed:apiClosed,fixture_closed:fixtureClosed,scope:"User-authorized focused first-release smoke. Actual Web and packaged Desktop OTP/PKCE and marketing file-to-analysis flow. Explicit synthetic data; broad native/model/extension regression retained as historical Stage147 evidence, not rerun."};await writeFile(path.join(delivery,prefix+"-journey.json"),JSON.stringify(result,null,2)+"\n",{flag:"wx"});console.log(JSON.stringify({status:result.status,checks:checks.length,errors}));process.exitCode=result.status==="passed"?0:1;
}
