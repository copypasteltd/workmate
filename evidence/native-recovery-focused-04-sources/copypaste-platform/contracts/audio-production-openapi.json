  "components": {
    "schemas": {
      "Cue": {
        "type": "object",
        "properties": {
          "start_ms": {
            "type": "integer",
            "minimum": 0
          },
          "end_ms": {
            "type": "integer",
            "minimum": 1
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "start_ms",
          "end_ms",
          "text"
        ],
        "additionalProperties": false
      },
      "SubtitleEdit": {
        "type": "object",
        "properties": {
          "expected_revision": {
            "type": "integer",
            "minimum": 1
          },
          "text": {
            "type": "string",
            "maxLength": 200000
          },
          "cues": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Cue"
            },
            "maxItems": 2000
          },
          "reason": {
            "type": "string",
            "minLength": 3,
            "maxLength": 1000
          }
        },
        "required": [
          "expected_revision",
          "text",
          "cues",
          "reason"
        ],
        "additionalProperties": false
      },
      "Cancel": {
        "type": "object",
        "properties": {
          "expected_revision": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "expected_revision"
        ],
        "additionalProperties": false
      },
      "Asset": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "audio",
              "transcript",
              "raw_response",
              "srt",
              "vtt"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "asset_version_id": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "mime_type": {
            "type": "string"
          },
          "bytes": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "kind",
          "revision",
          "id",
          "name",
          "asset_version_id",
          "version",
          "mime_type",
          "bytes",
          "sha256"
        ],
        "additionalProperties": false
      },
      "Transcript": {
        "type": "object",
        "properties": {
          "schema_version": {
            "const": 1
          },
          "text": {
            "type": "string"
          },
          "cues": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Cue"
            },
            "maxItems": 2000
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 1
          },
          "timing_source": {
            "enum": [
              "none",
              "provider_segments_rounded_to_millisecond",
              "customer_manual_revision"
            ]
          },
          "audio_job_id": {
            "type": "string",
            "format": "uuid"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "previous_revision": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "schema_version",
          "text",
          "cues",
          "duration_ms",
          "timing_source",
          "audio_job_id",
          "revision"
        ],
        "additionalProperties": false
      },
      "Preview": {
        "type": "object",
        "properties": {
          "content_type": {
            "type": "string"
          },
          "base64": {
            "type": "string",
            "contentEncoding": "base64"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "ai_generated": {
            "type": "boolean"
          },
          "document": {
            "$ref": "#/components/schemas/Transcript"
          }
        },
        "required": [
          "content_type",
          "base64",
          "bytes",
          "sha256",
          "ai_generated"
        ],
        "additionalProperties": false
      },
      "Job": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "task_id": {
            "type": "string",
            "format": "uuid"
          },
          "operation_id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "enum": [
              "speech",
              "transcription"
            ]
          },
          "state": {
            "enum": [
              "prepared",
              "dispatched",
              "completed",
              "cancelled",
              "unknown"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "subtitle_revision": {
            "type": "integer",
            "minimum": 0
          },
          "model_alias": {
            "type": "string"
          },
          "capability_version_id": {
            "type": "string",
            "format": "uuid"
          },
          "data_mode": {
            "enum": [
              "configured_services",
              "simulated"
            ]
          },
          "quoted_micros": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "actual_micros": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9]+$"
              },
              {
                "type": "null"
              }
            ]
          },
          "pricing_unit": {
            "enum": [
              "unicode_scalar",
              "input_millisecond"
            ]
          },
          "quoted_units": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "billable_units": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9]+$"
              },
              {
                "type": "null"
              }
            ]
          },
          "usage_state": {
            "enum": [
              "confirmed_company_tariff",
              "awaiting_confirmation"
            ]
          },
          "supplier_cost_micros": {
            "type": "null"
          },
          "duration_ms": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "decoded_media": {
            "anyOf": [
              {
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "delivery_state": {
            "enum": [
              "pending",
              "available",
              "blocked"
            ]
          },
          "cancel_requested": {
            "type": "boolean"
          },
          "assets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Asset"
            }
