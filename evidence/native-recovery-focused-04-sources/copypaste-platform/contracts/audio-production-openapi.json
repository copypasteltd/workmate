              }
            }
          },
          "400": {
            "description": "Strict input or query invalid"
          },
          "401": {
            "description": "Current session required"
          },
          "403": {
            "description": "Current scoped authority unavailable"
          },
          "404": {
            "description": "Original job or source-bound artifact unavailable"
          },
          "409": {
