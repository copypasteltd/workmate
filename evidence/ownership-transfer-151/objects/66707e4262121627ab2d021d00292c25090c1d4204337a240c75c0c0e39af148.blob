import assert from "node:assert/strict";
import {chromium,_electron,type Page,type Browser,type ElectronApplication,type BrowserContext} from "playwright";
import {readFile,writeFile} from "node:fs/promises";
import {randomUUID} from "node:crypto";
import {pathToFileURL} from "node:url";
import path from "node:path";
import {WorkmateRecording,saveWorkmateScreenshot} from "./record-workmate-media.js";
const delivery=process.cwd(),platform=path.resolve("../copypaste-platform"),attempt=process.argv[2],prefix=`evidence/ownership-transfer-151/ui-${attempt}`,owned=process.env.COPYPASTE_BUSINESS_INPUTS_OWNED!;
assert.match(attempt??"",/^\d{2}$/);
const load=(f:string)=>import(pathToFileURL(path.join(platform,f)).href),checks:string[]=[],screenshots:any[]=[],recordings:any[]=[],layouts:any[]=[],errors:string[]=[],diagnostics:any[]=[];
let isolated:any,system:any,browser:Browser|undefined,electron:ElectronApplication|undefined,recording:WorkmateRecording|undefined;
let browserClosed=false,desktopClosed=false,apiClosed=false,fixtureClosed=false,stage="setup";
async function until(fn:()=>Promise<any>,valid:(x:any)=>boolean,label:string){const end=Date.now()+45000;for(;;){const x=await fn();if(valid(x))return x;assert.ok(Date.now()<end,label);await new Promise(r=>setTimeout(r,100));}}
function observe(p:Page){p.setDefaultTimeout(25000);p.on("pageerror",e=>errors.push(e.message));p.on("response",async r=>{if(r.status()>=400&&r.url().includes("/v1/"))diagnostics.push({path:new URL(r.url()).pathname,status:r.status(),body:(await r.text().catch(()=>"")).slice(0,1200)});});}
async function shot(client:string,p:Page,name:string){screenshots.push(await saveWorkmateScreenshot(client,`ownership-transfer-151-${attempt}`,name,await p.screenshot({timeout:15000}),"Actual Web, packaged frameless Desktop or MFA Admin ownership handover; explicit synthetic customers, real HTTP/SQL, no model call",delivery));}
async function stopRecording(){if(recording){const r=recording;recording=undefined;recordings.push(await r.stop());}}
async function login(p:Page,email:string){
 await p.goto("http://localhost:4317/login");await p.locator('input[name="email"]').fill(email);
 const [response]=await Promise.all([p.waitForResponse(r=>new URL(r.url()).pathname==="/v1/auth/challenges"),p.locator('form button[type="submit"]').click()]);assert.equal(response.status(),202);
 const c=await response.json(),mail=JSON.parse(await readFile(path.join(isolated.directory,"mailbox",c.challenge_id+".json"),"utf8"));await p.locator('input[name="code"]').fill(mail.text.match(/\b\d{6}\b/)[0]);await p.locator('form button[type="submit"]').click();
}
async function context(){const c=await browser!.newContext({viewport:{width:1440,height:1000}});await c.addInitScript(()=>{localStorage.setItem("cp_locale","en");localStorage.setItem("cp_theme","light");});return c;}
const timer=setTimeout(()=>{errors.push("Focused handover journey deadline");void electron?.close();void browser?.close();},480000);
try{
 const [{isolatedTestEnvironment},{buildApp},{loadConfig}]=await Promise.all([load("tests/native-test-environment.ts"),load("src/server.ts"),load("src/config.ts")]);process.chdir(platform);isolated=await isolatedTestEnvironment();
 system=await buildApp(loadConfig({...isolated.env,NODE_ENV:"test",WORKER_ENABLED:"false",DEMO_MODE:"true",DEV_MAILBOX:"true",API_ORIGIN:"http://localhost:4310",WEB_ORIGIN:"http://localhost:4317",ADMIN_ORIGIN:"http://localhost:4318"}),{worker:false});await system.app.listen({host:"127.0.0.1",port:4310});
 browser=await chromium.launch({executablePath:process.env.CHROME_BIN,headless:true});const sourceContext=await context(),web=await sourceContext.newPage();observe(web);
 stage="Actual owner Web email OTP and onboarding";const ownerEmail=`handover-owner-${randomUUID()}@example.invalid`;await login(web,ownerEmail);await web.waitForURL("**/welcome");await web.locator('input[name="name"]').fill("CopyPaste Harbour Studio");await web.locator('input[name="project_name"]').fill("Launch campaign");
 const [created]=await Promise.all([web.waitForResponse(r=>new URL(r.url()).pathname==="/v1/tenants"&&r.request().method()==="POST"),web.getByRole("button",{name:"Create workspace & continue",exact:true}).click()]);assert.equal(created.status(),200);const workspace=await created.json(),tenant=workspace.tenant.id,project=workspace.project.id;
 await web.locator(".app-shell").waitFor();const owner=(await system.db.control.query("SELECT id FROM users WHERE email=$1",[ownerEmail])).rows[0].id;checks.push("Actual Web owner email OTP and workspace onboarding");
 const recipientEmail=`handover-recipient-${randomUUID()}@example.invalid`,recipient=(await system.db.control.query("INSERT INTO users(email,name) VALUES($1,'Harbour new owner') RETURNING id",[recipientEmail])).rows[0].id;
 const membership=(await system.db.control.query("INSERT INTO memberships(tenant_id,user_id,role) VALUES($1,$2,'member') RETURNING id",[tenant,recipient])).rows[0].id;await system.db.control.query("INSERT INTO project_members(tenant_id,project_id,user_id,role) VALUES($1,$2,$3,'editor')",[tenant,project,recipient]);
 async function requestFrom(p:Page,user:string){
  await p.goto("http://localhost:4317/app/members");const id=(await system.db.control.query("SELECT id FROM memberships WHERE tenant_id=$1 AND user_id=$2",[tenant,user])).rows[0].id;
  await p.locator(`[data-member-id="${id}"]`).getByRole("button",{name:"Transfer ownership",exact:true}).click();const modal=p.getByRole("dialog");await modal.getByLabel("Type the current workspace name",{exact:true}).fill("CopyPaste Harbour Studio");await modal.getByRole("checkbox").check();return modal;
 }
 stage="Actual packaged Desktop PKCE for original owner";
 electron=await _electron.launch({executablePath:process.env.COPYPASTE_LOCAL_DESKTOP_CANDIDATE!,env:{...process.env,COPYPASTE_USER_DATA:path.join(owned,"desktop")}});const desktop=await electron.firstWindow();observe(desktop);await desktop.waitForURL(/^file:/);await desktop.evaluate(({tenant,project})=>{localStorage.setItem("cp_locale","en");localStorage.setItem("cp_theme","light");localStorage.setItem("cp_tenant",tenant);localStorage.setItem("cp_project",project);},{tenant,project});await desktop.reload();
 await electron.evaluate(({shell}:any)=>{shell.openExternal=async(url:string)=>{(globalThis as any).__ownership151Auth=url;};});await desktop.getByRole("button",{name:"Sign in securely in your browser",exact:true}).click();const auth=await sourceContext.newPage();try{await auth.goto(await until(()=>electron!.evaluate(()=>(globalThis as any).__ownership151Auth),Boolean,"Native authorization URL"));await auth.getByRole("link",{name:/Authorize & return|授權並返回應用/}).click();await desktop.locator(".app-shell").waitFor();}finally{await auth.close();}checks.push("Actual packaged frameless Desktop native PKCE using the signed-in owner browser");
 stage="Web exact recipient and handover confirmation";let recordedWeb=web;
 recording=new WorkmateRecording("web","ownership-handover",`ownership-transfer-151-${attempt}`,()=>recordedWeb.screenshot({type:"jpeg",quality:72,timeout:15000}),"Actual source confirmation and recipient acceptance; no OTP or sign-in credential is recorded",delivery);await recording.start();
 const requestModal=await requestFrom(web,recipient);await shot("web",web,"request-handover-en.png");await requestModal.getByRole("button",{name:"Request handover",exact:true}).click();await requestModal.waitFor({state:"hidden"});
 const first=(await system.db.control.query("SELECT * FROM ownership_transfers WHERE tenant_id=$1 ORDER BY created_at DESC LIMIT 1",[tenant])).rows[0];assert.equal(first.state,"pending");assert.equal((await system.db.control.query("SELECT role FROM memberships WHERE tenant_id=$1 AND user_id=$2",[tenant,owner])).rows[0].role,"owner");checks.push("Web source exact-name and recipient confirmation creates pending intent without granting roles");
 stage="Recipient actual Web OTP and personal acceptance";const recipientContext=await context(),recipientPage=await recipientContext.newPage();observe(recipientPage);await login(recipientPage,recipientEmail);await recipientPage.locator(".app-shell").waitFor();recordedWeb=recipientPage;
 await recipientPage.locator(".ownership-notice").getByRole("link",{name:"Review handover",exact:true}).click();await recipientPage.locator(`[data-transfer-id="${first.id}"]`).getByRole("button",{name:"Accept ownership",exact:true}).click();const accept=recipientPage.getByRole("dialog");await accept.getByRole("checkbox").check();await accept.getByRole("button",{name:"Confirm acceptance",exact:true}).click();await accept.waitFor({state:"hidden"});await recipientPage.locator(`[data-transfer-id="${first.id}"]`).getByText("Handover completed",{exact:true}).waitFor();
 assert.equal((await system.db.control.query("SELECT role FROM memberships WHERE tenant_id=$1 AND user_id=$2",[tenant,recipient])).rows[0].role,"owner");await shot("web",recipientPage,"recipient-accepted-en.png");await stopRecording();checks.push("Actual recipient Web email OTP, discoverable inbox, personal acceptance and original-owner demotion");
 stage="Desktop reverse handover acceptance through native management bridge";const reverse=await requestFrom(recipientPage,owner);await reverse.getByRole("button",{name:"Request handover",exact:true}).click();await reverse.waitFor({state:"hidden"});const second=(await system.db.control.query("SELECT * FROM ownership_transfers WHERE tenant_id=$1 AND state='pending'",[tenant])).rows[0];
 await desktop.reload();await desktop.evaluate(()=>{location.hash="/app/members";});await desktop.locator(`[data-transfer-id="${second.id}"]`).getByRole("button",{name:"Accept ownership",exact:true}).waitFor();
 recording=new WorkmateRecording("desktop","ownership-handover",`ownership-transfer-151-${attempt}`,()=>desktop.screenshot({type:"jpeg",quality:72,timeout:15000}),"Actual packaged Desktop receives and personally confirms the reverse handover",delivery);await recording.start();await desktop.locator(`[data-transfer-id="${second.id}"]`).getByRole("button",{name:"Accept ownership",exact:true}).click();const nativeModal=desktop.getByRole("dialog");await nativeModal.getByRole("checkbox").check();await shot("desktop",desktop,"confirm-ownership-en.png");await nativeModal.getByRole("button",{name:"Confirm acceptance",exact:true}).click();await nativeModal.waitFor({state:"hidden"});await desktop.locator(`[data-transfer-id="${second.id}"]`).getByText("Handover completed",{exact:true}).waitFor();await shot("desktop",desktop,"ownership-accepted-en.png");await stopRecording();
 assert.equal(await electron.evaluate(({BrowserWindow}:any)=>BrowserWindow.getAllWindows()[0].isMenuBarVisible()),false);for(const width of[1360,1000]){await electron.evaluate(({BrowserWindow}:any,w:number)=>BrowserWindow.getAllWindows()[0].setSize(w,960),width);const v=await desktop.evaluate(()=>({width:innerWidth,no_horizontal_overflow:document.documentElement.scrollWidth<=innerWidth,rails_hidden:[...document.querySelectorAll('.sidebar,.main-content')].every(n=>getComputedStyle(n).scrollbarWidth==='none')}));assert.ok(v.no_horizontal_overflow&&v.rails_hidden);layouts.push({client:"desktop",...v});}checks.push("Actual native Desktop acceptance changes both roles, keeps hidden native menu and no horizontal overflow");
 stage="Administrator MFA inspection and cancellation in existing membership manager";const pending=await requestFrom(web,recipient);await pending.getByRole("button",{name:"Request handover",exact:true}).click();await pending.waitFor({state:"hidden"});const third=(await system.db.control.query("SELECT * FROM ownership_transfers WHERE tenant_id=$1 AND state='pending'",[tenant])).rows[0];
 const {historyAdmin}=await load("tests/admin-history-fixture.ts"),operator=await historyAdmin(system,project,system.catalog.admin.permissions.map((p:any)=>p.key));await system.db.control.query("INSERT INTO admin_bindings(principal_id,role_key,scope_kind,scope_id) VALUES($1,$2,'tenant',$3)",[operator.id,operator.role,tenant]);const adminContext=await context(),cookie=operator.client.cookie.split('=');await adminContext.addCookies([{name:cookie[0],value:cookie.slice(1).join('='),url:"http://localhost:4318",httpOnly:true,sameSite:"Lax"}]);const admin=await adminContext.newPage();observe(admin);await admin.goto(`http://localhost:4318/users/${recipient}`);await admin.getByRole("button",{name:"Manage membership",exact:true}).click();const management=admin.getByRole("region",{name:"Ownership handover management",exact:true});await management.locator(`[data-transfer-id="${third.id}"]`).waitFor();
 recording=new WorkmateRecording("admin","ownership-handover",`ownership-transfer-151-${attempt}`,()=>admin.screenshot({type:"jpeg",quality:72,timeout:15000}),"Actual MFA Admin inspects and cancels pending customer handover without granting roles",delivery);await recording.start();const row=management.locator(`[data-transfer-id="${third.id}"]`);await row.locator("summary").click();await row.getByRole("checkbox").check();await shot("admin",admin,"cancel-handover-en.png");await row.getByRole("button",{name:"Confirm handover cancellation",exact:true}).click();await row.getByText("Cancelled",{exact:true}).waitFor();await shot("admin",admin,"handover-cancelled-en.png");await stopRecording();
 assert.equal((await system.db.control.query("SELECT role FROM memberships WHERE tenant_id=$1 AND user_id=$2",[tenant,owner])).rows[0].role,"owner");checks.push("Actual scoped MFA Admin cancellation through existing membership manager preserves current ownership");
 for(const width of[1440,390]){await recipientPage.setViewportSize({width,height:1000});const v=await recipientPage.evaluate(()=>({width:innerWidth,no_horizontal_overflow:document.documentElement.scrollWidth<=innerWidth}));assert.ok(v.no_horizontal_overflow);layouts.push({client:"web",...v});}
}catch(e){errors.push(stage+": "+String(e));}finally{
 clearTimeout(timer);try{await stopRecording();}catch(e){errors.push(String(e));}if(electron)try{await electron.close();desktopClosed=true;}catch(e){errors.push(String(e));}if(browser)try{await browser.close();browserClosed=true;}catch(e){errors.push(String(e));}if(system)try{await system.app.close();apiClosed=true;}catch(e){errors.push(String(e));}if(isolated)try{await isolated.cleanup();fixtureClosed=true;}catch(e){errors.push(String(e));}process.chdir(delivery);
 const result={at:new Date().toISOString(),status:!errors.length&&checks.length===6&&browserClosed&&desktopClosed&&apiClosed&&fixtureClosed?"passed":"failed",checks,errors,diagnostics,screenshots,recordings,layouts,browser_closed:browserClosed,desktop_closed:desktopClosed,api_closed:apiClosed,fixture_closed:fixtureClosed,scope:"Actual Web/recipient email OTP, native Desktop PKCE, source and recipient ownership handovers and current-scope MFA admin cancellation; no AI model call or full-product acceptance."};await writeFile(prefix+"-journey.json",JSON.stringify(result,null,2)+"\n",{flag:"wx"});console.log(JSON.stringify({status:result.status,checks:checks.length,errors}));process.exitCode=result.status==="passed"?0:1;
}
