            "format": "uuid"
          },
          "spec_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "source_spec_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "source_result_version_id": {
            "type": "string",
            "format": "uuid"
          },
          "source_result_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "data_mode": {
            "type": "string",
            "enum": [
              "simulated",
              "configured_services"
            ]
          },
          "state": {
            "type": "string",
            "const": "draft"
          },
          "website_modified": {
            "type": "boolean",
            "const": false
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "objective": {
            "type": "string",
            "minLength": 5,
            "maxLength": 8000
          },
          "coverage": {
            "$ref": "#/components/schemas/SeoCoverage"
          },
          "changes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object",
              "properties": {
                "finding_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "rationale": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "proposed_change": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8000
                },
                "verification": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 12,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  }
                },
                "evidence": {
                  "$ref": "#/components/schemas/SeoFinding"
                }
              },
              "required": [
                "finding_id",
                "rationale",
                "proposed_change",
                "verification",
                "evidence"
              ],
              "additionalProperties": false
            }
          },
          "limitations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "schema_version",
          "change_id",
          "task_id",
          "audit_id",
          "spec_hash",
          "source_spec_hash",
          "source_result_version_id",
          "source_result_sha256",
          "created_at",
          "data_mode",
          "state",
          "website_modified",
          "title",
          "objective",
          "coverage",
          "changes",
          "limitations"
        ],
        "additionalProperties": false
      },
      "SeoFinding": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "key": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "code": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "error",
              "warning",
              "info"
            ]
          },
          "url": {
            "type": "string"
          },
          "target_url": {
            "type": "string"
          },
          "source_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "related_source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "location": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "start": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "unit": {
                    "type": "string",
                    "const": "utf16_code_units"
                  },
                  "quote": {
                    "type": "string",
                    "maxLength": 400
                  }
                },
                "required": [
                  "start",
                  "end",
                  "unit",
                  "quote"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "key",
          "code",
          "severity",
          "url",
          "source_id",
          "related_source_ids",
          "location",
          "detail"
        ],
        "additionalProperties": false
      },
      "SeoCoverage": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "state": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "complete",
              "partial",
              "cancelled"
            ]
          },
          "page_requests": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "robots_requests": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "max_pages": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "byte_budget_used": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "states": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "data_mode": {
            "type": "string",
            "enum": [
              "simulated",
              "configured_services"
            ]
          }
        },
        "required": [
          "id",
          "state",
          "page_requests",
          "robots_requests",
          "max_pages",
          "byte_budget_used",
          "states",
          "limitations",
          "data_mode"
        ],
        "additionalProperties": false
      }
    }
  }
}
