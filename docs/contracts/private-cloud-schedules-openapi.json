  "components": {
    "schemas": {
      "ScheduleOptions": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "calendar": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "timezone": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "description": "Validated IANA zone."
              },
              "frequency": {
                "type": "string",
                "enum": [
                  "daily",
                  "weekly"
                ]
              },
              "time": {
                "type": "string",
                "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
              },
              "weekdays": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 7
                },
                "uniqueItems": true,
                "maxItems": 7,
                "default": [],
                "description": "ISO weekday numbers. Daily uses []; weekly requires at least one."
              }
            },
            "required": [
              "timezone",
              "frequency",
              "time"
            ]
          },
          "catch_up": {
            "type": "string",
            "enum": [
              "latest",
              "skip"
            ]
          },
          "starts_at": {
            "type": "string",
            "format": "date-time",
            "description": "Optional current/future start; omitted value is frozen on the first identical model request."
          },
          "ends_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "expected_output": {
            "type": "string",
            "minLength": 3,
            "maxLength": 1000
          }
        },
        "required": [
          "name",
          "calendar",
          "catch_up",
          "ends_at",
          "expected_output"
        ]
      },
