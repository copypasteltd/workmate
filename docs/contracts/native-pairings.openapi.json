{
  "openapi": "3.1.0",
  "info": {
    "title": "CopyPaste recoverable Desktop pairing",
    "version": "1.0.0",
    "description": "Create and retirement use distinct Ed25519 signatures. Creation requires a current Desktop session in the original credential family and active workspace authority. Retirement accepts expired/revoked original credentials, stores a permanent private tombstone, and never grants access or retires another family."
  },
  "x-runtime-schema-sha256": "729bd58f05a0bb396aa96d815948be705822878d92755486caf0a0a54d7be742",
  "paths": {
    "/v1/auth/native/device-pair": {
      "post": {
        "summary": "Pair a fixed native intent",
        "security": [
          {
            "NativeBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DesktopPairingRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Current device",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DesktopPairingReceipt"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/native/device-pair/retire": {
      "post": {
        "summary": "Permanently retire a proven intent, including an unacknowledged create",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DesktopPairingRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Private retired/unverified receipt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DesktopPairingRetirement"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "NativeBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "DesktopPairingRequest": {
        "type": "object",
        "properties": {
          "protocol": {
            "type": "string",
            "const": "copypaste.desktop-pairing.v1"
          },
          "refresh_token": {
            "type": "string",
            "pattern": "^[\\w-]{43}$"
          },
          "input": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "tenant_id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "public_key": {
                "type": "string",
                "minLength": 40,
                "maxLength": 2000
              },
              "grants": {
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160
                    },
                    "operations": {
                      "minItems": 1,
                      "maxItems": 3,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "file.list",
                          "file.read",
                          "file.write"
                        ]
                      }
                    },
                    "expires_at": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                    }
                  },
                  "required": [
                    "id",
                    "label",
                    "operations",
                    "expires_at"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "id",
              "tenant_id",
              "name",
              "public_key",
              "grants"
            ],
            "additionalProperties": false
          },
          "signature": {
            "type": "string",
            "pattern": "^[\\w-]{86}$"
          }
        },
        "required": [
          "protocol",
          "refresh_token",
          "input",
          "signature"
        ],
        "additionalProperties": false
      },
      "DesktopPairingReceipt": {
        "type": "object",
        "properties": {
          "pairing_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "device": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "client": {
                "type": "string",
                "const": "desktop"
              },
              "state": {
                "type": "string",
                "const": "active"
              },
              "grants": {
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160
                    },
                    "operations": {
                      "minItems": 1,
                      "maxItems": 3,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "file.list",
                          "file.read",
                          "file.write"
                        ]
                      }
                    },
                    "expires_at": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                    }
                  },
                  "required": [
                    "id",
                    "label",
                    "operations",
                    "expires_at"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "id",
              "name",
              "client",
              "state",
              "grants"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "pairing_id",
          "device"
        ],
        "additionalProperties": false
      },
      "DesktopPairingRetirement": {
        "type": "object",
        "properties": {
          "pairing_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "status": {
            "type": "string",
            "enum": [
              "retired",
              "unverified"
            ]
          }
        },
        "required": [
          "pairing_id",
          "status"
        ],
        "additionalProperties": false
      }
    }
  }
}
