{
  "openapi": "3.1.0",
  "info": {
    "title": "Workmate persistent Admin data jobs",
    "version": "103.1",
    "description": "Additive implemented contract. Legacy synchronous endpoints remain for compatibility; the product UI uses these persistent routes. Only frozen, whitelisted data is exported. Snapshots expire after 15 minutes; previews after 5 minutes. This scope does not add financial/VIP bulk mutations or certify live AI quality."
  },
  "paths": {
    "/v1/admin/data-jobs/previews": {
      "post": {
        "summary": "Freeze authorized record IDs, versions, field projection and encrypted rows",
        "security": [
          {
            "adminSession": []
          }
        ],
        "x-permissions": [
          "admin.jobs.create",
          "admin.exports.create OR admin.users.status.write",
          "source read permission"
        ],
        "x-current-scope-and-field-checks": true,
        "x-recent-mfa-seconds": 600,
        "responses": {
          "200": {
            "description": "Authorized result"
          },
          "400": {
            "description": "Invalid strict schema, filter, CSRF/origin or key"
          },
          "401": {
            "description": "Admin session required"
          },
          "403": {
            "description": "Current permission, binding or MFA rejected"
          },
          "404": {
            "description": "Owned authorized job or target not found"
          },
          "409": {
            "description": "Stale preview/target/revision/policy, reused preview/key, terminal state, oversized export or partial file not accepted"
          },
          "410": {
            "description": "Snapshot expired"
          }
        },
        "x-csrf-and-origin-check": true,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Command"
              }
            }
          }
        }
      }
    },
    "/v1/admin/data-jobs": {
      "post": {
        "summary": "Confirm the exact session-bound preview and queue the job",
        "security": [
          {
            "adminSession": []
          }
        ],
        "x-permissions": [
          "admin.jobs.create",
          "source action and read permissions"
        ],
        "x-current-scope-and-field-checks": true,
        "x-recent-mfa-seconds": 600,
        "responses": {
          "202": {
            "description": "Queued persistent job"
          },
          "400": {
            "description": "Invalid strict schema, filter, CSRF/origin or key"
          },
          "401": {
            "description": "Admin session required"
          },
          "403": {
            "description": "Current permission, binding or MFA rejected"
          },
          "404": {
            "description": "Owned authorized job or target not found"
          },
          "409": {
            "description": "Stale preview/target/revision/policy, reused preview/key, terminal state, oversized export or partial file not accepted"
          },
          "410": {
            "description": "Snapshot expired"
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 16,
              "maxLength": 128,
              "pattern": "^[\\w:-]+$"
            }
          }
        ],
        "x-csrf-and-origin-check": true,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Confirmation"
              }
            }
          }
        }
      },
      "get": {
        "summary": "List this administrator's jobs under current bindings",
        "security": [
          {
            "adminSession": []
          }
        ],
        "x-permissions": [
          "admin.jobs.read"
        ],
        "x-current-scope-and-field-checks": true,
        "x-recent-mfa-seconds": 600,
        "responses": {
          "200": {
            "description": "Authorized result"
          },
          "400": {
            "description": "Invalid strict schema, filter, CSRF/origin or key"
          },
          "401": {
            "description": "Admin session required"
          },
          "403": {
            "description": "Current permission, binding or MFA rejected"
          },
          "404": {
            "description": "Owned authorized job or target not found"
          },
          "409": {
            "description": "Stale preview/target/revision/policy, reused preview/key, terminal state, oversized export or partial file not accepted"
          },
          "410": {
            "description": "Snapshot expired"
          }
        },
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 30
            },
            "description": ""
          },
          {
            "name": "before",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Paired with before_id for stable tuple pagination"
          },
          {
            "name": "before_id",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Paired with before"
          }
        ]
      }
    },
    "/v1/admin/data-jobs/{id}": {
      "get": {
        "summary": "Read frozen manifest, paginated item outcomes and the latest 50 immutable events",
        "security": [
          {
            "adminSession": []
          }
        ],
        "x-permissions": [
          "admin.jobs.read",
          "source read/action permission"
        ],
        "x-current-scope-and-field-checks": true,
        "x-recent-mfa-seconds": 600,
        "responses": {
          "200": {
            "description": "Authorized result"
          },
          "400": {
            "description": "Invalid strict schema, filter, CSRF/origin or key"
          },
          "401": {
            "description": "Admin session required"
          },
          "403": {
            "description": "Current permission, binding or MFA rejected"
          },
          "404": {
            "description": "Owned authorized job or target not found"
          },
          "409": {
            "description": "Stale preview/target/revision/policy, reused preview/key, terminal state, oversized export or partial file not accepted"
          },
          "410": {
            "description": "Snapshot expired"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "description": ""
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            },
            "description": ""
          }
        ]
      }
    },
    "/v1/admin/data-jobs/{id}/cancel": {
      "post": {
        "summary": "Cancel pending items; preserve all committed effects",
        "security": [
          {
            "adminSession": []
          }
        ],
        "x-permissions": [
          "admin.jobs.read"
        ],
        "x-current-scope-and-field-checks": true,
        "x-recent-mfa-seconds": 600,
        "responses": {
          "200": {
            "description": "Authorized result"
          },
          "400": {
            "description": "Invalid strict schema, filter, CSRF/origin or key"
          },
          "401": {
            "description": "Admin session required"
          },
          "403": {
            "description": "Current permission, binding or MFA rejected"
          },
          "404": {
            "description": "Owned authorized job or target not found"
          },
          "409": {
            "description": "Stale preview/target/revision/policy, reused preview/key, terminal state, oversized export or partial file not accepted"
          },
          "410": {
            "description": "Snapshot expired"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "x-csrf-and-origin-check": true,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Control"
              }
            }
          }
        }
      }
    },
    "/v1/admin/data-jobs/{id}/reauthorize": {
      "post": {
        "summary": "Bind pending work to a fresh owner session while preserving the original access/policy",
        "security": [
          {
            "adminSession": []
          }
        ],
        "x-permissions": [
          "admin.jobs.read",
          "admin.jobs.create",
          "source permissions"
        ],
        "x-current-scope-and-field-checks": true,
        "x-recent-mfa-seconds": 600,
        "responses": {
          "200": {
            "description": "Authorized result"
          },
          "400": {
            "description": "Invalid strict schema, filter, CSRF/origin or key"
          },
          "401": {
            "description": "Admin session required"
          },
          "403": {
            "description": "Current permission, binding or MFA rejected"
          },
          "404": {
            "description": "Owned authorized job or target not found"
          },
          "409": {
            "description": "Stale preview/target/revision/policy, reused preview/key, terminal state, oversized export or partial file not accepted"
          },
          "410": {
            "description": "Snapshot expired"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "x-csrf-and-origin-check": true,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Control"
              }
            }
          }
        }
      }
    },
    "/v1/admin/data-jobs/{id}/retry-previews": {
      "post": {
        "summary": "Review current versions of failed targets only; confirmation creates one child per parent",
        "security": [
          {
            "adminSession": []
          }
        ],
        "x-permissions": [
          "admin.jobs.read",
          "admin.jobs.create",
          "source permissions"
        ],
        "x-current-scope-and-field-checks": true,
        "x-recent-mfa-seconds": 600,
        "responses": {
          "200": {
            "description": "Authorized result"
          },
          "400": {
            "description": "Invalid strict schema, filter, CSRF/origin or key"
          },
          "401": {
            "description": "Admin session required"
          },
          "403": {
            "description": "Current permission, binding or MFA rejected"
          },
          "404": {
            "description": "Owned authorized job or target not found"
          },
          "409": {
            "description": "Stale preview/target/revision/policy, reused preview/key, terminal state, oversized export or partial file not accepted"
          },
          "410": {
            "description": "Snapshot expired"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "x-csrf-and-origin-check": true,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Control"
              }
            }
          }
        }
      }
    },
    "/v1/admin/data-jobs/{id}/download": {
      "get": {
        "summary": "Recheck each frozen record and current field/download authority, then return CSV or exact manifest",
        "security": [
          {
            "adminSession": []
          }
        ],
        "x-permissions": [
          "admin.jobs.read",
          "admin.exports.create",
          "admin.exports.download",
          "source read permission"
        ],
        "x-current-scope-and-field-checks": true,
        "x-recent-mfa-seconds": 600,
        "responses": {
          "200": {
            "description": "Private no-store attachment; UTF-8 BOM CSV neutralizes leading spreadsheet formulas, or JSON manifest declares exact IDs, hashes, counts and filters",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid strict schema, filter, CSRF/origin or key"
          },
          "401": {
            "description": "Admin session required"
          },
          "403": {
            "description": "Current permission, binding or MFA rejected"
          },
          "404": {
            "description": "Owned authorized job or target not found"
          },
          "409": {
            "description": "Stale preview/target/revision/policy, reused preview/key, terminal state, oversized export or partial file not accepted"
          },
          "410": {
            "description": "Snapshot expired"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "format",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "csv",
                "manifest"
              ],
              "default": "csv"
            },
            "description": ""
          },
          {
            "name": "accept_partial",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "true"
              ]
            },
            "description": "Explicit opt-in for a partially successful export; failed records are excluded"
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Command": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "export"
              },
              "source": {
                "type": "string",
                "enum": [
                  "users",
                  "usage",
                  "billing",
                  "audit"
                ]
              },
              "filters": {
                "default": {},
                "type": "object",
                "properties": {
                  "q": {
                    "type": "string",
                    "maxLength": 160
                  },
                  "tenant_id": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "project_id": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "user_id": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "state": {
                    "type": "string",
                    "enum": [
                      "active",
                      "frozen",
                      "closed"
                    ]
                  },
                  "created_from": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                  },
                  "created_to": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                  }
                },
                "additionalProperties": false
              },
              "reason": {
                "type": "string",
                "minLength": 3,
                "maxLength": 1000
              }
            },
            "required": [
              "kind",
              "source",
              "filters",
              "reason"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "users.status"
              },
              "ids": {
                "minItems": 1,
                "maxItems": 100,
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                }
              },
              "state": {
                "type": "string",
                "enum": [
                  "active",
                  "frozen"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 3,
                "maxLength": 1000
              }
            },
            "required": [
              "kind",
              "ids",
              "state",
              "reason"
            ],
            "additionalProperties": false
          }
        ],
        "description": "Strict source-specific filters: state only applies to users; audit rejects project_id/user_id. Date end must follow start. Account batches contain unique UUIDs, at most 100, and cannot close or reopen closed accounts. Export previews select at most 10000 records without truncation."
      },
      "Confirmation": {
        "type": "object",
        "properties": {
          "preview_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "definition_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "preview_id",
          "definition_hash"
        ],
        "additionalProperties": false
      },
      "Control": {
        "type": "object",
        "properties": {
          "expected_revision": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "reason": {
            "type": "string",
            "minLength": 3,
            "maxLength": 1000
          }
        },
        "required": [
          "expected_revision",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "adminSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "cp_admin_session"
      }
    }
  }
}
