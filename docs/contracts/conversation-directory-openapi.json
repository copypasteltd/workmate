{
  "openapi": "3.1.0",
  "info": {
    "title": "Workmate private conversation directory supplement",
    "version": "156"
  },
  "paths": {
    "/v1/conversations": {
      "get": {
        "summary": "Browse currently authorized private conversations",
        "parameters": [
          {
            "name": "X-Tenant-ID",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "project_id",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 160
            }
          },
          {
            "name": "archived",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 40
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          }
        ],
        "responses": {
          "200": {
            "description": "No-store items and next_cursor; canonical fields conform to frozen Conversation schema"
          },
          "400": {
            "description": "Invalid cursor/query or mismatched actor, session, scope or filters"
          },
          "401": {
            "description": "Current session unavailable"
          },
          "403": {
            "description": "Current authority denied"
          },
          "404": {
            "description": "Project or authorized scope unavailable"
          },
          "409": {
            "description": "Cursor expired; refresh directory"
          }
        }
      }
    },
    "/v1/tenants/{tenant}/projects/{project}/conversations": {
      "get": {
        "summary": "Browse currently authorized private conversations",
        "parameters": [
          {
            "name": "tenant",
