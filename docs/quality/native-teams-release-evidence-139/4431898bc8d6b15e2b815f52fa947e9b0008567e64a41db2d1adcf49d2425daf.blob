* text=auto eol=lf
*.png binary
*.jpg binary
*.woff2 binary

# Raw evidence digests must survive checkout on every operating system.
evidence/** -text whitespace=cr-at-eol

# Executed native pairing verifiers retain their qualified byte digests.
scripts/*native-pairing* -text whitespace=cr-at-eol

# Keep executed folder journeys and the proof-aware publisher byte-for-byte.
scripts/*extension-folder* -text whitespace=cr-at-eol
scripts/publish-workmate-v2.mjs -text whitespace=cr-at-eol
tests/publication-proofs.test.mjs -text whitespace=cr-at-eol
scripts/*integrated-recovery* -text whitespace=cr-at-eol
scripts/publish-workmate-v3.mjs -text whitespace=cr-at-eol

# Preserve exact dedicated-computer verifiers and their original source receipts.
scripts/*dedicated* -text whitespace=cr-at-eol
scripts/qualify-delivered-clients-v1.mjs -text whitespace=cr-at-eol
scripts/publish-workmate-v4.mjs -text whitespace=cr-at-eol

# Retain original executed controlled-publication verifiers and capture helper.
scripts/*publications-* -text whitespace=cr-at-eol
scripts/qa-publication-consent-* -text whitespace=cr-at-eol
scripts/record-workmate-media.ts -text whitespace=cr-at-eol

# Bind the Stage125 publication executor without checkout conversions.
scripts/publish-workmate-v8.mjs -text whitespace=cr-at-eol

# Bind the native-publication executor without checkout conversions.
scripts/publish-workmate-v9.mjs -text whitespace=cr-at-eol

# Original Stage132 snapshots and tool logs retain upstream whitespace exactly.
evidence/content-history-132/objects/** -diff -text -whitespace
evidence/content-history-132/*.tap -text -whitespace

# Keep Stage133 original source snapshots and native tool output byte-identical.
evidence/support-access-133/objects/** -diff -text -whitespace
evidence/support-access-133/*.tap -text -whitespace

# Exact Stage134 recovery source snapshots and original native tool logs.
evidence/support-recovery-134/objects/** -diff -text -whitespace
evidence/support-recovery-134/*.tap -text -whitespace

# Stage135 executed verifiers, sources and native/browser raw output are immutable.
evidence/client-errors-135/objects/** -diff -text -whitespace
evidence/client-errors-135/*.tap -text -whitespace

# Stage137 executable verifiers and their qualified package metadata retain exact bytes.
scripts/*delivery-package*137* -text whitespace=cr-at-eol
package.json -text whitespace=cr-at-eol
evidence/delivery-package-137/objects/** -diff -text -whitespace
evidence/delivery-package-137/*.tap -text -whitespace

# Preserve original Stage138 verifier and content-addressed evidence bytes.
scripts/*delivery-revision*138* -text whitespace=cr-at-eol
evidence/delivery-revision-138/objects/** -diff -text -whitespace
evidence/delivery-revision-138/*.tap -text -whitespace

# Stage139 executed verifiers and source receipts remain byte-identical.
scripts/*native-teams*139* -text whitespace=cr-at-eol
tsconfig.json -text whitespace=cr-at-eol
evidence/native-teams-139/objects/** -diff -text -whitespace
evidence/native-teams-139/*.tap -text -whitespace
