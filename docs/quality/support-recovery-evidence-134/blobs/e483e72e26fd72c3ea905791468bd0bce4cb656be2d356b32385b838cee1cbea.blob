.cloud-computers{display:grid;gap:30px;min-width:0}.cloud-computer-intro{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:24px;align-items:center;border:1px solid var(--line);border-radius:18px;background:var(--surface);padding:30px}.cloud-computer-mark{display:grid;place-items:center;width:78px;height:78px;border-radius:20px;background:var(--blue-soft);color:var(--blue)}.cloud-computer-intro h2{font-family:Fraunces,serif;font-size:26px;line-height:1.25;font-weight:500;margin:10px 0}.cloud-computer-intro p{max-width:570px;line-height:1.8;color:var(--muted);font-size:13px}.cloud-computer-intro-notes{display:grid;gap:18px;max-width:240px;font-size:12px}.cloud-computer-intro-notes span{display:flex;align-items:center;gap:9px}.cloud-computer-intro-notes svg{color:var(--blue);flex-shrink:0}.cloud-computer-section>header{display:flex;gap:14px;align-items:center;justify-content:space-between;margin-bottom:20px}.cloud-computer-section h2{font-size:20px;margin:0 0 8px}.cloud-computer-section>header p{font-size:13px;color:var(--muted);margin:0}.cloud-computer-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.cloud-computer-card{display:flex;flex-direction:column;text-align:left;min-width:0;border:1px solid var(--line);border-radius:14px;background:var(--surface);padding:24px;transition:border-color .16s,box-shadow .16s}.cloud-computer-card:hover{border-color:var(--blue);box-shadow:var(--shadow)}.cloud-computer-card>div:first-child{display:flex;align-items:center;justify-content:space-between;gap:10px}.cloud-computer-card>div>svg{color:var(--blue)}.cloud-computer-card h3{font-size:18px;margin:22px 0 10px}.cloud-computer-card p{color:var(--muted);font-size:13px;line-height:1.7;overflow-wrap:anywhere;margin:0 0 22px}.cloud-computer-card dl{margin:auto 0 0;display:grid;gap:10px;width:100%;font-size:12px}.cloud-computer-card dl>div{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap}.cloud-computer-card dt{color:var(--muted)}.cloud-computer-card dd{margin:0}.cloud-session-state{display:inline-flex;align-items:center;border-radius:99px;padding:6px 10px;font-size:11px;color:var(--muted);background:var(--warm)}.cloud-session-state.running{color:var(--green);background:color-mix(in srgb,var(--green) 9%,var(--surface))}.cloud-session-state.starting,.cloud-session-state.reconciling,.cloud-session-state.stop_requested{color:var(--blue);background:var(--blue-soft)}.cloud-computer-empty{display:grid;justify-items:center;text-align:center;padding:55px 22px;border:1px dashed var(--line);border-radius:16px}.cloud-computer-empty>svg{color:var(--muted)}.cloud-computer-empty h3{font-family:Fraunces,serif;font-size:26px;font-weight:500;margin:20px 0 8px}.cloud-computer-empty p{max-width:530px;color:var(--muted);font-size:13px;line-height:1.8}.cloud-computer-section>footer{display:flex;justify-content:flex-end;gap:10px;margin-top:18px}.cloud-computer-create form{display:grid;gap:18px}.cloud-computer-create .field{margin:0}.cloud-computer-form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.cloud-plan-summary{font-size:12px;line-height:1.8;color:var(--muted);margin:0}.cloud-plan-summary span{display:block;color:var(--blue)}.cloud-control-choices{display:flex;flex-wrap:wrap;gap:16px}.cloud-control-choices label{display:flex;align-items:center;gap:8px;font-size:13px}.cloud-control-choices input,.cloud-explicit-consent input,.cloud-source-list input{width:16px;flex-shrink:0;accent-color:var(--blue)}.cloud-selected-files{border:1px solid var(--line);border-radius:12px;padding:14px}.cloud-selected-files>div{display:flex;align-items:center;gap:8px;min-width:0}.cloud-selected-files>div:first-child{justify-content:space-between}.cloud-selected-files b{font-size:13px}.cloud-selected-files p{font-size:12px;line-height:1.8;color:var(--muted)}.cloud-selected-files span{font-size:13px;overflow-wrap:anywhere;flex:1}.cloud-selected-files small,.cloud-source-list small{display:block;color:var(--muted);font-size:11px;margin-top:4px}.cloud-quote-price{display:grid;justify-items:center;gap:10px;background:var(--blue-soft);color:var(--blue);padding:24px;border-radius:14px;margin-bottom:20px}.cloud-quote-price strong{font-size:34px;font-weight:600;letter-spacing:-1px}.cloud-quote-price small{max-width:350px;text-align:center;font-size:12px;line-height:1.7}.cloud-quote-details{margin:0;display:grid;gap:15px}.cloud-quote-details>div{display:grid;grid-template-columns:100px minmax(0,1fr);gap:14px;font-size:13px}.cloud-quote-details dt{color:var(--muted)}.cloud-quote-details dd{margin:0;overflow-wrap:anywhere;line-height:1.7}.cloud-explicit-consent{display:flex;align-items:flex-start;gap:10px;font-size:12px;line-height:1.8;margin:24px 0}.cloud-source-list{display:grid;gap:12px;margin:20px 0}.cloud-source-list label{display:flex;gap:12px;align-items:center;min-width:0;padding-bottom:12px;border-bottom:1px solid var(--line)}.cloud-source-list span{min-width:0;overflow-wrap:anywhere}.cloud-live-session{min-width:0;display:grid;gap:18px}.cloud-live-status,.cloud-live-cost{display:flex;align-items:center;gap:12px;justify-content:space-between;flex-wrap:wrap;font-size:12px}.cloud-live-status>span:last-child{color:var(--muted)}.cloud-live-screen{background:#111822;border-radius:12px;overflow:hidden;aspect-ratio:16/9}.cloud-live-screen img{width:100%;height:auto;display:block;cursor:crosshair}.cloud-live-screen>div{height:100%;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:14px;color:#c0c9da;font-size:12px}.cloud-terminal{display:grid;gap:12px}.cloud-terminal textarea{font-family:Consolas,monospace;white-space:pre-wrap;overflow-wrap:anywhere;resize:vertical}.cloud-terminal .field{margin:0}.cloud-terminal button{justify-self:start}.cloud-command-result{padding:13px 16px;border-radius:10px;background:var(--warm);min-width:0}.cloud-command-result small{color:var(--muted)}.cloud-command-result pre{font:12px/1.7 Consolas,monospace;white-space:pre-wrap;overflow-wrap:anywhere;max-height:260px;overflow-y:auto;scrollbar-width:none}.cloud-command-result pre::-webkit-scrollbar{display:none}.cloud-stop{justify-self:start}@media(max-width:1150px){.cloud-computer-intro{grid-template-columns:auto minmax(0,1fr)}.cloud-computer-intro-notes{grid-column:1/-1;grid-template-columns:repeat(3,minmax(0,1fr));max-width:none}}@media(max-width:720px){.cloud-computer-grid,.cloud-computer-form-grid{grid-template-columns:minmax(0,1fr)}.cloud-computer-intro{padding:22px;gap:18px}.cloud-computer-intro-notes{grid-template-columns:minmax(0,1fr);gap:12px}.cloud-computer-mark{width:58px;height:58px;border-radius:15px}.cloud-computer-intro h2{font-size:22px}.cloud-computer-card{padding:20px}.cloud-computer-section>header{align-items:flex-start;flex-wrap:wrap}.cloud-quote-details>div{grid-template-columns:86px minmax(0,1fr);gap:10px}}

.cloud-create-fields{border:0;padding:0;margin:0;min-width:0;display:grid;gap:16px}
