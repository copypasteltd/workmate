.modal:has(.connector-admin-detail) {
  max-width: 860px;
}
.connector-admin-detail {
  min-width: 0;
  overflow-wrap: anywhere;
}
.connector-admin-detail .preview-details,
.connector-admin-detail .preview-details dd {
  min-width: 0;
}
.connector-admin-detail .table-scroll {
  max-width: 100%;
}
.connector-admin-detail .card code {
  white-space: normal;
}
