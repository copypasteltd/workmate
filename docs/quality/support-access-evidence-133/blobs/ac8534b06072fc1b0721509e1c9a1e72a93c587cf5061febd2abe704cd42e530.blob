.conversation-history { min-width: 0; }
.conversation-history-navigation { display:flex; flex-wrap:wrap; gap:8px; margin:18px 0; }
.conversation-history-navigation .button { min-height:40px; }
.conversation-history-messages { list-style:none; padding:0; margin:16px 0; display:grid; gap:14px; }
.conversation-history-messages li { min-width:0; border:1px solid var(--line); border-radius:12px; padding:16px; background:var(--surface); }
.conversation-history-messages header { display:flex; flex-wrap:wrap; align-items:center; gap:8px 14px; font-size:12px; color:var(--muted); margin-bottom:12px; }
.conversation-history-messages header strong { font-size:14px; color:var(--ink); }
.conversation-history-text { white-space:pre-wrap; overflow-wrap:anywhere; line-height:1.7; }
.conversation-history h3 { overflow-wrap:anywhere; }
@media(max-width:480px) { .conversation-history-messages li { padding:12px; } .conversation-history-navigation .button { flex:1 1 44%; } }
