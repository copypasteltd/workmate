@font-face {
  font-family: Manrope;
  src: url("/fonts/manrope.woff2") format("woff2");
  font-style: normal;
  font-weight: 200 800;
  font-display: swap;
}
@font-face {
  font-family: Fraunces;
  src: url("/fonts/fraunces.woff2") format("woff2");
  font-style: normal;
  font-weight: 100 900;
  font-display: swap;
}
@font-face {
  font-family: Fraunces;
  src: url("/fonts/fraunces-italic.woff2") format("woff2");
  font-style: italic;
  font-weight: 100 900;
  font-display: swap;
}

/* Manrope and Fraunces are bundled through @fontsource-variable; OFL licenses ship with dependencies. */
:root {
  --bg: #f6f6f4;
  --surface: #fff;
  --ink: #15171a;
  --muted: #646a75;
  --line: #e3e4e5;
  --blue: #1f5eff;
  --blue-soft: #edf2ff;
  --warm: #f0efeb;
  --green: #246b4e;
  --red: #b33432;
  --sidebar: #f0f0ed;
  --shadow: 0 8px 28px #14171a06;
  color-scheme: light;
  font-family: Manrope, "Microsoft JhengHei", "Noto Sans TC", sans-serif;
  font-size: 14px;
  font-synthesis: none;
  font-weight: 450;
  color: var(--ink);
  background: var(--bg);
}
:root[data-theme="dark"] {
  --bg: #0f131a;
  --surface: #171d29;
  --ink: #e8edf8;
  --muted: #a0abbe;
  --line: #2d3749;
  --blue: #79a2ff;
  --blue-soft: #1e2e50;
  --warm: #202735;
  --green: #8bcead;
  --red: #ffa7a3;
  --sidebar: #121822;
  --shadow: 0 8px 28px #00000020;
  color-scheme: dark;
}
* {
  box-sizing: border-box;
}
body {
  margin: 0;
}
button,
input,
textarea,
select {
  font: inherit;
}
button,
a,
input,
textarea,
select {
  -webkit-tap-highlight-color: transparent;
}
button,
a {
  touch-action: manipulation;
}
button {
  cursor: pointer;
}
button:disabled {
  cursor: wait;
  opacity: 0.6;
}
button,
input,
textarea,
select {
  color: inherit;
}
a {
  color: inherit;
  text-decoration: none;
}
button {
  border: 0;
  background: none;
}
img {
  display: block;
  max-width: 100%;
}
a,
button,
input,
select,
textarea {
  outline-offset: 4px;
}
:focus-visible {
  outline: 2px solid var(--blue);
}
h1,
h2,
h3,
p {
  margin-top: 0;
}
h1 {
  font-size: 31px;
  font-weight: 600;
  line-height: 1.25;
  letter-spacing: -1.1px;
  margin-bottom: 12px;
}
h2 {
  font-size: 20px;
  font-weight: 600;
  letter-spacing: -0.5px;
  margin-bottom: 18px;
}
h3 {
  font-size: 16px;
  font-weight: 650;
  letter-spacing: -0.3px;
  margin-bottom: 10px;
}
p {
  line-height: 1.7;
}
em {
  font-family: Fraunces, Georgia, "Microsoft JhengHei", serif;
  font-weight: 450;
}
small {
  font-size: 12px;
}
hr {
  border: 0;
  border-top: 1px solid var(--line);
  margin: 32px 0;
}
select {
  cursor: pointer;
}
svg {
  flex-shrink: 0;
}
.muted {
  color: var(--muted);
}
.small-text {
  font-size: 12px;
}
.number {
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum";
}
.eyebrow {
  font-size: 10px;
  font-weight: 650;
  letter-spacing: 1.8px;
  color: var(--muted);
  margin-bottom: 22px;
}
.preserve-text {
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}
.sr-only {
  position: absolute;
  clip: rect(0, 0, 0, 0);
  width: 1px;
  height: 1px;
  overflow: hidden;
}
.skip-link {
  position: fixed;
  top: -100px;
  left: 20px;
  padding: 12px;
  background: var(--ink);
  color: var(--bg);
  z-index: 100;
}
.skip-link:focus {
  top: 10px;
}
.tiny-dot,
.environment-dot {
  display: inline-block;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--blue);
}
.logo {
  display: inline-flex;
  align-items: center;
  min-height: 44px;
  width: 135px;
}
.logo img {
  width: 135px;
  max-height: 32px;
}
.logo-dark {
  display: none !important;
}
[data-theme="dark"] .logo-light {
  display: none !important;
}
[data-theme="dark"] .logo-dark {
  display: block !important;
}
.preference-controls {
  position: fixed;
  top: 19px;
  right: 23px;
  z-index: 45;
  display: flex;
  align-items: center;
  gap: 3px;
  background: var(--bg);
  border-radius: 30px;
  padding: 0 4px;
}
.preference-controls .icon-button {
  height: 37px;
  min-width: 37px;
  font-size: 11px;
  gap: 5px;
}
.icon-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  min-width: 40px;
  min-height: 40px;
  border-radius: 9px;
  color: var(--muted);
  transition: background 0.16s;
}
.icon-button:hover {
  background: var(--warm);
  color: var(--ink);
}
.button {
  display: inline-flex;
  gap: 12px;
  align-items: center;
  justify-content: center;
  min-height: 46px;
  padding: 0 22px;
  border-radius: 30px;
  font-size: 13px;
  font-weight: 600;
  white-space: nowrap;
  transition: transform 0.16s;
  border: 1px solid transparent;
}
.button:hover {
  transform: translateY(-1px);
}
.button.primary {
  background: var(--blue);
  color: white;
}
[data-theme="dark"] .button.primary {
  color: #101b31;
}
.button.primary:hover {
  filter: brightness(0.96);
}
.button.secondary {
  border-color: var(--line);
  background: var(--surface);
}
.button.secondary:hover {
  background: var(--warm);
}
.button.small {
  min-height: 38px;
  font-size: 12px;
  padding: 0 17px;
}
.button.round {
  border-radius: 50%;
  width: 44px;
  min-height: 44px;
  padding: 0;
}
.text-button,
.text-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  min-height: 42px;
  font-size: 12px;
  font-weight: 550;
  color: var(--blue);
  padding: 0;
}
.text-button:hover,
.text-link:hover {
  text-decoration: underline;
}
.row-actions {
  display: flex;
  align-items: center;
  gap: 14px;
  flex-wrap: wrap;
}
.site-header,
.site-footer {
  max-width: 1400px;
  margin: auto;
  padding: 28px 7%;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.site-header nav {
  display: flex;
  align-items: center;
  gap: 30px;
  padding-right: 114px;
  font-size: 12px;
}
.landing-hero {
  max-width: 1400px;
  margin: 50px auto 80px;
  padding: 0 7%;
  display: grid;
  grid-template-columns: 1.05fr 1fr;
  gap: 25px;
  align-items: center;
  min-height: 530px;
}
.landing-hero h1 {
  font-family: Fraunces, Georgia, "Microsoft JhengHei", serif;
  font-size: clamp(48px, 5.5vw, 80px);
  font-weight: 450;
  line-height: 1.14;
  letter-spacing: -3px;
  margin: 24px 0 30px;
}
.landing-hero h1 em {
  color: var(--blue);
}
.hero-description {
  font-size: 15px;
  max-width: 420px;
  color: var(--muted);
  line-height: 1.9;
  margin-bottom: 32px;
}
.hero-art {
  margin: 0;
  position: relative;
}
.hero-art img {
  width: 100%;
  mix-blend-mode: multiply;
  border-radius: 18px;
}
[data-theme="dark"] .hero-art img {
  mix-blend-mode: normal;
}
.hero-art figcaption {
  font-size: 8px;
  letter-spacing: 1.7px;
  display: flex;
  gap: 9px;
  align-items: center;
  position: absolute;
  bottom: 10px;
  left: 20px;
  color: var(--muted);
}
.hero-note {
  display: flex;
  align-items: center;
  gap: 9px;
  font-size: 10px;
  color: var(--muted);
  margin-top: 23px;
}
.landing-how {
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
  max-width: 1200px;
  margin: 0 auto;
  padding: 45px 0 52px;
}
.three-columns {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 45px;
}
.step-number {
  font-size: 11px;
  color: var(--blue);
  display: block;
  margin-bottom: 18px;
}
.three-columns h3 {
  font-size: 18px;
}
.three-columns p {
  color: var(--muted);
  font-size: 13px;
  margin-bottom: 0;
}
.landing-roles {
  max-width: 1200px;
  margin: 80px auto;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 100px;
}
.landing-roles h2 {
  font:
    450 40px/1.3 Fraunces,
    Georgia,
    "Microsoft JhengHei",
    serif;
  letter-spacing: -1.5px;
}
.role-name-list a {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20px 0;
  border-bottom: 1px solid var(--line);
  font-size: 17px;
}
.role-name-list a svg {
  color: var(--blue);
}
.site-footer {
  border-top: 1px solid var(--line);
  font-size: 10px;
  color: var(--muted);
  gap: 30px;
}
.site-footer a:last-child {
  display: flex;
  gap: 4px;
  align-items: center;
}
.auth-layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  min-height: 100vh;
}
.auth-content {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 34px 8% 28px;
}
.auth-form {
  max-width: 380px;
  width: 100%;
  margin: auto;
  padding: 60px 0;
}
.auth-form h1,
.onboarding h1,
.center-page h1 {
  font:
    450 50px/1.16 Fraunces,
    Georgia,
    "Microsoft JhengHei",
    serif;
  letter-spacing: -2px;
  margin-bottom: 24px;
}
.auth-form h1 em {
  color: var(--blue);
}
.auth-form > .muted {
  font-size: 13px;
  margin-bottom: 30px;
}
.auth-bottom {
  font-size: 8px;
  letter-spacing: 1.5px;
  color: var(--muted);
}
.auth-art {
  position: relative;
  background: #f0f0ed;
  overflow: hidden;
  display: flex;
  align-items: center;
}
.auth-art img {
  width: 100%;
  mix-blend-mode: multiply;
  margin-bottom: 50px;
}
.auth-art > div {
  position: absolute;
  bottom: 8%;
  left: 10%;
  color: #15171a;
  max-width: 80%;
}
.auth-art .eyebrow {
  font-size: 9px;
}
.auth-art p {
  font:
    450 31px/1.4 Fraunces,
    Georgia,
    "Microsoft JhengHei",
    serif;
  letter-spacing: -0.7px;
}
.auth-art p em {
  color: #1f5eff;
}
.form-stack {
  display: flex;
  flex-direction: column;
  gap: 20px;
}
.field {
  display: flex;
  flex-direction: column;
  gap: 8px;
  font-size: 12px;
  font-weight: 550;
  line-height: 1.6;
}
.field small {
  font-size: 11px;
  color: var(--muted);
  font-weight: 400;
}
.field input,
.field textarea,
.field select {
  width: 100%;
  border: 1px solid var(--line);
  border-radius: 10px;
  background: var(--surface);
  min-height: 46px;
  padding: 11px 13px;
  font-size: 13px;
  font-weight: 450;
  transition: border-color 0.15s;
}
.field input:focus,
.field textarea:focus {
  border-color: var(--blue);
}
textarea {
  resize: vertical;
  line-height: 1.65;
}
.field input[type="color"] {
  padding: 6px;
  height: 46px;
}
.field input[type="file"] {
  font-size: 12px;
}
.field input[readonly] {
  color: var(--muted);
  background: var(--warm);
}
.field .code-input {
  font-size: 24px;
  letter-spacing: 8px;
  min-height: 58px;
}
.form-stack > .button {
  margin-top: 6px;
}
.form-footnote {
  font-size: 10px;
  color: var(--muted);
  display: flex;
  align-items: flex-start;
  gap: 7px;
  margin-top: 22px;
  line-height: 1.8;
}
.auth-form > .text-button {
  margin-top: 12px;
}
.notice {
  display: flex;
  gap: 11px;
  align-items: flex-start;
  padding: 14px 16px;
  background: var(--blue-soft);
  border: 1px solid transparent;
  border-radius: 11px;
  color: var(--ink);
  font-size: 12px;
  line-height: 1.7;
  margin: 15px 0;
}
.notice svg {
  margin-top: 3px;
  color: var(--blue);
}
.notice small {
  display: block;
  margin-top: 3px;
  color: var(--muted);
}
.notice.error {
  background: color-mix(in srgb, var(--red) 6%, var(--surface));
  border-color: color-mix(in srgb, var(--red) 20%, transparent);
  color: var(--red);
}
.notice.error svg {
  color: var(--red);
}
.notice.error small {
  color: inherit;
  opacity: 0.8;
}
.notice ul {
  padding-left: 16px;
  margin: 6px 0;
}
.notice input {
  width: 100%;
  margin-top: 7px;
  padding: 8px;
  border: 1px solid var(--line);
  background: var(--surface);
  font-size: 11px;
  border-radius: 7px;
}
.block-code {
  font:
    10px/1.7 Consolas,
    monospace;
  display: block;
  overflow-wrap: anywhere;
  margin: 8px 0;
}
.success-line {
  display: flex;
  gap: 7px;
  align-items: center;
  color: var(--green);
  font-size: 12px;
  margin: 0;
}
.onboarding {
  min-height: 100vh;
  padding: 32px 7%;
}
.onboarding-card {
  max-width: 500px;
  margin: 65px auto;
}
.onboarding-card > .muted {
  margin: 22px 0 30px;
}
.step-pill {
  display: inline-block;
  border: 1px solid var(--line);
  padding: 6px 12px;
  border-radius: 20px;
  font-size: 10px;
  color: var(--muted);
  margin-bottom: 25px;
}
.center-page {
  min-height: 100vh;
  padding: 35px 7%;
}
.center-page > .card {
  margin: 60px auto;
  max-width: 500px;
}
.center-page h1 {
  font-size: 38px;
  margin-top: 20px;
}
.card {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 16px;
  padding: 26px;
  box-shadow: var(--shadow);
}
.app-shell {
  min-height: 100vh;
  display: flex;
}
.sidebar {
  width: 238px;
  position: fixed;
  inset: 0 auto 0 0;
  background: var(--sidebar);
  border-right: 1px solid var(--line);
  display: flex;
  flex-direction: column;
  padding: 26px 18px 15px;
  z-index: 50;
}
.sidebar-brand {
  padding: 0 12px 22px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.sidebar .logo {
  width: 119px;
}
.sidebar .logo img {
  width: 119px;
  max-height: 27px;
}
.workspace-switch {
  display: flex;
  align-items: center;
  gap: 9px;
  background: var(--surface);
  padding: 9px;
  border: 1px solid var(--line);
  border-radius: 10px;
  min-height: 49px;
  position: relative;
}
.workspace-avatar {
  width: 28px;
  height: 28px;
  background: var(--blue-soft);
  color: var(--blue);
  border-radius: 7px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  font-weight: 650;
  flex-shrink: 0;
}
.workspace-switch select {
  border: none;
  font-size: 11px;
  font-weight: 600;
  width: 100%;
  background: transparent;
  appearance: none;
  min-height: 28px;
  overflow: hidden;
  text-overflow: ellipsis;
}
.workspace-switch > svg {
  color: var(--muted);
  pointer-events: none;
}
.new-task-side {
  width: 100%;
  margin-top: 20px;
  justify-content: flex-start;
  padding: 0 14px;
  min-height: 42px;
  font-size: 12px;
}
.keyboard-key {
  margin-left: auto;
  font-size: 9px;
  border: 1px solid #ffffff60;
  border-radius: 4px;
  padding: 2px 5px;
  color: inherit;
  opacity: 0.8;
}
.nav-caption {
  font-size: 8px;
  letter-spacing: 1.5px;
  color: var(--muted);
  margin: 27px 13px 11px;
}
.sidebar nav {
  display: flex;
  flex-direction: column;
  gap: 3px;
}
.sidebar nav a,
.sidebar-bottom > a {
  display: flex;
  align-items: center;
  gap: 11px;
  font-size: 11px;
  min-height: 39px;
  border-radius: 8px;
  padding: 0 13px;
  color: var(--muted);
  position: relative;
}
.sidebar nav a:hover,
.sidebar-bottom > a:hover {
  background: var(--warm);
  color: var(--ink);
}
.sidebar nav a.active,
.sidebar-bottom > a.active {
  background: var(--surface);
  color: var(--blue);
  font-weight: 600;
  box-shadow: 0 1px 3px #00000003;
}
.sidebar nav a.active:before {
  content: "";
  position: absolute;
  left: -18px;
  width: 3px;
  height: 19px;
  background: var(--blue);
  border-radius: 0 3px 3px 0;
}
.sidebar-bottom {
  margin-top: auto;
  padding-top: 25px;
}
.sidebar-bottom > a {
  min-height: 34px;
  font-size: 10px;
}
.user-chip {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 16px;
  padding-top: 17px;
  border-top: 1px solid var(--line);
}
.user-avatar {
  display: inline-flex;
  width: 33px;
  height: 33px;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #e0e4ec;
  color: #374256;
  font-size: 12px;
  font-weight: 650;
  flex-shrink: 0;
}
.user-chip > div {
  display: flex;
  flex-direction: column;
  gap: 3px;
  min-width: 0;
}
.user-chip strong {
  font-size: 10px;
  white-space: nowrap;
  text-overflow: ellipsis;
  overflow: hidden;
  max-width: 115px;
}
.user-chip small {
  font-size: 9px;
  color: var(--muted);
  text-transform: capitalize;
}
.user-chip button {
  margin-left: auto;
  min-width: 28px;
}
.main-shell {
  margin-left: 238px;
  min-height: 100vh;
  width: calc(100% - 238px);
  display: flex;
  flex-direction: column;
}
.app-topbar {
  display: flex;
  align-items: center;
  min-height: 76px;
  padding: 0 46px;
  border-bottom: 1px solid var(--line);
  gap: 15px;
  font-size: 10px;
}
.breadcrumb {
  display: flex;
  gap: 15px;
  color: var(--muted);
  white-space: nowrap;
}
.breadcrumb > span {
  color: #bdc0c7;
}
.app-topbar > select {
  appearance: none;
  padding: 9px 6px;
  background: none;
  border: none;
  font-size: 10px;
  font-weight: 550;
  max-width: 250px;
  min-width: 0;
}
.topbar-right {
  margin-left: auto;
  margin-right: 105px;
  font-size: 9px;
  display: flex;
  align-items: center;
  gap: 7px;
  color: var(--muted);
  white-space: nowrap;
}
.environment-dot {
  width: 5px;
  height: 5px;
  background: var(--green);
}
.main-content {
  padding: 42px 46px 60px;
  max-width: 1510px;
  width: 100%;
  margin: 0 auto;
  flex: 1;
  min-width: 0;
}
.app-footer {
  padding: 18px 46px;
  display: flex;
  justify-content: space-between;
  color: var(--muted);
  font-size: 7px;
  letter-spacing: 1.3px;
  border-top: 1px solid var(--line);
}
.mobile-only {
  display: none;
}
.workspace-intro {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 10px 0 32px;
}
.workspace-intro .eyebrow {
  font-size: 8px;
  margin-bottom: 21px;
}
.workspace-intro h1 {
  font-size: 38px;
  font-weight: 450;
  line-height: 1.4;
  letter-spacing: -1.6px;
  margin-bottom: 14px;
}
.workspace-intro h1 em {
  font-size: 40px;
  letter-spacing: -1.8px;
}
.workspace-intro .muted {
  font-size: 12px;
  margin: 0;
}
.intro-mark {
  width: 105px;
  height: 100px;
  position: relative;
  margin-right: 40px;
  transform: rotate(-19deg);
}
.intro-mark span {
  width: 48px;
  height: 76px;
  border: 1.3px solid var(--blue);
  border-radius: 30px;
  position: absolute;
  top: 13px;
  left: 8px;
  transform: rotate(-27deg);
  opacity: 0.7;
}
.intro-mark span:nth-child(2) {
  left: 30px;
  transform: rotate(0);
}
.intro-mark span:nth-child(3) {
  left: 51px;
  transform: rotate(27deg);
}
.brief-composer {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 18px;
  padding: 19px 21px 13px;
  box-shadow: 0 4px 20px #15171a03;
}
.brief-composer:focus-within {
  border-color: color-mix(in srgb, var(--blue) 60%, var(--line));
}
.brief-composer textarea {
  width: 100%;
  resize: none;
  background: none;
  border: none;
  outline: none;
  font-size: 12px;
  min-height: 76px;
  color: var(--ink);
  padding: 3px;
  line-height: 1.7;
}
.brief-composer textarea::placeholder {
  color: var(--muted);
}
.brief-composer footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.brief-composer footer > span {
  display: flex;
  align-items: center;
  gap: 7px;
  font-size: 9px;
  color: var(--muted);
}
.brief-composer .button {
  width: 38px;
  min-height: 38px;
}
.quick-starts {
  display: flex;
  gap: 10px;
  margin-top: 13px;
  flex-wrap: wrap;
}
.quick-starts button {
  display: flex;
  align-items: center;
  gap: 8px;
  border: 1px solid var(--line);
  padding: 8px 12px;
  border-radius: 30px;
  font-size: 9px;
  background: transparent;
  min-height: 35px;
  color: var(--muted);
}
.quick-starts button:hover {
  border-color: var(--blue);
  color: var(--blue);
}
.quick-starts button > svg:last-child {
  margin-left: 10px;
}
.section-block {
  margin-top: 39px;
}
.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18px;
  gap: 16px;
}
.section-title h2 {
  margin: 0;
  font-size: 16px;
  font-weight: 600;
}
.section-title .text-link {
  font-size: 10px;
  min-height: 28px;
}
.role-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14px;
}
.role-card {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 14px;
  padding: 19px 17px 13px;
  text-align: left;
  min-width: 0;
  transition:
    border-color 0.16s,
    box-shadow 0.16s,
    transform 0.16s;
  display: flex;
  flex-direction: column;
  min-height: 205px;
}
.role-card:hover {
  border-color: #b5c6f0;
  box-shadow: 0 5px 17px #1f5eff08;
  transform: translateY(-2px);
}
.role-card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 23px;
}
.role-card-top > svg {
  color: var(--muted);
  width: 13px;
}
.role-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 37px;
  height: 37px;
  background: var(--blue-soft);
  color: var(--blue);
  border-radius: 10px;
}
.role-tone-1 .role-icon {
  background: #f2efeb;
  color: #74614c;
}
.role-tone-2 .role-icon {
  background: #eaf1ed;
  color: #416b54;
}
.role-tone-3 .role-icon {
  background: #f3eded;
  color: #875d5d;
}
[data-theme="dark"] .role-tone-1 .role-icon {
  background: #302b25;
  color: #d6bb98;
}
[data-theme="dark"] .role-tone-2 .role-icon {
  background: #23342b;
  color: #a0d1b2;
}
[data-theme="dark"] .role-tone-3 .role-icon {
  background: #342627;
  color: #d6a4a5;
}
.role-card h3 {
  font-size: 12px;
  margin-bottom: 8px;
  line-height: 1.5;
}
.role-card p {
  font-size: 9px;
  color: var(--muted);
  line-height: 1.8;
  margin: 0 0 18px;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  min-height: 32px;
}
.role-card footer {
  border-top: 1px solid var(--line);
  padding-top: 10px;
  display: flex;
  justify-content: space-between;
  gap: 6px;
  font-size: 8px;
  margin-top: auto;
}
.role-category {
  text-transform: uppercase;
  font-size: 7px;
  letter-spacing: 0.8px;
  color: var(--muted);
}
.available-mark {
  color: var(--green);
}
.role-detail h3 {
  margin: 25px 0 13px;
  font-size: 14px;
}
.role-detail ul {
  list-style: none;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 12px;
  font-size: 12px;
  line-height: 1.8;
  color: var(--muted);
}
.role-detail li {
  display: flex;
  align-items: flex-start;
  gap: 10px;
}
.role-detail li svg {
  color: var(--green);
  margin-top: 4px;
}
.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
}
.tags > span {
  padding: 5px 8px;
  background: var(--warm);
  border-radius: 5px;
  font:
    9px Consolas,
    monospace;
  color: var(--muted);
}
.empty-state {
  padding: 42px 24px 35px;
  text-align: center;
  border: 1px dashed var(--line);
  border-radius: 15px;
  background: color-mix(in srgb, var(--surface) 35%, transparent);
}
.empty-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 55px;
  height: 55px;
  border-radius: 15px;
  background: var(--warm);
  color: var(--muted);
  margin: 0 auto 18px;
}
.empty-state h3 {
  font-size: 14px;
  font-weight: 550;
  margin-bottom: 9px;
}
.empty-state p {
  font-size: 11px;
  color: var(--muted);
  max-width: 450px;
  margin: 0 auto 13px;
  line-height: 1.9;
}
.empty-state .button {
  margin-top: 9px;
}
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  min-height: 170px;
  color: var(--muted);
  font-size: 12px;
}
.spin {
  animation: spin 1s linear infinite;
}
@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
.page-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 25px;
  margin-bottom: 32px;
}
.page-heading .eyebrow {
  font-size: 8px;
  margin-bottom: 18px;
}
.page-heading > .button,
.page-heading > .row-actions {
  flex-shrink: 0;
}
.page-heading .muted {
  font-size: 12px;
  margin: 0;
  max-width: 650px;
}
.page-heading h1 {
  font-size: 30px;
  letter-spacing: -1px;
}
.filter-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 25px;
  flex-wrap: wrap;
}
.filter-row select {
  background: var(--surface);
  border: 1px solid var(--line);
  padding: 9px 13px;
  border-radius: 8px;
  min-height: 43px;
  font-size: 12px;
}
.tabs {
  display: flex;
  gap: 4px;
  border-bottom: 1px solid var(--line);
}
.tabs button {
  font-size: 11px;
  min-height: 44px;
  padding: 0 15px;
  color: var(--muted);
  border-bottom: 2px solid transparent;
  margin-bottom: -1px;
  white-space: nowrap;
}
.tabs button.active {
  color: var(--blue);
  border-bottom-color: var(--blue);
}
.search-field {
  display: flex;
  align-items: center;
  gap: 9px;
  background: var(--surface);
  padding: 0 13px;
  border: 1px solid var(--line);
  border-radius: 9px;
  color: var(--muted);
  min-height: 42px;
  max-width: 260px;
}
.search-field input {
  min-width: 0;
  width: 100%;
  border: 0;
  background: none;
  outline: none;
  font-size: 11px;
}
.table-scroll {
  overflow-x: auto;
  width: 100%;
  border: 1px solid var(--line);
  border-radius: 12px;
  background: var(--surface);
}
.card.table-scroll {
  padding: 0;
}
table {
  border-collapse: collapse;
  width: 100%;
  text-align: left;
  white-space: nowrap;
  font-size: 10px;
}
th {
  font-size: 9px;
  font-weight: 550;
  color: var(--muted);
  background: color-mix(in srgb, var(--warm) 50%, var(--surface));
  padding: 13px 17px;
  border-bottom: 1px solid var(--line);
}
td {
  padding: 16px 17px;
  border-bottom: 1px solid var(--line);
  max-width: 330px;
  overflow: hidden;
  text-overflow: ellipsis;
}
tr:last-child td {
  border-bottom: none;
}
tbody tr:hover {
  background: color-mix(in srgb, var(--blue-soft) 30%, var(--surface));
}
.table-link {
  display: flex;
  align-items: center;
  gap: 20px;
  font-weight: 550;
}
.table-link svg {
  color: var(--muted);
  width: 12px;
}
.badge {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-size: 9px;
  padding: 4px 8px;
  border: 1px solid var(--line);
  background: var(--warm);
  border-radius: 20px;
  white-space: nowrap;
  text-transform: none;
}
.badge > span {
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: var(--muted);
}
.status-succeeded,
.status-active,
.status-connected,
.status-published,
.status-accepted {
  background: color-mix(in srgb, var(--green) 7%, var(--surface));
  color: var(--green);
  border-color: color-mix(in srgb, var(--green) 18%, var(--line));
}
.status-succeeded > span,
.status-active > span,
.status-connected > span,
.status-published > span,
.status-accepted > span {
  background: var(--green);
}
.status-running,
.status-queued {
  background: var(--blue-soft);
  color: var(--blue);
  border-color: color-mix(in srgb, var(--blue) 18%, var(--line));
}
.status-running > span,
.status-queued > span {
  background: var(--blue);
}
.status-failed,
.status-quarantined,
.status-reconciling {
  background: color-mix(in srgb, var(--red) 7%, var(--surface));
  color: var(--red);
}
.status-failed > span,
.status-quarantined > span,
.status-reconciling > span {
  background: var(--red);
}
.project-grid,
.connection-grid,
.settings-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20px;
}
.project-card > svg {
  color: var(--blue);
  margin-bottom: 25px;
}
.project-card h2 {
  font-size: 18px;
}
.project-card p {
  font-size: 11px;
  line-height: 1.9;
}
.project-card footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1px solid var(--line);
  margin-top: 25px;
  padding-top: 12px;
  font-size: 9px;
  color: var(--muted);
}
.two-columns {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 15px;
}
.metrics-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16px;
  margin-bottom: 28px;
}
.metric-card {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 14px;
  padding: 23px 20px;
}
.metric-card > span {
  color: var(--muted);
  font-size: 10px;
  display: block;
  margin-bottom: 18px;
}
.metric-card > strong {
  font-size: 24px;
  font-weight: 550;
  letter-spacing: -0.8px;
  font-variant-numeric: tabular-nums;
  display: block;
  white-space: nowrap;
}
.metric-card > small {
  color: var(--muted);
  font-size: 8px;
  display: block;
  margin-top: 10px;
}
.plan-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 30px;
}
.plan-card .eyebrow {
  font-size: 8px;
}
.plan-card h2 {
  text-transform: capitalize;
  font:
    450 34px Fraunces,
    Georgia,
    serif;
  margin-bottom: 8px;
}
.plan-card p {
  font-size: 11px;
  margin: 0;
}
.plan-card > .number {
  font-size: 11px;
  color: var(--muted);
}
.modal-backdrop {
  position: fixed;
  inset: 0;
  background: #0a112350;
  backdrop-filter: blur(4px);
  display: flex;
  justify-content: center;
  align-items: flex-start;
  padding: 55px 20px;
  overflow: auto;
  z-index: 100;
}
.modal {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 19px;
  box-shadow: 0 22px 90px #0c172f30;
  width: 100%;
  max-width: 580px;
  padding: 28px;
}
.modal > header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22px;
  gap: 20px;
}
.modal > header h2 {
  margin: 0;
  font-size: 21px;
}
.modal .form-stack {
  gap: 17px;
}
.modal .field input,
.modal .field textarea,
.modal .field select {
  font-size: 12px;
}
.modal .form-stack > .button {
  margin-top: 13px;
  align-self: flex-start;
}
.modal .notice {
  font-size: 11px;
}
.modal > .button {
  margin-top: 24px;
}
.task-layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 260px;
  gap: 20px;
}
.task-conversation {
  padding: 30px;
  min-height: 350px;
}
.task-conversation > p,
.agent-output {
  font-size: 13px;
  line-height: 1.95;
}
.conversation-label {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 11px;
  margin-bottom: 20px;
}
.conversation-label > .number {
  margin-left: auto;
  font-size: 9px;
  color: var(--muted);
}
.small-avatar {
  width: 28px;
  height: 28px;
  font-size: 10px;
}
.specialist-avatar {
  width: 28px;
  height: 28px;
  background: var(--blue-soft);
  color: var(--blue);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8px;
}
.detail-list {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 17px 10px;
  font-size: 10px;
  margin: 25px 0;
}
.detail-list dt {
  color: var(--muted);
}
.detail-list dd {
  margin: 0;
  text-align: right;
}
.review-actions {
  display: flex;
  gap: 9px;
  align-items: center;
  flex-wrap: wrap;
  border-top: 1px solid var(--line);
  padding-top: 25px;
  margin-top: 25px;
}
.review-actions .button {
  font-size: 10px;
  min-height: 39px;
  padding: 0 16px;
}
.timeline {
  background: var(--surface);
  border: 1px solid var(--line);
  padding: 20px;
  border-radius: 13px;
  max-height: 340px;
  overflow: auto;
}
.timeline > div {
  display: flex;
  gap: 12px;
  align-items: center;
  font-size: 10px;
  padding: 12px 0;
}
.timeline .number {
  margin-left: auto;
  color: var(--muted);
  font-size: 9px;
}
.timeline-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--blue);
}
.asset-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 17px;
}
.asset-card {
  padding: 13px;
  min-width: 0;
}
.asset-preview {
  height: 130px;
  background: var(--warm);
  border-radius: 9px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--muted);
  position: relative;
  margin-bottom: 16px;
}
.file-extension {
  position: absolute;
  bottom: 12px;
  right: 12px;
  text-transform: uppercase;
  font-size: 8px;
  letter-spacing: 1px;
}
.asset-card h3 {
  font-size: 11px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 7px;
}
.asset-card p {
  font-size: 9px;
  margin-bottom: 8px;
}
.asset-card .text-button {
  font-size: 10px;
  min-height: 32px;
}
.version-row {
  display: flex;
  align-items: center;
  gap: 15px;
  padding: 15px 0;
  border-bottom: 1px solid var(--line);
  font-size: 11px;
}
.version-row .icon-button {
  margin-left: auto;
}
.version-row:last-child {
  border-bottom: 0;
}
.poster-mini {
  aspect-ratio: 4/5;
  width: 240px;
  border: 1px solid #d9d9d7;
  margin: 10px auto;
  padding: 20px;
  display: flex;
  flex-direction: column;
}
.poster-mini > div {
  width: 30px;
  height: 3px;
  background: #1f5eff;
  margin-bottom: 15px;
}
.poster-mini small {
  font-size: 7px;
}
.poster-mini strong {
  font:
    450 19px/1.5 Georgia,
    "Microsoft JhengHei",
    serif;
  margin: auto 0;
  overflow-wrap: anywhere;
}
.poster-mini footer {
  font-size: 7px;
  border-top: 1px solid #bfc3cc;
  padding-top: 15px;
}
.section-note {
  font-size: 11px;
  color: var(--muted);
  margin-top: 25px;
}
.connection-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}
.connection-card {
  padding: 26px;
}
.connection-brand {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28px;
}
.connection-brand > span:first-child {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42px;
  height: 42px;
  background: var(--blue-soft);
  color: var(--blue);
  border-radius: 12px;
  font-size: 22px;
  font-weight: 550;
}
.connection-card h2 {
  font-size: 19px;
  margin-bottom: 9px;
}
.connection-card p {
  font-size: 11px;
}
.connection-card > .button {
  margin-top: 10px;
  font-size: 11px;
  min-height: 39px;
}
.connection-card > small {
  display: block;
  color: var(--muted);
  font-size: 9px;
  margin-top: 17px;
}
.workflow-steps {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 15px;
}
.workflow-steps > div {
  display: flex;
  align-items: center;
  gap: 8px;
  border: 1px solid var(--line);
  background: var(--warm);
  border-radius: 10px;
  padding: 14px;
  font-size: 10px;
  flex: 1;
}
.workflow-steps svg {
  color: var(--blue);
}
.brand-colors {
  display: flex;
  gap: 7px;
  margin-bottom: 23px;
}
.brand-colors span {
  height: 38px;
  width: 38px;
  border-radius: 50%;
  border: 1px solid #00000014;
}
.audit-results {
  margin-top: 25px;
  border-top: 1px solid var(--line);
  padding-top: 15px;
}
.audit-results > div {
  display: flex;
  align-items: center;
  gap: 15px;
  padding: 8px 0;
  font-size: 11px;
}
.audit-results p {
  font-size: 11px;
  margin-top: 15px;
}
.settings-grid {
  grid-template-columns: 1fr 1fr;
}
.session-row {
  display: flex;
  align-items: center;
  gap: 13px;
  padding: 14px 0;
  border-bottom: 1px solid var(--line);
}
.session-row > div {
  display: flex;
  flex-direction: column;
  gap: 5px;
  font-size: 11px;
}
.session-row small {
  font-size: 9px;
  color: var(--muted);
}
.session-row > button {
  margin-left: auto;
  font-size: 10px;
}
@media (min-width: 1600px) {
  .main-content {
    padding-top: 55px;
  }
  .workspace-intro h1 {
    font-size: 44px;
  }
  .workspace-intro h1 em {
    font-size: 46px;
  }
  .role-card {
    padding: 24px;
    min-height: 220px;
  }
  .role-card h3 {
    font-size: 14px;
  }
  .role-card p {
    font-size: 11px;
  }
}
@media (max-width: 1200px) {
  .main-content {
    padding: 32px;
  }
  .app-topbar {
    padding: 0 32px;
  }
  .role-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .workspace-intro h1 {
    font-size: 33px;
  }
  .workspace-intro h1 em {
    font-size: 36px;
  }
  .intro-mark {
    margin-right: 15px;
    transform: scale(0.85) rotate(-19deg);
  }
  .topbar-right {
    display: none;
  }
  .asset-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .project-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .landing-how,
  .landing-roles {
    margin-left: 7%;
    margin-right: 7%;
  }
  .metrics-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .metric-card > strong {
    font-size: 25px;
  }
  .task-layout {
    grid-template-columns: minmax(0, 1fr);
  }
  .task-layout aside .card {
    max-width: none;
  }
  .detail-list {
    grid-template-columns: repeat(6, minmax(0, 1fr));
    align-items: center;
  }
  .detail-list dd {
    text-align: left;
  }
  .auth-art p {
    font-size: 26px;
  }
  .auth-form {
    max-width: 330px;
  }
}
@media (max-width: 960px) {
  .sidebar {
    width: 206px;
    padding-left: 14px;
    padding-right: 14px;
  }
  .main-shell {
    margin-left: 206px;
    width: calc(100% - 206px);
  }
  .sidebar nav a.active:before {
    left: -14px;
  }
  .main-content {
    padding: 30px 24px;
  }
  .app-topbar {
    padding: 0 24px;
  }
  .role-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .workspace-intro h1 {
    font-size: 31px;
  }
  .workspace-intro h1 em {
    font-size: 33px;
  }
  .intro-mark {
    display: none;
  }
  .page-heading {
    align-items: flex-start;
  }
  .page-heading h1 {
    font-size: 27px;
  }
  .page-heading > .button {
    font-size: 11px;
    padding: 0 15px;
  }
  .asset-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .settings-grid {
    grid-template-columns: 1fr;
  }
  .landing-hero {
    margin-top: 30px;
    min-height: 450px;
  }
  .landing-hero h1 {
    font-size: 55px;
    letter-spacing: -2px;
  }
  .hero-description {
    font-size: 13px;
  }
  .site-header nav > a:not(.button) {
    display: none;
  }
  .landing-roles {
    gap: 50px;
  }
  .landing-roles h2 {
    font-size: 34px;
  }
  .three-columns {
    gap: 30px;
  }
  .auth-form h1 {
    font-size: 42px;
  }
  .auth-art p {
    font-size: 23px;
  }
  .connection-grid {
    grid-template-columns: 1fr;
  }
  .filter-row {
    gap: 15px;
  }
  .tabs {
    max-width: 100%;
    overflow-x: auto;
  }
  .tabs button {
    padding: 0 10px;
  }
  .quick-starts button {
    font-size: 8px;
  }
  .quick-starts button > svg:last-child {
    display: none;
  }
}
@media (max-width: 740px) {
  .mobile-only {
    display: inline-flex;
  }
  .sidebar {
    width: 245px;
    transform: translateX(-100%);
    transition: transform 0.2s;
    box-shadow: 0 0 0 100vw transparent;
  }
  .mobile-open .sidebar {
    transform: translateX(0);
    box-shadow: 0 0 0 100vw #0a112350;
  }
  .main-shell {
    margin-left: 0;
    width: 100%;
  }
  .app-topbar {
    min-height: 66px;
    padding: 0 17px;
    gap: 6px;
    padding-right: 115px;
  }
  .app-topbar .breadcrumb {
    display: none;
  }
  .app-topbar > select {
    max-width: calc(100vw - 185px);
    font-size: 10px;
  }
  .main-content {
    padding: 30px 20px 45px;
  }
  .preference-controls {
    top: 15px;
    right: 15px;
  }
  .workspace-intro {
    margin-top: 3px;
  }
  .workspace-intro h1 {
    font-size: 30px;
  }
  .workspace-intro h1 em {
    font-size: 33px;
  }
  .workspace-intro .eyebrow {
    font-size: 7px;
    letter-spacing: 1.2px;
  }
  .workspace-intro .muted {
    font-size: 11px;
  }
  .brief-composer {
    padding: 17px 16px 11px;
  }
  .brief-composer footer > span {
    font-size: 8px;
  }
  .brief-composer textarea {
    font-size: 12px;
    min-height: 92px;
  }
  .quick-starts {
    gap: 7px;
  }
  .quick-starts button {
    font-size: 9px;
    padding: 7px 10px;
  }
  .quick-starts button svg {
    width: 14px;
  }
  .role-grid {
    gap: 11px;
  }
  .role-card {
    padding: 16px 13px;
    min-height: 200px;
  }
  .role-card h3 {
    font-size: 12px;
  }
  .role-card p {
    font-size: 9px;
  }
  .role-card-top {
    margin-bottom: 19px;
  }
  .section-block {
    margin-top: 31px;
  }
  .section-title h2 {
    font-size: 15px;
  }
  .section-title .text-link {
    font-size: 9px;
  }
  .page-heading {
    flex-direction: column;
    gap: 20px;
    margin-bottom: 25px;
  }
  .page-heading .muted {
    font-size: 11px;
  }
  .page-heading .eyebrow {
    font-size: 7px;
    letter-spacing: 1.3px;
  }
  .project-grid {
    grid-template-columns: 1fr;
  }
  .metrics-grid {
    gap: 11px;
  }
  .metric-card {
    padding: 20px 15px;
  }
  .metric-card > strong {
    font-size: 23px;
  }
  .metric-card > span {
    font-size: 9px;
    margin-bottom: 15px;
  }
  .metric-card > small {
    font-size: 7px;
  }
  .settings-grid {
    gap: 15px;
  }
  .card {
    padding: 21px;
  }
  .task-conversation {
    padding: 22px;
  }
  .conversation-label {
    font-size: 10px;
  }
  .conversation-label > .number {
    display: none;
  }
  .detail-list {
    grid-template-columns: 1fr 1fr;
  }
  .detail-list dd {
    text-align: right;
  }
  .timeline .number {
    font-size: 8px;
  }
  .timeline > div {
    font-size: 9px;
  }
  .timeline strong {
    overflow-wrap: anywhere;
  }
  .app-footer {
    padding: 16px 20px;
    font-size: 6px;
  }
  .app-footer > span:last-child {
    display: none;
  }
  .modal-backdrop {
    padding: 20px 10px;
  }
  .modal {
    padding: 23px 20px;
    border-radius: 15px;
  }
  .modal > header h2 {
    font-size: 20px;
  }
  .filter-row .search-field {
    max-width: none;
    width: 100%;
  }
  .landing-hero {
    grid-template-columns: 1fr;
    padding: 0 7%;
    gap: 5px;
    margin: 40px 0 50px;
    min-height: 0;
  }
  .landing-hero h1 {
    font-size: 56px;
    line-height: 1.2;
  }
  .landing-hero .eyebrow {
    font-size: 8px;
  }
  .hero-description {
    font-size: 13px;
    max-width: 350px;
  }
  .hero-art {
    margin: 15px auto 0;
    max-width: 370px;
    width: 100%;
  }
  .hero-art figcaption {
    font-size: 6px;
  }
  .site-header {
    padding: 20px 7%;
  }
  .site-header .logo,
  .site-header .logo img {
    width: 110px;
  }
  .site-header nav {
    padding-right: 90px;
    gap: 0;
  }
  .site-header .button {
    font-size: 10px;
    padding: 0 12px;
    min-height: 35px;
  }
  .site-header .button svg {
    width: 12px;
  }
  .landing .preference-controls {
    top: 21px;
  }
  .landing-how {
    padding: 35px 0;
  }
  .three-columns {
    grid-template-columns: 1fr;
    gap: 24px;
  }
  .three-columns article {
    display: grid;
    grid-template-columns: 35px 1fr;
    column-gap: 10px;
  }
  .three-columns h3 {
    font-size: 17px;
    margin-bottom: 8px;
  }
  .three-columns .step-number {
    grid-row: span 2;
    margin-top: 4px;
  }
  .three-columns p {
    font-size: 12px;
  }
  .landing-roles {
    grid-template-columns: 1fr;
    gap: 20px;
    margin: 55px 7%;
  }
  .landing-roles h2 {
    font-size: 36px;
  }
  .role-name-list a {
    font-size: 16px;
  }
  .site-footer {
    flex-wrap: wrap;
    gap: 15px;
  }
  .site-footer > .logo {
    width: 110px;
  }
  .site-footer span {
    font-size: 9px;
  }
  .site-footer > a:last-child {
    display: none;
  }
  .auth-layout {
    grid-template-columns: 1fr;
  }
  .auth-content {
    min-height: 100vh;
    padding: 25px 7%;
  }
  .auth-form {
    max-width: 380px;
    padding: 70px 0 90px;
  }
  .auth-form h1 {
    font-size: 50px;
  }
  .auth-art {
    display: none;
  }
  .auth-bottom {
    font-size: 7px;
  }
  .onboarding {
    padding: 25px 7%;
  }
  .onboarding-card {
    margin-top: 70px;
  }
  .onboarding h1 {
    font-size: 40px;
  }
  .center-page {
    padding: 25px 6%;
  }
  .center-page > .card {
    margin-top: 50px;
  }
  .center-page h1 {
    font-size: 32px;
  }
  .plan-card {
    flex-direction: column;
    align-items: flex-start;
  }
  .connection-card {
    padding: 24px;
  }
  .workflow-steps {
    flex-direction: column;
  }
  .workflow-steps > div {
    width: 100%;
  }
  .workflow-steps > svg {
    transform: rotate(90deg);
  }
}
@media (prefers-reduced-motion: reduce) {
  *,
  *:before,
  *:after {
    animation: none !important;
    transition: none !important;
    scroll-behavior: auto !important;
  }
  .button:hover,
  .role-card:hover {
    transform: none;
  }
}
.logo {
  gap: 9px;
  width: auto;
  min-width: 135px;
}
.logo img,
.sidebar .logo img,
.site-header .logo img {
  width: 30px;
  height: 30px;
  max-height: none;
}
.logo strong {
  font-family: Manrope, sans-serif;
  font-size: 20px;
  font-weight: 750;
  letter-spacing: -1.1px;
}
.sidebar .logo {
  width: auto;
  min-width: 0;
}
.sidebar .logo strong {
  font-size: 19px;
}
.sidebar .logo img {
  width: 27px;
  height: 27px;
}
.sidebar nav a,
.sidebar-bottom > a {
  min-height: 44px;
  font-size: 12px;
}
.role-card h3 {
  font-size: 14px;
}
.role-card p {
  font-size: 11px;
  min-height: 40px;
}
.role-card footer {
  font-size: 10px;
}
.role-category {
  font-size: 8px;
}
.role-card {
  min-height: 224px;
}
.empty-state h3 {
  font-size: 16px;
}
.empty-state p {
  font-size: 12px;
}
.brief-composer textarea {
  font-size: 14px;
}
.quick-starts button {
  min-height: 40px;
  font-size: 11px;
}
.sidebar-bottom > a {
  font-size: 11px;
}
.badge {
  font-size: 10px;
}
table {
  font-size: 12px;
}
th {
  font-size: 10px;
}
.page-heading .muted,
.workspace-intro .muted {
  font-size: 13px;
}
.field {
  font-size: 13px;
}
.field input,
.field textarea,
.field select {
  font-size: 14px;
}
.button {
  font-size: 14px;
}
.button.small {
  min-height: 44px;
}
.role-icon {
  width: 40px;
  height: 40px;
}
@media (max-height: 850px) and (min-width: 741px) {
  .sidebar {
    padding-top: 16px;
  }
  .sidebar-brand {
    padding-bottom: 14px;
  }
  .new-task-side {
    margin-top: 14px;
  }
  .nav-caption {
    margin-top: 18px;
  }
  .sidebar nav {
    gap: 0;
  }
  .sidebar nav a {
    min-height: 39px;
  }
  .sidebar-bottom {
    padding-top: 12px;
  }
  .sidebar-bottom > a {
    min-height: 34px;
  }
  .user-chip {
    margin-top: 10px;
    padding-top: 10px;
  }
}
@media (max-width: 740px) {
  .logo strong {
    font-size: 18px;
  }
  .logo {
    min-width: 120px;
  }
  .site-header .logo {
    width: auto;
  }
  .site-header .button {
    font-size: 10px;
  }
  .sidebar nav a {
    min-height: 44px;
  }
  .role-card h3 {
    font-size: 13px;
  }
  .role-card p {
    font-size: 11px;
  }
  .role-card {
    min-height: 224px;
  }
  .quick-starts button {
    font-size: 10px;
  }
  .button {
    font-size: 13px;
  }
}

.permission-options {
  max-height: 320px;
  overflow: auto;
  border: 1px solid var(--line);
  border-radius: 16px;
  padding: 16px;
}
.permission-options label {
  display: flex;
  gap: 10px;
  align-items: center;
  margin-bottom: 8px;
}
.permission-options input {
  width: auto;
  min-height: initial;
}
.refund-amount {
  display: block;
  margin: 0.2rem 0;
}
.refund-state {
  line-height: 1.6;
}
.refund-event {
  border-top: 1px solid var(--line);
  padding: 1rem 0;
}
.refund-event > .number {
  display: block;
  margin-top: 0.35rem;
}
