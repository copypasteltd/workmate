  "findings": [
    {
      "id": "DIR-01",
      "area": "desktop_kernel",
      "status": "not_implemented",
      "finding": "Desktop uses cloud APIs and local file-command polling; no Desktop-owned local Codex app-server lifecycle was found in the reviewed entry point."
    },
    {
      "id": "DIR-02",
      "area": "desktop_full_local_access",
      "status": "not_implemented",
      "finding": "One-hour directory read/create grants do not provide a user-selectable full local filesystem and terminal mode."
    },
    {
      "id": "DIR-03",
      "area": "cloud_profile_reuse",
      "status": "desktop_reuse_would_be_incompatible",
      "finding": "Current cloud Codex uses read-only sandbox with shell disabled; this profile cannot represent Desktop full access."
    },
    {
      "id": "DIR-04",
      "area": "extension_surface",
      "status": "already_has_native_side_panel",
      "finding": "Existing MV3 side panel appearance can be retained."
    },
    {
      "id": "DIR-05",
      "area": "extension_conversation",
      "status": "restructure_required",
      "finding": "Primary UI is a task brief/title/budget form, rather than conversation history, a message stream and a bottom composer."
    },
    {
      "id": "DIR-06",
      "area": "extension_files",
      "status": "basic_upload_exists_full_flow_unproven",
      "finding": "Single-file 5 MiB browser reads and project uploads exist; explicit message/version binding and complete conversational recovery need implementation and verification."
    },
    {
      "id": "DIR-07",
      "area": "local_execution_api",
      "status": "not_implemented",
      "finding": "The current canonical task adapter rejects unsupported device_id semantics and must not be described as a local-agent API."
    }
  ],
