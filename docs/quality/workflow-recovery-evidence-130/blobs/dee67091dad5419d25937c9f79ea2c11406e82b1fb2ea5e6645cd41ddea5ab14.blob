  "components": {
    "schemas": {
      "QuoteInput": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "plan_key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{2,63}$"
          },
          "minutes": {
            "type": "integer",
            "minimum": 5,
            "maximum": 1440
          },
          "billing_account_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "scope": {
            "type": "object",
            "properties": {
              "terminal": {
                "type": "boolean"
              },
              "visual": {
                "type": "boolean"
              },
              "agent_control": {
                "default": false,
                "type": "boolean"
              },
              "selected_asset_versions": {
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                }
              },
              "purpose": {
                "type": "string",
                "minLength": 8,
                "maxLength": 500
              }
            },
            "required": [
              "terminal",
              "visual",
              "agent_control",
              "selected_asset_versions",
              "purpose"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "plan_key",
          "minutes",
          "billing_account_id",
          "scope"
        ],
        "additionalProperties": false
      },
      "Confirmation": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "quote_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "specification_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "maximum_cost_micros": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "confirm_cost_and_scope": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "quote_id",
          "specification_hash",
          "maximum_cost_micros",
          "confirm_cost_and_scope"
        ],
        "additionalProperties": false
      },
      "ControlInput": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "terminal"
              },
              "command": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            },
            "required": [
              "kind",
              "command"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "pointer"
              },
              "x": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1279
              },
              "y": {
                "type": "integer",
                "minimum": 0,
                "maximum": 719
              },
              "button": {
                "type": "string",
                "enum": [
                  "none",
                  "left",
                  "right"
                ]
              }
            },
            "required": [
              "kind",
              "x",
              "y",
              "button"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "key"
              },
              "key": {
                "type": "string",
                "enum": [
                  "Enter",
                  "Escape",
                  "Tab",
                  "Backspace",
                  "ArrowUp",
                  "ArrowDown",
                  "ArrowLeft",
                  "ArrowRight"
                ]
              },
              "text": {
                "type": "string",
                "maxLength": 1000
              }
            },
            "required": [
              "kind",
              "key"
            ],
            "additionalProperties": false
          }
        ]
      },
      "AgentTaskInput": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string",
            "minLength": 5,
            "maxLength": 30000
          },
          "budget_micros": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000000000
          },
          "generation": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "specification_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "confirm_agent_task": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "prompt",
          "budget_micros",
          "generation",
          "specification_hash",
          "confirm_agent_task"
        ],
        "additionalProperties": false
      },
      "NodePoll": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "machine_fingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "instance_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "agent_version": {
            "type": "string",
            "const": "1.0.0"
          },
          "physical_host": {
            "type": "boolean",
            "const": true
          },
          "current_session_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              {
                "type": "null"
              }
            ]
          },
          "current_generation": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "machine_fingerprint",
          "instance_id",
          "agent_version",
          "physical_host",
          "current_session_id",
          "current_generation"
        ],
        "additionalProperties": false
      },
      "NodeAcknowledgement": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "instance_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "command_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "session_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "generation": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "outcome": {
            "type": "string",
            "enum": [
              "ready",
              "completed",
              "stopped",
              "failed"
            ]
          },
          "cleanup_verified": {
            "type": "boolean"
          },
          "running_milliseconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 86400000
          },
          "result": {
            "type": "string",
            "maxLength": 16384
          }
        },
        "required": [
          "instance_id",
          "command_id",
          "session_id",
          "generation",
          "outcome",
          "cleanup_verified",
          "running_milliseconds"
        ],
        "additionalProperties": false
      },
      "FrameInput": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "instance_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "session_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "generation": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "sequence": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "png_base64": {
            "type": "string",
            "minLength": 12,
            "maxLength": 700000
          }
        },
        "required": [
          "instance_id",
          "session_id",
          "generation",
          "sequence",
          "png_base64"
        ],
        "additionalProperties": false
      },
      "NodeRegistration": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "plan_key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{2,63}$"
          },
          "machine_fingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "reason": {
            "type": "string",
            "minLength": 8,
            "maxLength": 500
          }
        },
        "required": [
          "name",
          "plan_key",
          "machine_fingerprint",
          "reason"
        ],
        "additionalProperties": false
      },
      "StopInput": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "PlanPublication": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "plan": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{2,63}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "region": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "cpu_cores": {
                "type": "integer",
                "minimum": 1,
                "maximum": 128
              },
              "memory_mib": {
                "type": "integer",
                "minimum": 512,
                "maximum": 1048576
              },
              "disk_mib": {
                "type": "integer",
                "minimum": 1024,
                "maximum": 4194304
              },
              "per_minute_micros": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000000
              },
              "max_minutes": {
                "type": "integer",
                "minimum": 5,
                "maximum": 1440
              },
              "terminal": {
                "type": "boolean"
              },
              "visual": {
                "type": "boolean"
              },
              "reason": {
                "type": "string",
                "minLength": 8,
                "maxLength": 500
              }
            },
            "required": [
              "key",
              "name",
              "region",
              "cpu_cores",
              "memory_mib",
              "disk_mib",
              "per_minute_micros",
              "max_minutes",
              "terminal",
              "visual",
              "reason"
            ],
            "additionalProperties": false
          },
          "enabled": {
            "type": "boolean"
          },
          "expected_version": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "plan",
          "enabled",
          "expected_version"
        ],
        "additionalProperties": false
      },
      "ReasonedCAS": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "expected_version": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "reason": {
            "type": "string",
            "minLength": 8,
            "maxLength": 500
          }
        },
        "required": [
          "expected_version",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "CustomerSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "cp_session"
      },
      "AdminSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "cp_admin_session"
      },
      "NodeBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
