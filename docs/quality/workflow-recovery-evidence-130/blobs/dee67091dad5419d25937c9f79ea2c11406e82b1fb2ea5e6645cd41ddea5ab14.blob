{
  "openapi": "3.1.0",
  "info": {
    "title": "CopyPaste Workmate dedicated cloud computer API",
    "version": "1.0.0",
    "description": "Optional operator-preprovisioned physical computer, exact private files, separate resource and AI task consent. No automatic renewal, provisioning, local Desktop delegation or administrator content access. Node receipts require independently verified cleanup and known usage. Synthetic protocol qualification does not qualify a physical Linux deployment."
  },
