            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "security": [
          {
            "CustomerSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current authorized operation result. Private responses must not be cached."
          },
          "400": {
            "description": "Invalid bounded input"
          },
          "401": {
            "description": "Current authentication required"
          },
          "403": {
            "description": "Scope, consent, MFA or authority unavailable"
          },
          "404": {
            "description": "Private resource unavailable"
          },
          "409": {
            "description": "Stale version, ended lease, changed receipt or unavailable capacity"
          },
          "429": {
            "description": "Rate limit"
          }
        }
      }
    },
