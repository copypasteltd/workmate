import assert from "node:assert/strict";
import {readFile,writeFile,mkdir} from "node:fs/promises";
import {createHash,randomUUID} from "node:crypto";
import path from "node:path";
process.env.DEBUG="pw:browser";
const {runCloudBrowserPreview}=await import("../../src/cloud-browser-preview.ts");
const root=path.resolve(".data/dedicated-cloud-121/browser-close-diagnostic-03");
await mkdir(root,{recursive:false});
const sourceFiles=Object.fromEntries(await Promise.all(["src/cloud-browser-preview.ts","src/cloud-browser-host.cs","src/cloud-browser-runtime.ts"].map(async file=>[file,createHash("sha256").update(await readFile(file)).digest("hex")])));
const rows=[];
for(let round=0;round<3;round++) for(const [label,html] of [["wrong-heading","<h1>Different actual result</h1>"],["script-exception","<h1>Expected</h1><script>throw new Error('actual script failure')</script>"]]){
 const result=await runCloudBrowserPreview(path.join(root,randomUUID()),{entry:"index.html",checks:[{name:"Actual DOM assertion",selector:"h1",expect:{text:"Expected"}}]},[{path:"index.html",bytes:Buffer.from(html)}]);
 const row={round,label,receipt:result.receipt};rows.push(row);
 await writeFile(path.join(root,`${round}-${label}.json`),JSON.stringify(row,null,2)+"\n",{flag:"wx"});
 console.log(JSON.stringify({round,label,passed:result.receipt.passed,stop_reason:result.receipt.stop_reason,exit_code:result.receipt.exit_code,error:result.receipt.check_result.error,host:result.receipt.host}));
 assert.equal(result.receipt.host.job_empty,true);assert.equal(result.receipt.workspace_deleted,true);
}
await writeFile(path.join(root,"summary.json"),JSON.stringify({at:new Date().toISOString(),scope:"Repeated diagnostic of original two failure inputs; no execution or close deadline changed",source_files:sourceFiles,rows},null,2)+"\n",{flag:"wx"});
