{
  "openapi": "3.1.0",
  "info": {
    "title": "Workmate reproducible GEO observations",
    "version": "1.0.0",
    "description": "Additive runtime contract. Internal Codex API observations disable retrieval/business tools and preserve the harness. Consumer samples are user supplied and unverified. Literal aliases and answer links do not establish rankings, entity identity, coverage or causation. Unknown costs remain null. Reads/exports always recheck current private ownership and all retained sources. Capture/cancel are naturally idempotent actions; creates/deletion require idempotency keys. Export/download responses contain original answers and use no-store. Original design OpenAPI files are preserved."
  },
  "paths": {
    "/v1/tenants/{tenant}/projects/{project}/geo/experiments": {
      "get": {
        "operationId": "listGeoExperiments",
        "security": [
          {
            "customerSession": []
          }
        ],
        "parameters": [
          {
            "name": "tenant",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "project",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 30
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Currently authorized retained private result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExperimentList"
                }
              }
            }
          },
          "400": {
            "description": "Input/schema invalid"
          },
          "401": {
            "description": "Current customer session required"
          },
          "403": {
            "description": "Current user, membership or project write permission unavailable"
          },
          "404": {
            "description": "Owned retained content or a transitive source unavailable"
          },
          "409": {
            "description": "Version, idempotency, capability, active-task quota or budget conflict"
          },
          "422": {
            "description": "Unknown question or invalid observation source"
          }
        }
      },
      "post": {
        "operationId": "createGeoExperiment",
        "security": [
          {
            "customerSession": []
          }
        ],
        "parameters": [
          {
            "name": "tenant",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "project",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 16,
              "maxLength": 128,
              "pattern": "^[\\w:-]+$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExperimentCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Currently authorized retained private result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExperimentReceipt"
                }
              }
            }
          },
          "400": {
            "description": "Input/schema invalid"
          },
          "401": {
            "description": "Current customer session required"
          },
          "403": {
            "description": "Current user, membership or project write permission unavailable"
          },
          "404": {
            "description": "Owned retained content or a transitive source unavailable"
          },
          "409": {
            "description": "Version, idempotency, capability, active-task quota or budget conflict"
          },
          "422": {
            "description": "Unknown question or invalid observation source"
          }
        }
      }
    },
