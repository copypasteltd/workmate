  "components": {
    "securitySchemes": {
      "customerSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "cp_session"
      }
    },
    "schemas": {
      "ExperimentCreate": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "spec": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "agent_id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "region": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
              },
              "language": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
              },
              "questions": {
                "minItems": 1,
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9_-]{1,40}$"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 3,
                      "maxLength": 2000
                    }
                  },
                  "required": [
                    "key",
                    "text"
                  ],
                  "additionalProperties": false
                }
              },
              "brands": {
                "minItems": 1,
                "maxItems": 10,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120,
                      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                    },
                    "aliases": {
                      "minItems": 1,
                      "maxItems": 5,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 120,
                        "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                      }
                    }
                  },
                  "required": [
                    "name",
                    "aliases"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "name",
              "agent_id",
              "region",
              "language",
              "questions",
              "brands"
            ],
            "additionalProperties": false
          },
          "previous_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "expected_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "spec"
        ],
        "additionalProperties": false,
        "description": "Runtime additionally requires paired previous_id/expected_sha256, unique question keys/text/brands, an unbranded currently authorized pinned Agent, and creation from the latest immutable version."
      },
      "RunCreate": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "per_question_budget_micros": {
            "type": "string",
            "pattern": "^[1-9]\\d{0,11}$"
          }
        },
        "required": [
          "name",
          "per_question_budget_micros"
        ],
        "additionalProperties": false,
        "description": "Budget is an exact micros string capped at 100000000000; the server reserves all questions atomically under current wallet, capability and active-task quota checks."
      },
      "ManualCreate": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "product": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          },
          "reported_model": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
              },
              {
                "type": "null"
              }
            ]
          },
          "region": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          },
          "language": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          },
          "retrieval": {
            "type": "string",
            "enum": [
              "enabled",
              "disabled",
              "unknown"
            ]
          },
          "observed_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "attested": {
            "type": "boolean",
            "const": true
          },
          "samples": {
            "minItems": 1,
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "question_key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                },
                "answer": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100000
                }
              },
              "required": [
                "question_key",
                "answer"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "name",
          "product",
          "reported_model",
          "region",
          "language",
          "retrieval",
          "observed_at",
          "attested",
          "samples"
        ],
        "additionalProperties": false,
        "description": "Runtime additionally requires unique known question keys, aggregate UTF-8 JSON <=900000 bytes, and observed_at no more than 60 seconds in the future. Attestation is explicit. No model request or model fee is created."
      },
