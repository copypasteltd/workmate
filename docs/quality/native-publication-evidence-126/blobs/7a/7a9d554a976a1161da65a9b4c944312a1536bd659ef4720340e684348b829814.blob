import { createServer, type ServerResponse } from "node:http";
import { randomBytes, randomUUID } from "node:crypto";
import type { Config } from "./config.js";
import { pngFromSVG } from "./render.js";
import { listenLoopbackHTTP } from "./loopback-http.js";
import { demoVectorInput, demoSlidesInput } from "./editable-design-demo.js";
import { publicationDraft as demoPublicationDraft } from "./publication-model.js";

/** A loopback-only, synthetic dependency for development. The Codex kernel,
 * authorization, tool execution, assets, queue and ledger remain real. */
export async function startDemoGateway(c: Config) {
  if (!c.DEMO_MODE || c.NODE_ENV === "production")
    throw new Error("DEMO_MODE_FORBIDDEN");
  const secret = randomBytes(32).toString("hex");
  const seen = new Map<string, unknown>();
  const server = createServer(async (req, res) => {
    const json = (status: number, value: unknown) =>
      res
        .writeHead(status, { "Content-Type": "application/json" })
        .end(JSON.stringify(value));
    if (req.headers.authorization !== `Bearer ${secret}`) {
      json(401, { error: { code: "DEMO_AUTH_REQUIRED" } });
      return;
    }
    if (req.method !== "POST") {
      json(405, { error: { code: "METHOD_NOT_ALLOWED" } });
      return;
    }
    try {
      const chunks: Buffer[] = [];
      let size = 0;
      for await (const part of req) {
        const b = Buffer.from(part);
        size += b.length;
        if (size > 40 * 1024 * 1024) {
          json(413, { error: { code: "PAYLOAD_TOO_LARGE" } });
          return;
        }
        chunks.push(b);
      }
      const bytes = Buffer.concat(chunks);
      if (
        req.url === "/v1/images/generations" ||
        req.url === "/v1/images/edits"
      ) {
        const key = String(req.headers["idempotency-key"] ?? randomUUID());
        if (seen.has(key)) {
          json(200, seen.get(key));
          return;
        }
        const b = req.url.endsWith("generations")
          ? JSON.parse(bytes.toString())
          : {};
        const label = String(b.prompt ?? "Image edit preview")
          .replace(/[<>&"']/g, "")
          .slice(0, 80);
        const png = pngFromSVG(
          `<svg xmlns="http://www.w3.org/2000/svg" width="1024" height="1024"><rect width="1024" height="1024" fill="#ebe8e2"/><path d="M120 210h784v540H120z" fill="#3537d3"/><path d="M120 210l392 290 392-290v540H120z" fill="#2524aa"/><text x="72" y="100" font-family="sans-serif" font-size="36" fill="#202020">COPYPASTE · DEMO / 模擬素材</text><text x="72" y="855" font-family="sans-serif" font-size="22" fill="#202020">${label}</text><text x="72" y="920" font-family="sans-serif" font-size="20" fill="#555">Locally rendered fixture · no AI image service invoked</text></svg>`,
        );
        const result = {
          created: Math.floor(Date.now() / 1000),
          data: [{ b64_json: png.toString("base64") }],
          demo: true,
        };
        seen.set(key, result);
        if (seen.size > 128) seen.delete(seen.keys().next().value!);
        json(200, result);
        return;
      }
      if (req.url === "/v1/responses/input_tokens") {
        const body = JSON.parse(bytes.toString());
        if (body.model !== "copypaste-demo") {
          json(400, { error: { code: "DEMO_MODEL_REQUIRED" } });
          return;
        }
        // This fixture declares its synthetic input usage; no tokenizer or
        // external model is invoked and this never qualifies a live service.
        json(200, { object: "response.input_tokens", input_tokens: 100 });
        return;
      }
      if (req.url !== "/v1/responses") {
        json(404, { error: { code: "NOT_FOUND" } });
        return;
      }
      const b = JSON.parse(bytes.toString());
      if (b.model !== "copypaste-demo") {
        json(400, { error: { code: "DEMO_MODEL_REQUIRED" } });
        return;
      }
      const input: Array<any> = Array.isArray(b.input) ? b.input : [];
      // Only consider tool calls since the latest user message: prior turns
      // must not skip today's work or leak responses between conversations.
      let lastUser = -1;
      for (let i = input.length - 1; i >= 0; i--)
        if (input[i].role === "user") {
          lastUser = i;
          break;
        }
      const current = input.slice(lastUser < 0 ? 0 : lastUser);
      const used = (name: string) =>
        current.some((i) => i.type === "function_call" && i.name === name);
      const tools: Array<any> = b.tools ?? [];
      const find = (suffix: string) =>
        tools.find(
          (t) =>
            t.type === "function" &&
            (t.name === suffix || t.name?.endsWith("__" + suffix)),
        );
      const requested = JSON.stringify(
        input.filter((i) => i.role === "user").at(-1) ?? "",
      );
      const reportTool = find("analysis_report_facts");
      const publicationAccounts = find("publication_accounts"),
        publicationPreview = find("publication_preview"),
        publicationPrepare = find("publication_prepare"),
        publicationStatus = find("publication_status");
      const analysisSources = find("analysis_sources");
      const sheetCalculate = find("sheet_calculate");
      const chartRender = find("chart_render");
      const analysisSourceRead = find("analysis_source_read");
      const vectorRender = find("vector_render"),
        slidesBuild = find("slides_build"),
        slidesRender = find("slides_render"),
        designSourceRead = find("design_source_read");
      const workflowValidate = find("workflow_validate"),
        workflowSave = find("workflow_save"),
        workflowRead = find("workflow_read"),
        workflowPublish = find("workflow_publish"),
        workflowRun = find("workflow_run");
      const schedulePreview = find("workflow_schedule_preview"),
        scheduleRequest = find("workflow_schedule_request"),
        scheduleDemo = requested.includes("schedule_demo=confirmed");
      const eventPreview = find("workflow_event_preview"),
        eventRequest = find("workflow_event_request"),
        eventDemo = requested.includes("event_demo=confirmed");
      const eventDemoArgs = (published: any) => ({
        name: "Harbour incoming campaign review",
        event_type: "campaign.ready",
        timezone: "Asia/Hong_Kong",
        overlap_policy: "latest",
        min_interval_seconds: 10,
        max_runs_per_day: 3,
        max_event_age_seconds: 3600,
        ends_at: new Date(Date.now() + 86400_000).toISOString(),
        expected_output:
          "Review the fixed campaign evidence, wait for my approval and prepare a private note.",
        workflow_id: published.workflow.id,
        workflow_version: published.workflow.version,
        workflow_definition_hash: published.definition_hash,
      });
      const scheduleDemoArgs = (published: any) => ({
        name: "Harbour daily campaign review",
        calendar: {
          timezone: "Asia/Hong_Kong",
          frequency: "daily",
          time: "09:00",
          weekdays: [],
        },
        catch_up: "latest",
        ends_at: null,
        expected_output:
          "Review the fixed campaign summary, wait for my approval and prepare a private campaign note.",
        workflow_id: published.workflow.id,
        workflow_version: published.workflow.version,
        workflow_definition_hash: published.definition_hash,
      });
      // Read only this turn's actual outputs. Synthetic requests must use real
      // source IDs, definitions, calculation hashes and revision identities.
      const toolOutputs = (
        name: string | undefined,
        predicate: (v: any) => boolean,
      ) => {
        if (!name) return [];
        const calls = new Set(
          current
            .filter((i) => i.type === "function_call" && i.name === name)
            .map((i) => i.call_id),
        );
        const found: any[] = [];
        const collect = (value: any, depth = 0): void => {
          if (depth > 12 || value == null) return;
          if (typeof value === "string") {
            try {
              collect(JSON.parse(value), depth + 1);
            } catch {
              /* Other tool text is not a receipt. */
            }
          } else if (Array.isArray(value))
            value.forEach((v) => collect(v, depth + 1));
          else if (typeof value === "object") {
            if (predicate(value)) {
              found.push(value);
              return;
            }
            Object.values(value).forEach((v) => collect(v, depth + 1));
          }
        };
        current
          .filter(
            (i) => i.type === "function_call_output" && calls.has(i.call_id),
          )
          .forEach((i) => collect(i.output));
        return found;
      };
      const publicationDirectory = toolOutputs(
        publicationAccounts?.name,
        (v) => v.data_mode === "synthetic" && Array.isArray(v.items),
      ).at(-1);
      const publicationFrozenPreview = toolOutputs(
        publicationPreview?.name,
        (v) => typeof v.preview_id === "string" && typeof v.payload_sha256 === "string",
      ).at(-1);
      const publicationPending = toolOutputs(
        publicationPrepare?.name,
        (v) => typeof v.id === "string" && v.state === "awaiting_confirmation",
      ).at(-1);
      const analysisDirectory = toolOutputs(
        analysisSources?.name,
        (v) => v.kind === "frozen_analysis_datasets",
      ).at(-1);
      const analysisFacts = toolOutputs(
        sheetCalculate?.name,
        (v) =>
          typeof v.calculation_sha256 === "string" && Array.isArray(v.scopes),
      ).at(-1);
      const priorAnalysis = toolOutputs(
        analysisSourceRead?.name,
        (v) =>
          typeof v.source_version_id === "string" && v.render?.specification,
      ).at(-1);
      const savedWorkflow = toolOutputs(
        workflowSave?.name,
        (v) => v.workflow?.id && typeof v.definition_hash === "string",
      ).at(-1);
      const publishedWorkflow = toolOutputs(
        workflowPublish?.name,
        (v) =>
          v.workflow?.state === "published" &&
          typeof v.definition_hash === "string",
      ).at(-1);
      const readWorkflow = toolOutputs(
        workflowRead?.name,
        (v) => v.workflow?.id && v.selected?.definition,
      ).at(-1);
      const workflowRevision = requested.match(
        /workflow_revision_id\s*=\s*([a-f\d-]{36})/i,
      )?.[1];
      const sourceRequest = requested.match(
        /revision_source_version\s*=\s*([a-f\d-]{36})/i,
      )?.[1];
      const effectCatalog = find("effects_catalog"),
        effectRender = find("effect_render");
      const effectWork = requested.includes("copypaste-media-effect-1");
      const approvedEffect = toolOutputs(
        effectCatalog?.name,
        (v) => v.approved_request?.schema === "copypaste-media-effect-1",
      ).at(-1)?.approved_request;
      const designRevision = requested.match(
        /design_revision_source_version\s*=\s*([a-f\d-]{36})/i,
      )?.[1];
      const priorDesign = toolOutputs(
        designSourceRead?.name,
        (v) =>
          v.schema === "copypaste-editable-design-1" &&
          v.input &&
          typeof v.sha256 === "string",
      ).at(-1);
      const preparedSlides = toolOutputs(
        slidesBuild?.name,
        (v) =>
          v.schema === "copypaste-editable-design-1" &&
          v.state === "prepared" &&
          typeof v.source_version_id === "string",
      ).at(-1);
      const seoTool = find("seo_audit_facts");
      const changeTool = find("seo_change_facts");
      const changePages: any[] = [];
      const changeCalls = new Set(
        current
          .filter(
            (i) => i.type === "function_call" && i.name === changeTool?.name,
          )
          .map((i) => i.call_id),
      );
      const collectChangePages = (value: any, depth = 0): void => {
        if (depth > 12 || value == null) return;
        if (typeof value === "string") {
          try {
            collectChangePages(JSON.parse(value), depth + 1);
          } catch {
            /* Other text is not a synthetic tool receipt. */
          }
        } else if (Array.isArray(value))
          value.forEach((item) => collectChangePages(item, depth + 1));
        else if (typeof value === "object") {
          if (
            typeof value.change_id === "string" &&
            typeof value.spec_hash === "string" &&
            Array.isArray(value.items)
          ) {
            changePages.push(value);
            return;
          }
          Object.values(value).forEach((item) =>
            collectChangePages(item, depth + 1),
          );
        }
      };
      current
        .filter(
          (i) =>
            i.type === "function_call_output" && changeCalls.has(i.call_id),
        )
        .forEach((i) => collectChangePages(i.output));
      const lastChangePage = changePages.at(-1);
      const latestUser = input.filter((i) => i.role === "user").at(-1);
      const latestText =
        typeof latestUser?.content === "string"
          ? latestUser.content
          : (latestUser?.content ?? [])
              .map((v: any) => v.text ?? "")
              .join("\n");
      // This fixture accepts an explicit complete draft, never an invented account
      // or media version. Real models use the same ordinary guarded tools.
      const publicationMarker = "Approved simulated publication draft:";
      const publicationLines = latestText.split(/\r?\n/).filter((line: string) => line.startsWith(publicationMarker));
      const publicationWork = publicationLines.length > 0;
      let publicationRequest: ReturnType<typeof demoPublicationDraft.parse> | undefined;
      if (publicationLines.length === 1) {
        try {
          const parsed = demoPublicationDraft.safeParse(JSON.parse(publicationLines[0].slice(publicationMarker.length).trim()));
          if (parsed.success) publicationRequest = parsed.data;
        } catch { /* Invalid input cannot allocate a preview or prepare an operation. */ }
      }
      const publicationTarget = publicationDirectory?.items.find((item: any) => item.id === publicationRequest?.target_id);
      const publicationAllowed = publicationTarget?.enabled === true && publicationTarget?.policy?.enabled === true &&
        publicationTarget?.policy?.formats?.includes(publicationRequest?.format) &&
        publicationTarget?.capabilities?.formats?.includes(publicationRequest?.format);
      const methodWork = latestText.includes(
        "Execute this exact reviewed reusable method",
      );
      let methodInputs: any = {},
        reportingInputs: any[] = [];
      if (methodWork) {
        try {
          methodInputs = JSON.parse(
            latestText.match(/Approved fixed inputs:\s*(\{[^\n]+\})/)?.[1] ??
              "{}",
          );
          reportingInputs = JSON.parse(
            latestText.match(
              /Fixed captured reporting sources:\s*(\[[^\n]*\])/,
            )?.[1] ?? "[]",
          );
        } catch {
          /* Malformed synthetic prompts cannot fabricate source reads. */
        }
      }
      const methodSource = find("solution_source_read"),
        methodReader = find("solution_read"),
        capturedReader = find("connector_read");
      const consumed = toolOutputs(
        methodSource?.name,
        (v) =>
          typeof v.asset_version_id === "string" && typeof v.text === "string",
      );
      const nextMethodInput = methodInputs.assets?.find(
        (v: any) =>
          !consumed.some(
            (r: any) =>
              r.asset_version_id === v.asset_version_id &&
              r.sha256 === v.sha256,
          ),
      );
      const nextReportingInput = reportingInputs.find(
        (v: any) =>
          !current.some(
            (i) =>
              i.type === "function_call" &&
              i.name === capturedReader?.name &&
              JSON.parse(i.arguments || "{}").snapshot_id === v.snapshot_id,
          ),
      );
      const installedMethod = latestText.match(
        /solution_read tool with installation_id ([a-f\d-]{36})/i,
      )?.[1];
      let tool: any, args: any;
      if (publicationWork) {
        if (publicationRequest && publicationAccounts && !used(publicationAccounts.name)) {
          tool = publicationAccounts;
          args = {};
        } else if (publicationRequest && publicationAllowed && publicationPreview && publicationPrepare && !used(publicationPreview.name)) {
          tool = publicationPreview;
          args = publicationRequest;
        } else if (publicationFrozenPreview && publicationPrepare && !used(publicationPrepare.name)) {
          tool = publicationPrepare;
          args = { preview_id: publicationFrozenPreview.preview_id, payload_sha256: publicationFrozenPreview.payload_sha256 };
        } else if (publicationPending && publicationStatus && !used(publicationStatus.name)) {
          tool = publicationStatus;
          args = { operation_id: publicationPending.id };
        }
      } else if (methodWork) {
        // Only model decisions are synthetic. Actual Codex tools read the
        // customer's approved versions and the normal worker records provenance.
        if (nextMethodInput && methodSource) {
          tool = methodSource;
          args = { asset_version_id: nextMethodInput.asset_version_id };
        } else if (nextReportingInput && capturedReader) {
          tool = capturedReader;
          args = {
            snapshot_id: nextReportingInput.snapshot_id,
            offset: 0,
            limit: 12,
          };
        }
      } else if (installedMethod && methodReader && !used(methodReader.name)) {
        tool = methodReader;
        args = { installation_id: installedMethod };
      } else if (effectWork && effectCatalog && !used(effectCatalog.name)) {
        tool = effectCatalog;
        args = {};
      } else if (
        effectWork &&
        effectRender &&
        approvedEffect &&
        !used(effectRender.name)
      ) {
        tool = effectRender;
        args = { request: approvedEffect };
      } else if (effectWork && effectRender) {
        // Synthetic model instructions only. Media, permissions, the actual
        // Codex process and file/budget accounting still execute normally.
      } else if (
        find("capability_probe") &&
        !used(find("capability_probe").name)
      ) {
        tool = find("capability_probe");
        args = { nonce: tool.parameters?.properties?.nonce?.enum?.[0] };
      } else if (
        designRevision &&
        designSourceRead &&
        !used(designSourceRead.name)
      ) {
        tool = designSourceRead;
        args = { source_version_id: designRevision };
      } else if (
        vectorRender &&
        !used(vectorRender.name) &&
        (!designRevision || priorDesign)
      ) {
        tool = vectorRender;
        args = demoVectorInput(!!priorDesign);
        if (priorDesign)
          args.revision_of = {
            source_version_id: priorDesign.source_version_id,
            sha256: priorDesign.sha256,
          };
      } else if (
        slidesBuild &&
        !used(slidesBuild.name) &&
        (!designRevision || priorDesign)
      ) {
        tool = slidesBuild;
        args = demoSlidesInput(!!priorDesign);
        if (priorDesign)
          args.revision_of = {
            source_version_id: priorDesign.source_version_id,
            sha256: priorDesign.sha256,
          };
      } else if (slidesRender && preparedSlides && !used(slidesRender.name)) {
        tool = slidesRender;
        args = {
          source_version_id: preparedSlides.source_version_id,
          sha256: preparedSlides.sha256,
        };
      } else if (vectorRender || slidesBuild) {
        // The synthetic role finishes after its actual design file tools. Do
        // not invent unrelated analytics, images or a second delivery.
      } else if (
        workflowSave &&
        workflowRevision &&
        workflowRead &&
        !used(workflowRead.name)
      ) {
        tool = workflowRead;
        args = { workflow_id: workflowRevision };
      } else if (
        workflowSave &&
        analysisSources &&
        !used(analysisSources.name)
      ) {
        tool = analysisSources;
        args = { kind: "datasets" };
      } else if (
        workflowSave &&
        workflowValidate &&
        !used(workflowValidate.name)
      ) {
        tool = workflowValidate;
        const definition = readWorkflow
          ? structuredClone(readWorkflow.selected.definition)
          : {
              steps: [
                ...(analysisDirectory?.items?.length
                  ? [
                      {
                        kind: "analytics.summary",
                        dataset_id: analysisDirectory.items[0].id,
                      },
                    ]
                  : []),
                {
                  kind: "approval",
                  message:
                    "Review the clearly simulated campaign evidence before creating the final note.",
                },
                {
                  kind: "codex",
                  role_key: "assistant",
                  prompt:
                    "Write a clearly simulated campaign review note using only actual authorized prior step receipts.",
                  budget_micros: 100000,
                },
              ],
            };
        if (readWorkflow)
          definition.steps.find((s: any) => s.kind === "approval").message =
            "Review the revised campaign procedure and confirm the retained source before continuing.";
        args = { definition };
      } else if (workflowSave && !used(workflowSave.name)) {
        const checked = toolOutputs(
          workflowValidate?.name,
          (v) => v.definition?.steps && typeof v.definition_hash === "string",
        ).at(-1);
        if (checked) {
          tool = workflowSave;
          args = {
            name: readWorkflow
              ? "Campaign review · revised procedure"
              : "Campaign review · private workflow",
            definition: checked.definition,
            ...(readWorkflow
              ? {
                  workflow_id: readWorkflow.workflow.id,
                  expected_version: readWorkflow.workflow.version,
                }
              : {}),
          };
        }
      } else if (
        workflowPublish &&
        savedWorkflow &&
        !used(workflowPublish.name)
      ) {
        tool = workflowPublish;
        args = {
          workflow_id: savedWorkflow.workflow.id,
          expected_version: savedWorkflow.workflow.version,
        };
      } else if (
        scheduleDemo &&
        schedulePreview &&
        publishedWorkflow &&
        !used(schedulePreview.name)
      ) {
        tool = schedulePreview;
        args = scheduleDemoArgs(publishedWorkflow);
      } else if (
        scheduleDemo &&
        scheduleRequest &&
        publishedWorkflow &&
        !used(scheduleRequest.name)
      ) {
        tool = scheduleRequest;
        args = scheduleDemoArgs(publishedWorkflow);
      } else if (
        eventDemo &&
        eventPreview &&
        publishedWorkflow &&
        !used(eventPreview.name)
      ) {
        tool = eventPreview;
        args = eventDemoArgs(publishedWorkflow);
      } else if (
        eventDemo &&
        eventRequest &&
        publishedWorkflow &&
        !used(eventRequest.name)
      ) {
        tool = eventRequest;
        const preview = toolOutputs(
          eventPreview?.name,
          (v) => v.body?.event_type === "campaign.ready",
        ).at(-1);
        args = {
          ...eventDemoArgs(publishedWorkflow),
          ...(preview ? { ends_at: preview.body.ends_at } : {}),
        };
      } else if (
        workflowRun &&
        !scheduleDemo &&
        !eventDemo &&
        publishedWorkflow &&
        !used(workflowRun.name)
      ) {
        tool = workflowRun;
        args = {
          workflow_id: publishedWorkflow.workflow.id,
          version: publishedWorkflow.workflow.version,
          definition_hash: publishedWorkflow.definition_hash,
        };
      } else if (
        sheetCalculate &&
        sourceRequest &&
        analysisSourceRead &&
        !used(analysisSourceRead.name)
      ) {
        tool = analysisSourceRead;
        args = { source_version_id: sourceRequest };
      } else if (
        sheetCalculate &&
        analysisSources &&
        !priorAnalysis &&
        !used(analysisSources.name)
      ) {
        tool = analysisSources;
        args = { kind: "datasets" };
      } else if (
        sheetCalculate &&
        !used(sheetCalculate.name) &&
        (priorAnalysis || analysisDirectory?.items?.length)
      ) {
        tool = sheetCalculate;
        const source = analysisDirectory?.items[0];
        const specification = priorAnalysis
          ? { ...priorAnalysis.render.specification }
          : {
              prompt:
                "Explicitly synthetic campaign evidence and creative review",
              snapshot_ids: analysisDirectory.items
                .slice(0, 10)
                .map((s: any) => s.id),
              date_from: source.date_range.from,
              date_to: source.date_range.to,
              timezone: source.timezone,
              currency_policy: "group_by_currency",
              metrics: ["spend", "ctr", "cpa", "roas"],
              dimensions: [],
            };
        if (priorAnalysis && /revise_to_last_day=true/.test(requested))
          specification.date_from = specification.date_to;
        args = { specification };
      } else if (
        chartRender &&
        analysisFacts?.scopes?.length &&
        !used(chartRender.name)
      ) {
        tool = chartRender;
        args = {
          specification: analysisFacts.specification,
          calculation_sha256: analysisFacts.calculation_sha256,
          title: priorAnalysis
            ? "Campaign evidence · revised review"
            : "Campaign evidence · creative review",
          locale: /report_locale=zh-HK/.test(requested) ? "zh-HK" : "en-HK",
          metrics: ["spend", "ctr"],
          scope_ids: analysisFacts.scopes.slice(0, 8).map((s: any) => s.id),
          ...(priorAnalysis
            ? {
                revision_of: {
                  source_version_id: priorAnalysis.source_version_id,
                  sha256: priorAnalysis.sha256,
                },
              }
            : {}),
        };
      } else if (reportTool && !used(reportTool.name)) {
        tool = reportTool;
        args = {};
      } else if (seoTool && !used(seoTool.name)) {
        tool = seoTool;
        args = {};
      } else if (
        changeTool &&
        (!used(changeTool.name) ||
          (lastChangePage && lastChangePage.next_offset !== null))
      ) {
        tool = changeTool;
        args = lastChangePage ? { offset: lastChangePage.next_offset } : {};
      } else if (
        !reportTool &&
        !sheetCalculate &&
        !workflowSave &&
        find("image2_generate") &&
        !used(find("image2_generate").name)
      ) {
        tool = find("image2_generate");
        args = {
          prompt:
            "Demonstration campaign visual with a blue folded-paper motif",
          filename: "demo-campaign.png",
        };
      } else if (
        find("code_write") &&
        find("code_read") &&
        !used(find("code_read").name)
      ) {
        tool = find("code_read");
        args = { path: "demo.html" };
      } else if (find("code_write") && !used(find("code_write").name)) {
        tool = find("code_write");
        const readCall = current.find(
          (i) =>
            i.type === "function_call" && i.name === find("code_read")?.name,
        );
        const readResult = current.find(
          (i) =>
            i.type === "function_call_output" &&
            i.call_id === readCall?.call_id,
        );
        const digest = (
          typeof readResult?.output === "string"
            ? readResult.output
            : JSON.stringify(readResult?.output ?? "")
        ).match(/sha256[^a-f0-9]*([a-f0-9]{64})/)?.[1];
        args = {
          path: "demo.html",
          ...(digest ? { expected_sha256: digest } : {}),
          content:
            '<!doctype html><html lang="zh-HK"><meta charset="utf-8"><title>CopyPaste demo</title><h1>CopyPaste · 模擬交付</h1><p>Local fixture source. No implementation or tests by an AI model are claimed.</p></html>',
        };
      } else if (
        find("code_package") &&
        used(find("code_write")?.name) &&
        !used(find("code_package").name)
      ) {
        tool = find("code_package");
        args = { filename: "demo-source.zip" };
      } else if (find("group_results") && !used(find("group_results").name)) {
        tool = find("group_results");
        args = {};
      } else if (
        !sheetCalculate &&
        !workflowSave &&
        find("design_render") &&
        !used(find("design_render").name)
      ) {
        tool = find("design_render");
        args = {
          filename: "demo-layout",
          format: /video|mp4|影片|視頻/i.test(requested) ? "mp4" : "png",
          duration: 3,
          effect: "fade",
          document: {
            width: 768,
            height: 768,
            background: "#ebe8e2",
            layers: [
              {
                type: "rect",
                x: 48,
                y: 48,
                width: 672,
                height: 490,
                color: "#3537d3",
                radius: 0,
              },
              {
                type: "text",
                x: 64,
                y: 620,
                text: "COPYPASTE · DEMO",
                font_size: 40,
                color: "#202020",
                font_family: "sans",
                weight: "bold",
              },
            ],
          },
        };
      } else if (
        !sheetCalculate &&
        !workflowSave &&
        find("deliver_text") &&
        !used(find("deliver_text").name)
      ) {
        tool = find("deliver_text");
        args = {
          filename: "demo-report.md",
          content:
            "# 模擬工作成果 / Simulated deliverable\n\n此內容由本機固定規則產生，用來驗證 Codex、工具、權限、產物和模擬計費流程。它不是 AI 模型的真實分析。\n\nThis is a deterministic local fixture for workflow testing. It is not real model analysis.",
          mime_type: "text/markdown",
        };
      }
      function evidenceReference(value: any, depth = 0): string | undefined {
        if (depth > 12 || value == null) return;
        if (typeof value === "string") {
          try {
            return evidenceReference(JSON.parse(value), depth + 1);
          } catch {
            return;
          }
        }
        if (typeof value !== "object") return;
        if (
          typeof value.metric_id === "string" &&
          typeof value.snapshot_id === "string" &&
          typeof value.id === "string"
        )
          return value.id;
        if (
          typeof value.id === "string" &&
          typeof value.data_mode === "string" &&
          typeof value.page_requests === "number"
        )
          return value.id;
        for (const item of Object.values(value)) {
          const id = evidenceReference(item, depth + 1);
          if (id) return id;
        }
      }
      const evidenceId = evidenceReference(
        current.filter((i) => i.type === "function_call_output"),
      );
      const reportText = JSON.stringify({
        observations: [
          {
            text: `Simulated observation / 模擬觀察: {{${evidenceId}}}`,
            evidence_ids: [evidenceId],
          },
        ],
        hypotheses: [],
        next_steps: [
          "Review source coverage and verify attribution before changing a campaign. / 先核對資料覆蓋和歸因口徑，再調整活動。",
        ],
      });
      const item = tool
        ? {
            id: "fc_" + randomUUID(),
            type: "function_call",
            name: tool.name,
            call_id: "call_" + randomUUID(),
            arguments: JSON.stringify(args),
          }
        : {
            id: "msg_" + randomUUID(),
            type: "message",
            role: "assistant",
            status: "completed",
            content: [
              {
                type: "output_text",
                text: publicationWork
                  ? publicationPending
                    ? `【演示資料 / Simulated data】已准备待客户确认的发布操作 ${publicationPending.id}。请由原客户在发布页面核对确切内容并明确确认；工具不能代替客户确认，实际发布状态以操作回执为准。\n\nPrepared an operation awaiting the original customer's explicit confirmation. Review it in Publishing; these tools cannot approve it. Check its receipt for the actual publication state.`
                    : "【演示資料 / Simulated data】未准备任何发布操作。请核对完整草稿、当前账户策略和执行模式。 / No publication was prepared. Review the complete draft, current account policy and execution mode."
                  : changeTool
                  ? JSON.stringify({
                      changes: changePages
                        .flatMap((page) => page.items)
                        .map((f) => ({
                          finding_id: f.id,
                          rationale:
                            "Synthetic draft grounded in the selected retained finding. / 依據已選原始問題的模擬修改草稿。",
                          proposed_change:
                            "Review the retained URL and prepare the corresponding source correction for human approval. No website change has been applied. / 請人工審核對應頁面修訂；網站尚未修改。",
                          verification: [
                            "Review the source correction manually, then explicitly recheck the same authorized website scope. / 人工核對修改後，明確發起同範圍復查。",
                          ],
                        })),
                    })
                  : reportTool || seoTool
                    ? reportText
                    : "【演示資料 / Simulated data】此回覆由本機模擬服務產生。Codex、授權、工具執行及產物保存流程已運行；內容和用量為測試資料。請在素材與交付查看產物。\n\nThis response uses deterministic test data. Codex and product workflow operations ran locally. Content and usage are synthetic.",
                annotations: [],
              },
            ],
          };
      sendResponse(res, item);
    } catch {
      if (!res.headersSent)
        json(400, { error: { code: "DEMO_REQUEST_INVALID" } });
      else res.end();
    }
  });
  server.requestTimeout = 30_000;
  server.headersTimeout = 10_000;
  const port = await listenLoopbackHTTP(server);
  return {
    config: {
      ...c,
      AI_BASE_URL: `http://127.0.0.1:${port}/v1`,
      AI_ALLOWED_HOSTS: "127.0.0.1",
      AI_API_KEY: secret,
      AI_MODEL: "copypaste-demo",
      AI_IMAGE_MODEL: "copypaste-demo-image",
      AI_VERIFIED: true,
      AI_IMAGE_VERIFIED: true,
      // This local synthetic gateway implements text/images only. An inherited
      // live-video flag must not advertise an unsupported generation endpoint.
      AI_VIDEO_VERIFIED: false,
      AI_INPUT_COUNT_VERIFIED: true,
      AI_INPUT_COUNT_HKD_MICROS_PER_CALL: 0,
      AI_INPUT_HKD_MICROS_PER_MILLION: 1000000,
      AI_OUTPUT_HKD_MICROS_PER_MILLION: 1000000,
      AI_IMAGE_HKD_MICROS_PER_IMAGE: 10000,
    },
    close: () =>
      new Promise<void>((resolve, reject) => {
        server.close((e) => (e ? reject(e) : resolve()));
        server.closeAllConnections();
      }),
  };
}
function sendResponse(res: ServerResponse, item: any) {
  res.writeHead(200, {
    "Content-Type": "text/event-stream",
    "Cache-Control": "no-cache",
  });
  let sequence = 0;
  const event = (type: string, data: any) =>
    res.write(
      `event: ${type}\ndata: ${JSON.stringify({ type, sequence_number: sequence++, ...data })}\n\n`,
    );
  const response = {
    id: "resp_" + randomUUID(),
    object: "response",
    model: "copypaste-demo",
    created_at: Math.floor(Date.now() / 1000),
    status: "in_progress",
    output: [],
  };
  event("response.created", { response });
  event("response.output_item.added", {
    output_index: 0,
    item:
      item.type === "function_call"
        ? { ...item, arguments: "" }
        : { ...item, status: "in_progress", content: [] },
  });
  if (item.type === "function_call") {
    event("response.function_call_arguments.delta", {
      output_index: 0,
      item_id: item.id,
      delta: item.arguments,
    });
    event("response.function_call_arguments.done", {
      output_index: 0,
      item_id: item.id,
      arguments: item.arguments,
    });
  } else {
    const base = { item_id: item.id, output_index: 0, content_index: 0 };
    event("response.content_part.added", {
      ...base,
      part: { type: "output_text", text: "", annotations: [] },
    });
    event("response.output_text.delta", {
      ...base,
      delta: item.content[0].text,
    });
    event("response.output_text.done", { ...base, text: item.content[0].text });
  }
  event("response.output_item.done", { output_index: 0, item });
  event("response.completed", {
    response: {
      ...response,
      status: "completed",
      output: [item],
      usage: {
        input_tokens: 100,
        output_tokens: 50,
        total_tokens: 150,
        input_tokens_details: { cached_tokens: 0 },
        output_tokens_details: { reasoning_tokens: 0 },
      },
      metadata: { demo: "true" },
    },
  });
  res.end();
}
