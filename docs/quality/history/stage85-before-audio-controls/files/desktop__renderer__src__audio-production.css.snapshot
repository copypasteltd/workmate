.audio-productions { min-width: 0; margin: 24px 0; }
.audio-heading { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin-bottom: 16px; }
.audio-heading .eyebrow { flex-basis: 100%; }
.audio-heading h3 { margin: 0; }
.audio-heading .text-button { margin-left: auto; }
.audio-card { min-width: 0; padding: 20px; border: 1px solid var(--line); border-radius: 16px; background: var(--surface); margin: 12px 0; overflow-wrap: anywhere; }
.audio-card > header { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
.audio-card > header > div { flex: 1; min-width: 100px; }
.audio-card header p { color: var(--muted); font-size: 12px; margin: 5px 0 0; }
.audio-icon { width: 42px; height: 42px; display: grid; place-items: center; border-radius: 12px; background: var(--warm); color: var(--blue); }
.audio-card dl { display: flex; flex-wrap: wrap; gap: 16px 28px; margin: 18px 0; }
.audio-card dl > div { min-width: 0; }
.audio-card dt { color: var(--muted); font-size: 12px; }
.audio-card dd { margin: 6px 0 0; font-variant-numeric: tabular-nums; }
.audio-actions,.audio-downloads { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
.audio-actions .button,.audio-downloads button { max-width: 100%; min-width: 0; white-space: normal; }
.audio-review { margin-top: 18px; padding-top: 18px; border-top: 1px solid var(--line); min-width: 0; }
.audio-preview audio { display: block; width: 100%; max-width: 100%; }
.audio-downloads { margin-top: 18px; }
.audio-transcript label { display: grid; gap: 8px; min-width: 0; font-size: 13px; }
.audio-transcript select,.audio-transcript input,.audio-transcript textarea { width: 100%; min-width: 0; max-width: 100%; box-sizing: border-box; }
.audio-transcript-text { white-space: pre-wrap; overflow-wrap: anywhere; line-height: 1.75; padding: 16px; border-radius: 12px; background: var(--warm); }
.audio-subtitle-form { display: grid; gap: 16px; margin-top: 16px; min-width: 0; }
.audio-cue { display: grid; gap: 12px; padding: 14px; border: 1px solid var(--line); border-radius: 12px; min-width: 0; }
.audio-cue legend { color: var(--muted); font-size: 12px; }
.audio-time-fields { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 12px; }
.audio-subtitle-form textarea { resize: vertical; }
@media(max-width: 600px) { .audio-card { padding: 16px; } }
