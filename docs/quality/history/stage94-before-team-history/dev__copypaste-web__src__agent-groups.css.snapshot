.team-page {
  max-width: 1160px;
  margin-inline: auto;
}
.team-page .team-editable-fields {
  padding: 0;
  margin: 0;
  border: 0;
  min-width: 0;
}
.team-editable-fields > label {
  margin-bottom: 22px;
}
.team-reviewed-brief {
  padding: 14px 18px;
  border-left: 3px solid var(--blue);
  background: var(--bg);
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}
.team-review li p {
  font-size: 0.8rem;
  color: var(--muted);
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}
.team-page label {
  display: grid;
  gap: 8px;
  font-size: 0.84rem;
  font-weight: 600;
  min-width: 0;
}
.team-page input,
.team-page select,
.team-page textarea,
.team-editor input,
.team-editor select,
.team-editor textarea {
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
  padding: 11px 13px;
  border: 1px solid var(--line);
  border-radius: 9px;
  background: var(--surface);
  color: var(--ink);
  font: inherit;
  line-height: 1.6;
  transition: border-color 160ms ease;
}
.team-page textarea,
.team-editor textarea {
  resize: vertical;
  min-height: 88px;
}
.team-page input:disabled,
.team-page select:disabled,
.team-page textarea:disabled {
  opacity: 0.65;
}
.team-directory {
  display: flex;
  align-items: end;
  gap: 10px;
  margin: 26px 0;
}
.team-directory > label {
  flex: 1;
  max-width: 440px;
}
.team-overview,
.team-planner,
.team-runs {
  margin-block: 24px;
  padding: 30px;
  border: 1px solid var(--line);
  border-radius: 16px;
  background: var(--surface);
  min-width: 0;
}
.team-overview {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 22px;
}
.team-overview h2,
.team-section-title h2 {
  font-size: 1.55rem;
  margin: 8px 0;
  letter-spacing: -0.04em;
}
.team-overview .muted {
  max-width: 560px;
  font-size: 0.86rem;
  line-height: 1.7;
}
.team-actions {
  display: flex;
  align-items: start;
  flex-wrap: wrap;
  gap: 8px;
}
.team-members {
  grid-column: 1 / -1;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr));
  gap: 12px;
}
.team-members article {
  display: flex;
  gap: 13px;
  border: 1px solid var(--line);
  padding: 18px;
  border-radius: 10px;
  min-width: 0;
}
.team-member-icon {
  display: grid;
  place-items: center;
  width: 34px;
  height: 34px;
  border-radius: 9px;
  background: var(--warm);
  color: var(--ink);
  flex: 0 0 auto;
}
.team-coordinator .team-member-icon {
  color: var(--blue);
  background: var(--blue-soft);
}
.team-members strong {
  display: block;
  font-size: 0.9rem;
  overflow-wrap: anywhere;
}
.team-members small {
  display: block;
  color: var(--muted);
  font-size: 0.72rem;
  margin-bottom: 6px;
}
.team-members p {
  margin: 8px 0 0;
  color: var(--muted);
  font-size: 0.8rem;
  line-height: 1.6;
  overflow-wrap: anywhere;
}
.team-overview details {
  grid-column: 1 / -1;
  font-size: 0.82rem;
}
.team-overview summary {
  cursor: pointer;
  padding-block: 6px;
}
.team-version {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  padding-block: 12px;
  border-top: 1px solid var(--line);
  overflow-wrap: anywhere;
}
.team-version span {
  color: var(--muted);
}
.team-section-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 14px;
  margin-bottom: 24px;
}
.team-private {
  display: flex;
  align-items: center;
  gap: 6px;
  color: var(--muted);
  font-size: 0.76rem;
}
.team-planner > label {
  margin-bottom: 22px;
}
.team-step-list {
  display: grid;
  gap: 16px;
  margin-bottom: 16px;
}
.team-step {
  border: 1px solid var(--line);
  border-radius: 12px;
  padding: 22px;
  background: var(--bg);
}
.team-step-heading {
  display: flex;
  gap: 12px;
  align-items: center;
  margin-bottom: 18px;
}
.team-step-heading > .icon-button {
  margin-left: auto;
}
.team-step-heading strong {
  font-size: 0.86rem;
}
.team-step-number {
  background: var(--blue-soft);
  color: var(--blue);
  font-size: 0.76rem;
  font-weight: 700;
  padding: 7px 9px;
  border-radius: 7px;
}
.team-input-pair {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18px;
  margin-bottom: 16px;
}
.team-step-footer {
  display: flex;
  gap: 18px;
  align-items: end;
  justify-content: space-between;
  margin-top: 18px;
}
.team-step fieldset {
  border: 0;
  margin: 0;
  padding: 0;
  display: grid;
  gap: 8px;
  min-width: 0;
}
.team-step legend {
  font-size: 0.76rem;
  color: var(--muted);
  margin-bottom: 8px;
}
.team-page label.team-check {
  display: flex;
  align-items: center;
  font-size: 0.78rem;
  font-weight: 400;
  overflow-wrap: anywhere;
}
.team-page .team-check input {
  width: 16px;
  height: 16px;
  accent-color: var(--blue);
  flex-shrink: 0;
  padding: 0;
}
.team-budget {
  width: 180px;
  max-width: 100%;
  flex: 0 0 auto;
}
.team-final-step {
  display: flex;
  gap: 16px;
  align-items: center;
  margin-top: 28px;
  padding-block: 26px;
  border-block: 1px solid var(--line);
}
.team-final-step > svg {
  color: var(--blue);
  flex-shrink: 0;
}
.team-final-step > div {
  flex: 1;
  min-width: 0;
}
.team-final-step strong {
  font-size: 0.9rem;
}
.team-final-step p {
  font-size: 0.78rem;
  line-height: 1.6;
  color: var(--muted);
  margin: 8px 0 0;
}
.team-plan-submit {
  display: flex;
  justify-content: space-between;
  gap: 18px;
  align-items: end;
  margin-top: 24px;
}
.team-plan-submit select {
  width: 140px;
}
.team-run {
  border-top: 1px solid var(--line);
  padding-block: 24px 10px;
}
.team-run header {
  display: flex;
  align-items: center;
  gap: 14px;
}
.team-run header > div {
  flex: 1;
  min-width: 0;
}
.team-run h3 {
  margin: 8px 0;
  overflow-wrap: anywhere;
}
.team-run-cost {
  display: flex;
  gap: 12px 26px;
  flex-wrap: wrap;
  color: var(--muted);
  font-size: 0.8rem;
  margin-block: 18px;
}
.team-run-cost span {
  display: flex;
  gap: 8px;
}
.team-run ol,
.team-review ol {
  padding: 0;
  margin: 0;
  list-style: none;
}
.team-run li,
.team-review li {
  display: flex;
  align-items: center;
  gap: 12px;
  padding-block: 14px;
  border-top: 1px solid var(--line);
  min-width: 0;
}
.team-run li > svg {
  color: var(--blue);
  flex-shrink: 0;
}
.team-run li > div,
.team-review li > div {
  flex: 1;
  min-width: 0;
  overflow-wrap: anywhere;
}
.team-run li strong,
.team-review li strong {
  font-size: 0.86rem;
}
.team-run li small,
.team-review li small {
  display: block;
  font-size: 0.74rem;
  color: var(--muted);
  margin-top: 5px;
}
.team-run code {
  font-size: 0.72rem;
  overflow-wrap: anywhere;
}
.team-empty {
  text-align: center;
  padding: 70px 22px;
  border: 1px dashed var(--line);
  border-radius: 16px;
}
.team-empty > svg {
  color: var(--blue);
}
.team-empty p {
  color: var(--muted);
  line-height: 1.8;
  max-width: 500px;
  margin: 16px auto 24px;
}
.team-editor {
  display: grid;
  gap: 18px;
}
.team-editor label {
  display: grid;
  gap: 8px;
  font-size: 0.86rem;
}
.team-editor fieldset {
  border: 1px solid var(--line);
  border-radius: 10px;
  padding: 18px;
  min-width: 0;
  display: grid;
  gap: 14px;
}
.team-editor legend {
  padding-inline: 8px;
  font-size: 0.82rem;
}
.team-editor footer,
.team-review footer {
  display: flex;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 10px;
  padding-top: 18px;
}
.team-review p {
  font-size: 0.88rem;
  line-height: 1.8;
}
.team-review-total {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  padding: 20px;
  margin-block: 20px;
  background: var(--blue-soft);
  border-radius: 12px;
  color: var(--ink);
}
.team-review-total strong {
  font-size: 1.4rem;
}
.team-page :is(input, textarea, select, summary, button, a):focus-visible,
.team-editor :is(input, textarea, select):focus-visible {
  outline: 2px solid var(--blue);
  outline-offset: 3px;
}
@media (max-width: 760px) {
  .team-overview {
    grid-template-columns: 1fr;
  }
  .team-overview,
  .team-planner,
  .team-runs {
    padding: 20px;
  }
  .team-input-pair {
    grid-template-columns: 1fr;
    gap: 14px;
  }
  .team-section-title {
    flex-wrap: wrap;
  }
  .team-step {
    padding: 16px;
  }
  .team-final-step {
    flex-wrap: wrap;
  }
  .team-final-step .team-budget {
    margin-left: 36px;
  }
  .team-run header {
    flex-wrap: wrap;
  }
  .team-run li {
    flex-wrap: wrap;
  }
  .team-run li > div {
    flex-basis: 60%;
  }
  .team-step-footer,
  .team-plan-submit {
    flex-direction: column;
    align-items: stretch;
  }
  .team-step-footer .team-budget,
  .team-plan-submit select {
    width: 100%;
  }
  .team-review-total {
    align-items: center;
  }
}

@media (prefers-reduced-motion: reduce) {
  .team-page input,
  .team-page select,
  .team-page textarea,
  .team-editor input,
  .team-editor select,
  .team-editor textarea {
    transition: none;
  }
}
