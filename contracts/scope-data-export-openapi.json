          {
            "name": "tenant",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized preview JSON"
          },
          "400": {
            "description": "Invalid parameters or mismatched tenant header"
          },
          "401": {
            "description": "Current sign-in required"
          },
          "403": {
            "description": "Permission, scope deny or recent MFA required"
          },
          "404": {
            "description": "Unavailable or unauthorized scope (including archived customer project)"
          },
          "409": {
            "description": "Changed selection, archived admin scope or changing source"
          },
          "413": {
            "description": "Explicit complete export capacity exceeded; no truncation"
          },
          "429": {
            "description": "Export concurrency or rate capacity"
          },
          "503": {
            "description": "Temporary disk unavailable"
          }
        }
      }
    },
