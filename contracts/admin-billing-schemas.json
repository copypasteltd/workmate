        },
        "promotional_balance": {
          "$ref": "#/components/schemas/Money"
        },
        "reserved": {
          "$ref": "#/components/schemas/Money"
        },
        "credit_limit": {
          "$ref": "#/components/schemas/Money"
        },
        "debt": {
          "$ref": "#/components/schemas/Money"
        },
        "as_of": {
          "type": "string",
          "format": "date-time"
