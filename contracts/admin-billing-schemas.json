          "type": "string",
          "format": "uuid"
        },
        "subject": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "user",
                "tenant"
              ]
            },
            "id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "kind",
