{
  "name": "@copypaste/delivery",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck",
    "start": "node scripts/dev.mjs",
    "demo": "node scripts/dev.mjs --demo",
    "stop": "node scripts/stop.mjs",
    "bootstrap": "node scripts/bootstrap.mjs",
    "verify": "node scripts/verify.mjs",
    "release": "node scripts/release.mjs",
    "qa:web": "node --import tsx scripts/qa-web.ts",
    "qa:desktop": "node --import tsx scripts/qa-desktop.ts",
    "qa:extension": "node --import tsx scripts/qa-extension.ts",
    "qa:packaged": "node --import tsx scripts/qa-packaged.ts",
    "qa:persistent": "node --import tsx scripts/qa-persistent-work.ts",
    "qa:lifecycle": "node --import tsx scripts/qa-lifecycle.ts",
    "qa:admin-identities": "node --import tsx scripts/qa-admin-identities.ts",
    "qa:schedules": "node --import tsx scripts/qa-schedules.ts",
    "qa:federation": "node --import tsx scripts/qa-federation.ts",
    "qa:alignment": "node --import tsx scripts/qa-alignment.ts",
    "qa:desktop-transfer": "node --import tsx scripts/qa-desktop-transfer.ts",
    "qa:cloud-files": "node --import tsx scripts/qa-cloud-files.ts",
    "qa:skills": "node --import tsx scripts/qa-skills.ts"
  },
  "devDependencies": {
    "@types/chrome": "0.3.5",
    "@types/node": "26.6.5",
    "fflate": "0.8.2",
    "playwright": "1.64.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
