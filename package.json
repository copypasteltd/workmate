{
  "name": "@copypaste/platform",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-cloud-check-bootstrap.mjs",
    "typecheck": "tsc --noEmit",
    "build:cloud-program-host": "node scripts/build-cloud-program-host.mjs",
    "test": "node --env-file=.env scripts/run-tests-owned.mjs tests/*.test.ts",
    "dev": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "setup:local": "node --import tsx scripts/setup-local.ts",
    "db:local": "npm run build && node scripts/native-db-launch.mjs",
    "admin:create": "node --env-file=.env --import tsx scripts/admin-create.ts",
    "skills:build": "node --import tsx scripts/build-skills.ts",
    "db:migrate": "node --env-file=.env --import tsx scripts/migrate.ts",
    "contracts:export": "node --env-file=.env --import tsx scripts/export-routes.ts",
    "codex:probe": "node --env-file=.env --import tsx scripts/codex-probe.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@fastify/cookie": "11.1.3",
    "@fastify/cors": "11.3.1",
    "@fastify/multipart": "10.1.4",
    "@fastify/rate-limit": "11.2.1",
    "@js-temporal/polyfill": "0.5.1",
    "@napi-rs/canvas": "1.0.13",
    "@resvg/resvg-js": "2.6.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "csv-parse": "7.0.3",
    "embedded-postgres": "18.4.0-beta.17",
    "fast-xml-parser": "5.11.2",
    "fastify": "5.12.7",
    "fflate": "0.8.2",
    "ipaddr.js": "2.5.0",
    "nodemailer": "10.1.3",
    "openid-client": "6.8.8",
    "otpauth": "9.5.2",
    "parse5": "8.0.1",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "pngjs": "7.0.0",
    "pptxgenjs": "4.0.1",
    "robots-parser": "3.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/pngjs": "6.0.5",
    "prettier": "3.6.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
