    "qa:schedules": "node --import tsx scripts/qa-schedules.ts",
    "qa:federation": "node --import tsx scripts/qa-federation.ts",
    "qa:alignment": "node --import tsx scripts/qa-alignment.ts",
    "qa:desktop-transfer": "node --import tsx scripts/qa-desktop-transfer.ts",
    "qa:cloud-files": "node --import tsx scripts/qa-cloud-files.ts",
