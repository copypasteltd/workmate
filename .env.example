# Local development: run npm run setup:local. It creates unique credentials.
# This reference intentionally contains no working database passwords or keys.
NODE_ENV=development
HOST=127.0.0.1
PORT=4310
TRUSTED_PROXIES=127.0.0.1,::1
WEB_ORIGIN=http://localhost:4317
ADMIN_ORIGIN=http://localhost:4318
API_ORIGIN=http://localhost:4310
# Generated by setup:local; preserve and back up the real MASTER_KEY.
# MASTER_KEY=<64 random hexadecimal characters>
# DATABASE_URL=postgresql://cp_app:<unique-password>@127.0.0.1:55432/copypaste
# CONTROL_DATABASE_URL=postgresql://cp_control:<different-password>@127.0.0.1:55432/copypaste
# QUEUE_DATABASE_URL=postgresql://cp_queue:<different-password>@127.0.0.1:55432/copypaste
# OWNER_DATABASE_URL=postgresql://cp_owner:<migration-only-password>@127.0.0.1:55432/copypaste
DATA_DIR=.data
DEV_MAILBOX=true
# Production: DEV_MAILBOX=false and SMTP_URL required.
# SMTP_URL=smtps://<user>:<password>@<smtp-host>:465
MAIL_FROM="CopyPaste <hello@copypaste.hk>"
# OIDC: exact approved HTTPS origins for discovery, authorization, token and JWKS.
# SSO_ALLOWED_ORIGINS=https://<company-idp>,https://<company-idp-key-host>
SSO_ALLOW_LOCALHOST=false
# Default callback uses WEB_ORIGIN /v1/auth/sso/callback through its API proxy.
# Set API_ORIGIN here only when Web uses VITE_API_BASE pointing to that API.
# SSO_CALLBACK_ORIGIN=https://<public-api-origin>
CODEX_BIN=codex
CODEX_VERSION=0.163.0-alpha.10.2
AI_REASONING_EFFORT=max
# Company internal gateway only. Include /v1 if that is the gateway base path.
# AI_BASE_URL=https://<company-internal-gateway>/v1
# AI_ALLOWED_HOSTS=<company-internal-gateway>
# AI_API_KEY=<server-only-secret>
# AI_MODEL=<verified-company-text-model-alias>
# AI_IMAGE_MODEL=<verified-company-image2-alias>
AI_VERIFIED=false
AI_IMAGE_VERIFIED=false
# Optional company-video-jobs-v1 gateway. Public provider support is not assumed.
# AI_VIDEO_MODEL=<verified-company-video-model-alias>
AI_VIDEO_VERIFIED=false
# AI_VIDEO_HKD_MICROS_PER_SECOND=<positive-frozen-company-rate>
AI_VIDEO_POLL_INTERVAL_MS=5000
# AI_VIDEO_WEBHOOK_SECRET=<32-to-256-character-independent-company-callback-secret>
# Exact input counting must be verified through the same company gateway.
# An omitted fee is unavailable, never implicitly free. Platform pays task counts.
AI_INPUT_COUNT_VERIFIED=false
# AI_INPUT_COUNT_HKD_MICROS_PER_CALL=<explicit-contract-fee-or-verified-zero>
AI_VERIFICATION_PER_RUN_BUDGET_MICROS=1000000
AI_PLATFORM_VERIFICATION_DAILY_BUDGET_MICROS=100000000
AI_PLATFORM_COUNT_DAILY_BUDGET_MICROS=100000000
# Server request ceilings; separate from durable cross-worker provider limits.
# The output ceiling includes reasoning tokens and visible output.
AI_MAX_REQUEST_BYTES=16000000
# Independent company audio aliases and verified tariffs. Disabled until configured.
# AI_SPEECH_MODEL=company-speech-alias
AI_SPEECH_VERIFIED=false
AI_SPEECH_LOCALES=en
AI_SPEECH_VOICES=alloy
# AI_SPEECH_HKD_MICROS_PER_CHARACTER=<positive-hkd-micros-per-Unicode-scalar>
# AI_TRANSCRIPTION_MODEL=company-transcription-alias
AI_TRANSCRIPTION_VERIFIED=false
AI_TRANSCRIPTION_LOCALES=en
# Add zh-HK or yue-HK separately only after actual language/voice qualification.
AI_TRANSCRIPTION_TIMESTAMPS=false
# AI_TRANSCRIPTION_HKD_MICROS_PER_MILLISECOND=<positive-hkd-micros-per-input-ms>
# Admin must explicitly publish nonzero audio_slots/audio_rpm; defaults are zero.
# WAV/MP3 input: <=25 MB and <=10 minutes; AI_MAX_REQUEST_BYTES also bounds multipart.
AI_MAX_RESPONSE_BYTES=70000000
AI_MAX_OUTPUT_TOKENS=16384
AI_MAX_REQUESTS_PER_TURN=64
AI_REQUEST_TIMEOUT_MS=180000
AI_STREAM_IDLE_TIMEOUT_MS=60000
AI_SCOPE_TTL_MS=900000
# Set actual contract rates in HKD micros, not public-provider assumed prices.
# AI_INPUT_HKD_MICROS_PER_MILLION=...
# AI_OUTPUT_HKD_MICROS_PER_MILLION=...
# AI_IMAGE_HKD_MICROS_PER_IMAGE=...
WORKER_ENABLED=true
# Local handlers only; database policy still limits workspace/user/capability slots.
WORKER_CONCURRENCY=10
# Temporary synthetic dependencies, explicit labels, real Codex kernel. Local only.
# Model credentials and synthetic rates are generated in memory; no external AI call.
DEMO_MODE=false
EXTENSION_ID=fffkcnmfdhahlnifgdilabheppkgnlok
# Optional S3-compatible object storage; otherwise native local storage is used.
# S3_ENDPOINT=https://<object-storage-host>
S3_REGION=auto
# S3_BUCKET=...
# S3_ACCESS_KEY=...
# S3_SECRET_KEY=...
# Native renderer binaries can be overridden through process environment:
# FFMPEG_BIN=<absolute ffmpeg executable>
# FFPROBE_BIN=<absolute ffprobe executable>
# Connector process environment (server only):
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# GOOGLE_ADS_DEVELOPER_TOKEN=...
# META_APP_ID=...
# META_APP_SECRET=...

# GOOGLE_ADS_API_VERSION=v<qualified-version>
# META_GRAPH_VERSION=v<qualified-version>

# Optional company-managed marketing OAuth (leave unset in the synthetic demo).
# Register the exact API_ORIGIN + /v1/connections/callback in the provider app.
# GOOGLE_CLIENT_ID=company-google-client-id
# GOOGLE_CLIENT_SECRET=company-google-client-secret
# GOOGLE_ADS_DEVELOPER_TOKEN=company-approved-developer-token
# GOOGLE_ADS_API_VERSION=v26
# META_APP_ID=company-meta-app-id
# META_APP_SECRET=company-meta-app-secret
# META_GRAPH_VERSION=v26.0
# API versions above are explicit examples, not live-account qualification.
# DEMO_MODE creates an owned loopback supplier fixture automatically.
# CONNECTOR_FIXTURE_ORIGIN/KEY are private test transport settings; do not deploy them.

# Native recovery: keep the independent 32-byte backup key outside archived data.
# MASTER_KEY and OWNER_DATABASE_URL must be explicitly configured by the operator.
# RECOVERY_BACKUP_KEY=
# RECOVERY_PG_BIN_DIR=D:/approved-postgresql-18/bin
# Run npm run setup:recovery-tools for the pinned Windows development utilities.
# Use an absolute archive directory outside DATA_DIR. No VM or Docker is used.
